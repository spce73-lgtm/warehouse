  }

  if (canManage && editable && res.status !== CONFIG_EXT.ACTION_STATUS_CLOSED) {
    html += '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form" style="max-width:420px;margin-bottom:14px;">' +
      '<input type="hidden" name="action" value="updateResolutionStatus">' +
      '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' + backFields +
      '<select name="newStatus">' + CONFIG_EXT.ACTION_STATUSES.map(function (s) {
        return '<option value="' + escapeHtml(s) + '"' + (s === res.status ? ' selected' : '') + '>' + escapeHtml(s) + '</option>';
      }).join('') + '</select>' +
      '<label style="font-size:12px;color:#5a6472;">پیشرفت</label>' +
      progressSliderHtml('newProgress', res.progress || 0, 'res_' + res.id) +
      '<button type="submit">ثبت پیشرفت/وضعیت</button>' +
    '</form>';
  }

  var isCurrentAssignee = res.assignedUser === session.username;
  if ((isSystemAdmin(session) || isDeptManager(session) || isCurrentAssignee) && editable) {
    var isPrivileged = isSystemAdmin(session) || isDeptManager(session);
    var myDept = getSessionDepartment(session);
    var deptOpts = isDeptManager(session) ? (allDepts || listDepartments()).filter(function (d) { return d.name === myDept; }) : (allDepts || listDepartments());
    var userOpts = isPrivileged
      ? (isDeptManager(session) ? (allUsers || listUsersExtended()).filter(function (u) { return u.department === myDept; }) : (allUsers || listUsersExtended()))
      : (allUsers || listUsersExtended()).filter(function (u) { return u.department === myDept && u.username !== session.username; });
    html += '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form" style="max-width:420px;margin-bottom:14px;">' +
      '<input type="hidden" name="action" value="assignResolution">' +
      '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' + backFields +
      (isPrivileged
        ? ('<select name="newDepartment"><option value="">— بدون بخش —</option>' + deptOpts.map(function (d) {
