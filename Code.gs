    '&q=' + encodeURIComponent(filters.q || '') + '&number=' + encodeURIComponent(filters.number || '') +
    '&dueDate=' + encodeURIComponent(filters.dueDate || '') + '&status=' + encodeURIComponent(filters.status || '') +
    '&department=' + encodeURIComponent(filters.department || '') + '&assignedUser=' + encodeURIComponent(filters.assignedUser || '');
}
function renderResolutionDetailPage(session, id, message) {
