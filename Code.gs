  body += '<div class="dash-grid" style="margin-top:16px;">' +
    dashCard('اطلاعات مصوبه', null,
      '<div class="dash-dept-row"><span>تاریخ جلسه</span><span>' + escapeHtml(res.meetingDate || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>بخش</span><span>' + escapeHtml(res.department || '—') + '</span></div>' +
