  }

  // ---- فرم فیلتر ----
  var users = listUsers();
  var userOptions = '<option value="">همه کاربران</option>' + users.map(function (u) {
    return '<option value="' + escapeHtml(u.username) + '"' + (filters.username === u.username ? ' selected' : '') + '>' + escapeHtml(u.fullName || u.username) + '</option>';
  }).join('');
  body += '<div class="admin-title" style="margin-top:22px;" id="count-table-anchor">فهرست شمارش‌ها' +
    (filters.csign ? (' — <span style="font-weight:700;font-size:12px;color:' + (filters.csign === 'plus' ? '#1a7f37' : '#c53030') + ';">' +
      (filters.csign === 'plus' ? 'فقط اضافه‌ها' : 'فقط کسری‌ها') + '</span> <a target="_top" style="font-size:11px;" href="' +
      escapeHtml(countReportUrl(scriptUrl, session.__token, filters, { csign: '' })) + '">(حذف این فیلتر)</a>') : '') +
  '</div>';
  body +=
    '<form method="GET" action="' + escapeHtml(scriptUrl) + '" target="_top" class="filter-bar">' +
      '<input type="hidden" name="view" value="countReport">' +
      '<input type="hidden" name="token" value="' + escapeHtml(session.__token) + '">' +
      '<input type="hidden" name="csign" value="' + escapeHtml(filters.csign) + '">' +
      '<select name="cuser">' + userOptions + '</select>' +
      '<input type="text" name="cdate" value="' + escapeHtml(filters.dateQuery) + '" placeholder="تاریخ (مثلاً 1405/04)">' +
      '<input type="text" name="citem" value="' + escapeHtml(filters.itemQuery) + '" placeholder="' + escapeHtml(CONTEXT_SEARCH_PLACEHOLDER) + '" class="ctx-search-input">' +
      '<label style="display:flex;align-items:center;gap:5px;font-size:12.5px;font-weight:700;color:#5a6472;white-space:nowrap;">' +
        '<input type="checkbox" name="cmis" value="1" style="width:16px;height:16px;"' + (filters.onlyMismatch ? ' checked' : '') + '> فقط مغایرت‌دار' +
      '</label>' +
      '<button type="submit" class="mini-btn">فیلتر</button>' +
    '</form>';

  var exportQS = 'view=exportCounts&cuser=' + encodeURIComponent(filters.username) + '&cdate=' + encodeURIComponent(filters.dateQuery) +
    '&citem=' + encodeURIComponent(filters.itemQuery) + '&cmis=' + (filters.onlyMismatch ? '1' : '0') + '&csign=' + encodeURIComponent(filters.csign) + '&token=' + encodeURIComponent(session.__token);
  body += '<div style="margin:10px 0;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">' +
    '<a class="mini-btn" target="_top" href="' + escapeHtml(scriptUrl + '?' + exportQS) + '">دانلود گزارش CSV</a>';
  if (isAdmin && records.length) {
    body +=
      '<button type="button" class="mini-btn" onclick="ctSelectAll(true)">انتخاب همه</button>' +
      '<button type="button" class="mini-btn" onclick="ctSelectAll(false)">لغو انتخاب</button>' +
      '<button type="button" class="mini-btn danger" onclick="ctDeleteSelected()">حذف موارد انتخاب‌شده</button>';
  }
  body += '</div>';

  // ---- جدول ----
  if (records.length === 0) {
    body += '<div class="empty">با این فیلتر شمارشی پیدا نشد.</div>';
  } else {
    body += '<div class="count-table-wrap"><table class="count-table"><thead><tr>' +
      (isAdmin ? '<th style="width:30px;"><input type="checkbox" id="ctSelectAllHead" onclick="ctSelectAll(this.checked)"></th>' : '') +
      '<th>کالا</th><th>انبار</th><th>موجودی سیستم</th><th>شمارش</th><th>مغایرت</th><th>توضیح</th><th>شمارش‌کننده</th><th>زمان</th>' +
      '</tr></thead><tbody>';
    records.forEach(function (r) {
      var d = Number(r.diff);
      var diffCls = (!isNaN(d) && d > 0) ? 'ok' : ((!isNaN(d) && d < 0) ? 'bad' : '');
      var diffTxt = (r.diff === '' || r.diff == null) ? '—' : ((d > 0 ? '+' : '') + r.diff);
      body += '<tr' + (diffCls ? (' class="row-' + diffCls + '"') : '') + '>' +
        (isAdmin ? '<td><input type="checkbox" class="ct-check" value="' + r.rowIndex + '"></td>' : '') +
        '<td><div class="ct-item-name">' + escapeHtml(r.itemName || '(بدون نام)') + '</div><div class="ct-item-code">' + escapeHtml(r.itemCode) + '</div></td>' +
        '<td>' + escapeHtml(r.warehouse || '—') + '</td>' +
        '<td>' + escapeHtml(r.systemQty) + '</td>' +
        '<td>' + escapeHtml(r.physicalQty) + '</td>' +
        '<td><span class="diff-badge ' + diffCls + '">' + escapeHtml(diffTxt) + '</span></td>' +
        '<td class="ct-note">' + escapeHtml(r.note || '—') + '</td>' +
        '<td>' + escapeHtml(r.username) + '</td>' +
        '<td class="ktbl-date">' + escapeHtml(r.date) + '</td>' +
      '</tr>';
    });
    body += '</tbody></table></div>';
  }

  if (isAdmin && records.length) {
    body +=
      '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" id="ctDeleteForm" style="display:none;">' +
        '<input type="hidden" name="action" value="deleteCountRecords">' +
        '<input type="hidden" name="token" value="' + escapeHtml(session.__token) + '">' +
        '<input type="hidden" name="cuser" value="' + escapeHtml(filters.username) + '">' +
        '<input type="hidden" name="cdate" value="' + escapeHtml(filters.dateQuery) + '">' +
        '<input type="hidden" name="citem" value="' + escapeHtml(filters.itemQuery) + '">' +
        '<input type="hidden" name="cmis" value="' + (filters.onlyMismatch ? '1' : '0') + '">' +
        '<input type="hidden" name="rowIndexes" id="ctRowIndexes">' +
      '</form>' +
      '<script>' +
        'function ctSelectAll(v){' +
          'document.querySelectorAll(".ct-check").forEach(function(c){c.checked=v;});' +
          'var h=document.getElementById("ctSelectAllHead");if(h)h.checked=v;' +
        '}' +
        'function ctDeleteSelected(){' +
          'var ids=Array.prototype.slice.call(document.querySelectorAll(".ct-check:checked")).map(function(c){return c.value;});' +
          'if(!ids.length){alert("هیچ ردیفی انتخاب نشده است.");return;}' +
          'if(!confirm(ids.length+" رکورد شمارش برای همیشه حذف شود؟ این عمل قابل بازگشت نیست."))return;' +
          'document.getElementById("ctRowIndexes").value=ids.join(",");' +
          'document.getElementById("ctDeleteForm").submit();' +
        '}' +
      '</script>';
  }

  return HtmlService.createHtmlOutput(wrapPage(body, '', session, { activeView: 'countReport' }))
    .setTitle('انبارگردانی').addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function exportCountsCSV(filters) {
  var records = listCountRecords(filters);
  var rows = [['کد کالا', 'نام کالا', 'انبار', 'موجودی سیستم', 'شمارش', 'مغایرت', 'توضیح', 'شمارش‌کننده', 'زمان']];
  records.forEach(function (r) {
    rows.push([r.itemCode, r.itemName, r.warehouse || '', r.systemQty, r.physicalQty, r.diff, r.note, r.username, r.date]);
  });
  var csv = rows.map(function (row) {
    return row.map(function (cell) {
      var s = String(cell == null ? '' : cell).replace(/"/g, '""');
      return '"' + s + '"';
    }).join(',');
  }).join('\r\n');
  return ContentService.createTextOutput('\uFEFF' + csv).setMimeType(ContentService.MimeType.CSV);
}

function exportRemainingItemsCSV() {
  var coverage = getCountCoverage();
  var rows = [['کد کالا', 'نام کالا']];
  coverage.remaining.forEach(function (it) { rows.push([it.code, it.name]); });
  var csv = rows.map(function (row) {
    return row.map(function (cell) {
      var s = String(cell == null ? '' : cell).replace(/"/g, '""');
      return '"' + s + '"';
    }).join(',');
  }).join('\r\n');
  return ContentService.createTextOutput('\uFEFF' + csv).setMimeType(ContentService.MimeType.CSV);
}

