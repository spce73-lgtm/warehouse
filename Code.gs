        '<button type="submit">ارجاع مجدد</button>' +
      '</form>';
    }
  }
  body += commentsAndTimelineWidgetHtml(scriptUrl, session, 'action', a.id, '', canComment);
  return HtmlService.createHtmlOutput(wrapPage(body, '', session, { activeView: 'actions' })).setTitle('جزئیات اقدام').addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

// ----------------------------------------------------------------------
// SECTION 8: ماژول صورتجلسات — نسخه‌ی ۳
// جدول حرفه‌ای جلسات + مصوبات هر جلسه به‌صورت پنل درون‌خطیِ قابل‌گسترش
// (بدون صفحه‌ی جدید — «مصوبات جلسات» به‌عنوان منوی جدا حذف شده است)
// ----------------------------------------------------------------------
function meetingAggregate_(resolutions) {
  var total = resolutions.length;
  var closed = resolutions.filter(function (r) { return r.status === CONFIG_EXT.ACTION_STATUS_CLOSED; }).length;
  var sumProgress = resolutions.reduce(function (s, r) { return s + (parseInt(r.progress || 0, 10) || 0); }, 0);
  var avgProgress = total > 0 ? Math.round(sumProgress / total) : 0;
  var statusLabel = total === 0 ? 'بدون مصوبه' : (closed === total ? 'بسته' : 'باز');
  var anyOverdue = resolutions.some(function (r) { return isOverdue_(r.dueDate, r.status); });
  return { total: total, closed: closed, avgProgress: avgProgress, statusLabel: statusLabel, anyOverdue: anyOverdue };
}

// پنل درون‌خطی هر مصوبه: پیشرفت/وضعیت/تکمیل/تأیید/عودت/ارجاع مجدد/نظرات/جدول‌زمانی — همه بدون خروج از صفحه
