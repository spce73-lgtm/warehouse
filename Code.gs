    var creatorFullName = res.createdBy ? (userNameMap[res.createdBy] || res.createdBy) : '—';
    // «+» فقط برای مصوبه‌ی مسئولِ خودِ کاربر باز می‌شود؛ به‌علاوه‌ی مدیر سیستم و ایجادکننده (برای
    // مرور/تأیید طبق گردش‌کار تکمیل). سایر مصوبات فقط‌خواندنی هستند و اصلاً پنل/دکمه‌ای ندارند — نیازمندی ۲.
    var canExpand = isSystemAdmin(session) || res.assignedUser === session.username || res.createdBy === session.username;
