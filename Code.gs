        escapeHtml(m.subject || 'بدون موضوع'),
        escapeHtml(m.date || '—') + (agg.anyOverdue ? ' <span class="overdue-tag">⚠</span>' : ''),
        escapeHtml(creatorFullName),
        String(agg.total) + (agg.total ? ' (' + agg.closed + ' بسته)' : ''),
        progressCellHtml_(agg.avgProgress),
        '<span class="status-badge ' + (agg.statusLabel === 'بسته' ? 'badge-done' : (agg.statusLabel === 'باز' ? 'badge-progress' : 'badge-pending')) + '">' + escapeHtml(agg.statusLabel) + '</span>',
        pubStatusBadgeHtml_(m.publicationStatus)
      ]
    };
