function buildTabUrl(scriptUrl, token, view, itemId, q) {
  var t = encodeURIComponent(token || '');
  if (view === 'item' && itemId) return scriptUrl + '?view=item&itemId=' + encodeURIComponent(itemId) + '&token=' + t;
  if (view === 'itemdetail' && itemId) return scriptUrl + '?id=' + encodeURIComponent(itemId) + '&token=' + t;
  if (!view || view === 'search') return scriptUrl + '?token=' + t + (q ? ('&q=' + encodeURIComponent(q)) : '');
  return scriptUrl + '?view=' + encodeURIComponent(view) + '&token=' + t;
}

