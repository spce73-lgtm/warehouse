// جدول مصوباتِ درون یک جلسه (ستون‌های خواسته‌شده + شرح مصوبه)
function resolutionsTableForMeetingHtml_(scriptUrl, session, meeting, resolutions, token, expandResolutionId, userNameMap, allDepts, allUsers) {
