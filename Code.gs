  for (var r = 1; r < values.length; r++) {
    if (values[r][0]) out.push(String(values[r][0]));
  }
  return out;
}

function addCategory(name) {
  name = String(name || '').trim();
  if (!name) throw new Error('نام دسته خالی است.');
  if (listCategories().indexOf(name) !== -1) throw new Error('این دسته قبلاً وجود دارد.');
  getCategoriesSheet().appendRow([name]);
}

function deleteCategory(name) {
  var sh = getCategoriesSheet();
  var values = sh.getDataRange().getValues();
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]) === String(name)) { sh.deleteRow(r + 1); return; }
  }
}

