        'document.getElementById("cwItemCode").textContent=res.code;' +
        'document.getElementById("cwSysQty").textContent=(res.systemQty===""||res.systemQty==null)?"—":res.systemQty;' +
        'var whWrap=document.getElementById("cwWarehouseWrap");var whSel=document.getElementById("cwWarehouseSelect");' +
        'var warehouses=res.warehouses||[];' +
        'if(warehouses.length>1){' +
          'whSel.innerHTML="<option value=\\"\\">— انتخاب کنید —</option>"+warehouses.map(function(w){return "<option value=\\""+w.warehouse.replace(/\"/g,"&quot;")+"\\">"+w.warehouse+" (موجودی: "+w.qty+")</option>";}).join("");' +
          'whWrap.style.display="block";' +
        '} else {' +
          'whSel.innerHTML="";whWrap.style.display="none";' +
        '}' +
        'var q=document.getElementById("cwQtyInput");q.value="";document.getElementById("cwNoteInput").value="";' +
        'setTimeout(function(){q.focus();},150);' +
      '}).withFailureHandler(function(err){' +
        'document.getElementById("cwLoading").style.display="none";' +
        'document.getElementById("cwError").style.display="block";' +
        'document.getElementById("cwErrorMsg").textContent=err&&err.message?err.message:String(err);' +
      '}).lookupItemForScan(' + tok + ',code);' +
    '}' +
    'function cwClose(){document.getElementById("cwOverlay").classList.remove("open");cwCurCode=null;}' +
    'function cwStepQty(delta){var el=document.getElementById("cwQtyInput");var v=Number(el.value)||0;v=Math.max(0,v+delta);el.value=v;}' +
    'function cwSubmit(){' +
      'var qty=document.getElementById("cwQtyInput").value;' +
      'var note=document.getElementById("cwNoteInput").value.trim();' +
      'if(qty===""||isNaN(Number(qty))){alert("لطفاً تعداد را وارد کنید.");return;}' +
      'var whSel=document.getElementById("cwWarehouseSelect");' +
      'var warehouse=(whSel&&whSel.offsetParent!==null)?whSel.value:"";' +
      'if(whSel&&whSel.offsetParent!==null&&!warehouse){alert("لطفاً ابتدا انبار را انتخاب کنید.");return;}' +
      'var btn=document.getElementById("cwSubmitBtn");btn.disabled=true;btn.textContent="در حال ثبت...";' +
      'var itemName=document.getElementById("cwItemName").textContent;' +
      'var code=cwCurCode;' +
      'google.script.run.withSuccessHandler(function(res){' +
        'btn.disabled=false;btn.textContent="ثبت و بعدی";' +
        'if(!res.success){alert(res.message||"خطا در ثبت.");return;}' +
        'cwAddRecent(itemName,qty,res.diff);' +
        'if(navigator.vibrate)try{navigator.vibrate(80);}catch(e){}' +
        'document.getElementById("cwCode").value="";' +
        'cwClose();' +
      '}).withFailureHandler(function(err){' +
        'btn.disabled=false;btn.textContent="ثبت و بعدی";' +
        'alert(err&&err.message?err.message:String(err));' +
      '}).recordCount(' + tok + ',code,qty,note,warehouse);' +
    '}' +
    'function cwAddRecent(name,qty,diff){' +
      'cwRecent.unshift({name:name,qty:qty,diff:diff});if(cwRecent.length>8)cwRecent.pop();' +
      'var box=document.getElementById("cwRecentList");' +
      'if(!cwRecent.length){box.innerHTML="<div class=\\"cw-recent-empty\\">هنوز چیزی ثبت نشده.</div>";return;}' +
      'box.innerHTML=cwRecent.map(function(r){' +
        'var d=Number(r.diff);var cls=(!isNaN(d)&&d>0)?"plus":((!isNaN(d)&&d<0)?"minus":"");' +
        'var diffTxt=(r.diff===""||r.diff==null)?"":(d>0?("+"+r.diff):r.diff);' +
        'var esc=function(s){var d=document.createElement("div");d.textContent=s;return d.innerHTML;};' +
        'return "<div class=\\"cw-recent-item\\"><span><b>"+esc(r.name)+"</b> · "+esc(r.qty)+" عدد</span>"+(diffTxt?("<span class=\\"cw-diff "+cls+"\\">"+esc(diffTxt)+"</span>"):"")+"</div>";' +
      '}).join("");' +
    '}'
  );
}

// ============ برچسب‌های QR (تولید انبوه برای چاپ) ============
function getAllItemsForLabels() {
  var values = getSheetValues();
  var headers = values[0].map(function (h) { return String(h).trim(); });
  function findCol(keyword) { for (var i = 0; i < headers.length; i++) if (headers[i].indexOf(keyword) !== -1) return i; return -1; }
  var idCol = findCol('کد');
  var nameCol = findCol('نام کالا'); if (nameCol === -1) nameCol = findCol('نام');
  var catCol = findCol('دسته');
  var out = [];
  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    var code = idCol !== -1 ? String(row[idCol]).trim() : '';
    if (!code) continue;
    out.push({ code: code, name: nameCol !== -1 ? String(row[nameCol] || '') : '', category: catCol !== -1 ? String(row[catCol] || '') : '' });
  }
  return out;
}

function renderQrLabelsPage(session) {
  var scriptUrl = ScriptApp.getService().getUrl();
  var items = getAllItemsForLabels();

