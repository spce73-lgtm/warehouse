// ============ شمارنده‌های نوار کناری (خوانده‌نشده/باز) ============
function getBadgeCounts(session) {
  var counts = { inbox: 0, mytasks: 0, taskadmin: 0 };
  if (!session) return counts;
  var values = getInboxValues();
  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    var type = row[1], recipient = String(row[3]).trim(), status = row[6];
    if (recipient === session.username) {
      if ((type === 'پیام' && status === 'خوانده‌نشده') || (type === TASK_TYPE && status === 'در انتظار اقدام')) {
        counts.inbox++;
      }
    }
    if (session.role === 'مدیر' && type === TASK_TYPE && status !== 'بسته‌شده') {
      counts.taskadmin++;
    }
  }
  listPersonalTasks(session.username).forEach(function (t) {
    if (t.status !== 'بسته') counts.mytasks++;
  });
  return counts;
}

function closePersonalTask(id, username) {
  var sh = getPersonalTasksSheet();
  var values = sh.getDataRange().getValues();
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]) === String(id) && String(values[r][1]).trim() === username) {
      sh.getRange(r + 1, 4).setValue('بسته');
      sh.getRange(r + 1, 6).setValue(nowJalaliString());
      return;
    }
  }
}

// ============ یادآوری‌ها ============
// itemKeys آرایه‌ای از رشته‌های «نوع:شناسه» است، نوع یکی از «inbox» یا «personal»
function setReminders(session, itemKeys, jalaliDateStr) {
  jalaliDateStr = String(jalaliDateStr || '').trim();
  if (!/^\d{4}\/\d{2}\/\d{2}$/.test(jalaliDateStr)) throw new Error('تاریخ یادآوری نامعتبر است.');
  if (!itemKeys || !itemKeys.length) throw new Error('موردی برای یادآوری انتخاب نشده.');
  var sh = getRemindersSheet();
  var now = nowJalaliString();
  var saved = 0;
  itemKeys.forEach(function (key) {
    var parts = String(key).split(':');
    var kind = parts[0], id = parts[1];
    if (kind !== 'inbox' && kind !== 'personal') return;
    var owns = false;
    if (kind === 'inbox') {
      var found = getInboxItemById(id);
      if (found && (found.obj.recipient === session.username || found.obj.sender === session.username)) owns = true;
    } else {
      owns = listPersonalTasks(session.username).some(function (t) { return String(t.id) === String(id); });
    }
    if (!owns) return;
    // یادآوری قبلیِ همین کاربر روی همین مورد را حذف می‌کنیم تا فقط آخرین تاریخ باقی بماند
    var values = sh.getDataRange().getValues();
    for (var r = values.length - 1; r >= 1; r--) {
      if (values[r][1] === session.username && String(values[r][2]) === String(id)) sh.deleteRow(r + 1);
    }
    sh.appendRow([Utilities.getUuid(), session.username, id, kind, jalaliDateStr, now]);
    saved++;
  });
  return saved;
}

function getReminderMap(username) {
  var values = getRemindersSheet().getDataRange().getValues();
  var map = {};
  for (var r = 1; r < values.length; r++) {
    if (values[r][1] === username) map[String(values[r][2])] = formatCellDateOnly(values[r][4]);
  }
  return map;
}

// فهرست کامل یادآوری‌های کاربر برای نمایش در پنل «لیست یادآوری‌ها»
function getMyReminders(session) {
  var values = getRemindersSheet().getDataRange().getValues();
  var todayStr = nowJalaliString().split(' ')[0]; // مثل «۱۴۰۵/۰۴/۱۹»
  var personalTasks = null;
  var list = [];
  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    if (row[1] !== session.username) continue;
    var kind = row[3], itemId = String(row[2]);
    var dateOnly = formatCellDateOnly(row[4]);
    var subject = '(حذف‌شده)';
    var href = '';
    if (kind === 'inbox') {
      var found = getInboxItemById(itemId);
      if (found) { subject = found.obj.subject || '(بدون موضوع)'; href = 'view=item&itemId=' + encodeURIComponent(itemId); }
    } else {
      if (!personalTasks) personalTasks = listPersonalTasks(session.username);
      for (var i = 0; i < personalTasks.length; i++) {
        if (String(personalTasks[i].id) === itemId) { subject = personalTasks[i].text; href = 'view=mytasks'; break; }
      }
    }
    list.push({ rowId: row[0], subject: subject, date: dateOnly, due: dateOnly <= todayStr, href: href });
  }
  list.sort(function (a, b) { return a.date < b.date ? -1 : (a.date > b.date ? 1 : 0); });
  var dueCount = 0;
  list.forEach(function (x) { if (x.due) dueCount++; });
  return { list: list, dueCount: dueCount };
}

function clearReminder(session, rowId) {
  var sh = getRemindersSheet();
  var values = sh.getDataRange().getValues();
  for (var r = values.length - 1; r >= 1; r--) {
    if (String(values[r][0]) === String(rowId) && values[r][1] === session.username) { sh.deleteRow(r + 1); return; }
  }
}

// ============ تقویم شمسی سمت سرور (برای پاپ‌آپ انتخاب تاریخ یادآوری) ============
function jalaliMonthGrid(jy, jm) {
  var guessGy = jy + 621;
  var d = new Date(guessGy, 2, 1);
  d.setDate(d.getDate() - 40);
  var found = null;
  for (var i = 0; i < 420; i++) {
    var j = toJalali(d);
    if (j[0] === jy && j[1] === jm && j[2] === 1) { found = new Date(d); break; }
    d.setDate(d.getDate() + 1);
  }
  if (!found) return { days: [], jy: jy, jm: jm };
  var days = [];
  var cur = new Date(found);
  while (true) {
    var jj = toJalali(cur);
    if (jj[0] !== jy || jj[1] !== jm) break;
    var jsDay = cur.getDay(); // 0=یکشنبه..6=شنبه (استاندارد جاوااسکریپت)
    var iranWeekday = (jsDay + 1) % 7; // 0=شنبه..6=جمعه
    days.push({ jd: jj[2], w: iranWeekday });
    cur.setDate(cur.getDate() + 1);
  }
  return { days: days, jy: jy, jm: jm };
}

function getJalaliMonthGrid(token, jy, jm) {
  var session = getSession(token);
  if (!session) throw new Error('نشست معتبر نیست.');
  jy = parseInt(jy, 10); jm = parseInt(jm, 10);
  if (jm < 1) { jm = 12; jy -= 1; }
  if (jm > 12) { jm = 1; jy += 1; }
  return jalaliMonthGrid(jy, jm);
}

// ============ صفحات کارتابل ============
function statusBadgeClass(status) {
  if (status === 'بسته' || status === 'بسته‌شده' || status === 'خوانده‌شده') return 'badge-done';
  if (status === 'در حال انجام') return 'badge-progress';
  return 'badge-pending';
}

function readFilters(e) {
  return { kq: e.parameter.kq || '', category: e.parameter.category || '', recipient: e.parameter.recipient || '' };
}

// رشته‌ی کوئری فهرست فیلترشده‌ی فعلی؛ برای بازگشت از صفحه‌ی جزئیات به همان فهرست استفاده می‌شود
function buildFilterQS(view, filters) {
  filters = filters || {};
  return 'view=' + encodeURIComponent(view) +
    '&kq=' + encodeURIComponent(filters.kq || '') +
    '&category=' + encodeURIComponent(filters.category || '') +
    '&recipient=' + encodeURIComponent(filters.recipient || '');
}

function filterBarHtml(scriptUrl, session, view, filters, showRecipient) {
  var users = showRecipient ? listUsers() : [];
  var cats = listCategories();
  var html =
    '<form method="GET" action="' + escapeHtml(scriptUrl) + '" target="_top" class="filter-bar-docked">' +
      '<input type="hidden" name="view" value="' + escapeHtml(view) + '">' +
      '<input type="hidden" name="token" value="' + escapeHtml(session.__token) + '">' +
      '<input type="text" name="kq" value="' + escapeHtml(filters.kq) + '" placeholder="' + escapeHtml(CONTEXT_SEARCH_PLACEHOLDER) + '" class="ctx-search-input">' +
      '<select name="category"><option value="">همه دسته‌ها</option>' +
      cats.map(function (c) { return '<option value="' + escapeHtml(c) + '"' + (filters.category === c ? ' selected' : '') + '>' + escapeHtml(c) + '</option>'; }).join('') +
      '</select>';
  if (showRecipient) {
    html += '<select name="recipient"><option value="">همه افراد</option>' +
      users.map(function (u) { return '<option value="' + escapeHtml(u.username) + '"' + (filters.recipient === u.username ? ' selected' : '') + '>' + escapeHtml(u.fullName || u.username) + '</option>'; }).join('') +
      '</select>';
  }
  html += '<button type="submit" class="mini-btn">فیلتر</button></form>';
  return html;
}

// ======================================================================
// ماژول: داشبورد (Dashboard) — کاملاً جدید و افزودنی.
// فقط از توابع موجود (بدون تغییر) برای خواندن داده استفاده می‌کند:
// listPersonalTasks, listInbox, listSent, getMyReminders, getInboxValues,
// listUsersExtended, listDepartments.
// «اقدامات» و «مصوبات جلسات» چون هنوز ساخته نشده‌اند، به‌صورت شفاف
// به‌عنوان «به‌زودی» نمایش داده می‌شوند تا داده‌ی ساختگی نمایش داده نشود.
// ======================================================================
function dashCard(title, count, innerHtml, moreHref, moreLabel) {
  return (
    '<div class="dash-card">' +
      '<div class="dash-card-head"><span class="dash-card-title">' + escapeHtml(title) + '</span>' +
      (count !== null && count !== undefined ? '<span class="dash-card-count">' + count + '</span>' : '') + '</div>' +
      '<div class="dash-card-body">' + innerHtml + '</div>' +
      (moreHref ? '<a class="dash-more" target="_top" href="' + escapeHtml(moreHref) + '">' + escapeHtml(moreLabel || 'مشاهده همه') + '</a>' : '') +
    '</div>'
  );
}

function dashSoonCard(title, note) {
  return (
    '<div class="dash-card dash-card-soon">' +
      '<div class="dash-card-head"><span class="dash-card-title">' + escapeHtml(title) + '</span><span class="dash-soon-badge">به‌زودی</span></div>' +
      '<div class="dash-empty">' + escapeHtml(note || 'این ماژول هنوز راه‌اندازی نشده است.') + '</div>' +
    '</div>'
  );
}

function renderDashboardPage(session, message) {
  var scriptUrl = ScriptApp.getService().getUrl();
  var token = encodeURIComponent(session.__token || '');

  // ---------- کارهای من ----------
  var myTasksAll = listPersonalTasks(session.username);
  var myTasksOpen = myTasksAll.filter(function (t) { return t.status !== 'بسته'; });
  var myTasksHtml = myTasksOpen.length
    ? myTasksOpen.slice(0, 5).map(function (t) {
        return '<div class="dash-item">' + escapeHtml(t.text) + '<span class="dash-item-date">' + escapeHtml(t.createdAt || '') + '</span></div>';
      }).join('')
    : '<div class="dash-empty">کاری برای انجام ندارید.</div>';
  var cardMyTasks = dashCard('کارهای من', myTasksOpen.length, myTasksHtml, scriptUrl + '?view=mytasks&token=' + token);

  // ---------- نامه‌های در انتظار من (پراکسیِ «نامه‌های مهم» تا ساخته‌شدن ماژول اختصاصی) ----------
  var myLetters = listInbox(session.username, {}).filter(function (it) {
    return it.type !== TASK_TYPE && it.status !== 'بسته' && it.status !== 'بسته‌شده' && it.status !== 'خوانده‌شده';
  });
  var lettersHtml = myLetters.length
    ? myLetters.slice(0, 5).map(function (it) {
        return '<div class="dash-item">' + escapeHtml(it.subject || '(بدون موضوع)') + '<span class="dash-item-date">' + escapeHtml(it.sender) + '</span></div>';
      }).join('')
    : '<div class="dash-empty">نامه‌ی در انتظاری ندارید.</div>';
  var cardLetters = dashCard('نامه‌های مهم (در انتظار من)', myLetters.length, lettersHtml, scriptUrl + '?view=inbox&token=' + token);

  // ---------- اعلان‌ها ----------
  var reminders = getMyReminders(session);
  var remHtml = reminders.list.length
    ? reminders.list.slice(0, 5).map(function (r) {
        return '<div class="dash-item' + (r.due ? ' dash-item-due' : '') + '">' + escapeHtml(r.subject) + '<span class="dash-item-date">' + escapeHtml(r.date) + '</span></div>';
      }).join('')
    : '<div class="dash-empty">اعلانی ثبت نشده است.</div>';
  var cardNotif = dashCard('اعلان‌ها', reminders.dueCount, remHtml, null);

  // ---------- آخرین فعالیت‌ها ----------
  var activity = [];
  if (isSystemAdmin(session)) {
    var allRows = getInboxValues();
    for (var r = 1; r < allRows.length; r++) {
      var row = allRows[r];
      activity.push({ subject: row[4] || '(بدون موضوع)', who: row[2] + ' ← ' + row[3], date: formatCellDate(row[7]) });
    }
    activity.sort(function (a, b) { return (a.date < b.date) ? 1 : -1; });
    activity = activity.slice(0, 6);
  } else {
    var ownMix = listInbox(session.username, {}).map(function (it) { return { subject: it.subject || '(بدون موضوع)', who: 'از ' + it.sender, date: it.createdAt }; })
      .concat(listSent(session.username, {}).map(function (it) { return { subject: it.subject || '(بدون موضوع)', who: 'به ' + it.recipient, date: it.createdAt }; }))
      .concat(myTasksAll.map(function (t) { return { subject: t.text, who: 'وظیفه‌ی شخصی', date: t.createdAt }; }));
    ownMix.sort(function (a, b) { return (a.date < b.date) ? 1 : -1; });
    activity = ownMix.slice(0, 6);
  }
  var activityHtml = activity.length
    ? activity.map(function (a) {
        return '<div class="dash-item">' + escapeHtml(a.subject) + '<span class="dash-item-date">' + escapeHtml(a.who) + ' · ' + escapeHtml(a.date || '') + '</span></div>';
      }).join('')
    : '<div class="dash-empty">فعالیتی ثبت نشده است.</div>';
  var cardActivity = dashCard('آخرین فعالیت‌ها', null, activityHtml, null);

  // ---------- آمار بخش (فقط مدیران) ----------
  var deptCard = '';
  if (isSystemAdmin(session) || isDeptManager(session)) {
    var allUsers = listUsersExtended();
    var depts = listDepartments();
    var scopeDepts = isSystemAdmin(session) ? depts : depts.filter(function (d) { return d.name === getSessionDepartment(session); });
    var rowsHtml = scopeDepts.map(function (d) {
      var deptUsers = allUsers.filter(function (u) { return u.department === d.name; });
      var openCount = 0;
      deptUsers.forEach(function (u) {
        openCount += listPersonalTasks(u.username).filter(function (t) { return t.status !== 'بسته'; }).length;
      });
      return '<div class="dash-dept-row"><span>' + escapeHtml(d.name) + '</span><span>' + deptUsers.length + ' نفر · ' + openCount + ' کار باز</span></div>';
    }).join('');
    if (!rowsHtml) rowsHtml = '<div class="dash-empty">بخشی تعریف نشده است.</div>';
    deptCard = dashCard('آمار بخش' + (isSystemAdmin(session) ? '‌ها' : ''), scopeDepts.length || null, rowsHtml, isSystemAdmin(session) ? (scriptUrl + '?view=userManagement&token=' + token) : null, 'مدیریت کاربران');
  }

  var body =
    (message ? '<div class="login-msg ok-msg">' + escapeHtml(message) + '</div>' : '') +
    '<div class="dash-grid">' +
      cardMyTasks +
      dashSoonCard('اقدامات من', 'ماژول اقدامات به‌زودی در دسترس قرار می‌گیرد.') +
      dashSoonCard('مصوبات جلسات معلق', 'ماژول جلسات و مصوبات به‌زودی در دسترس قرار می‌گیرد.') +
      cardLetters +
      cardNotif +
      cardActivity +
      deptCard +
    '</div>';

  return HtmlService.createHtmlOutput(wrapPage(body, '', session, { activeView: 'dashboard' }))
    .setTitle('داشبورد')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

// ======================================================================
// زیرساخت مشترک: پیوست‌ها / نظرات / لاگ فعالیت
// با پارامتر (moduleType, itemId) در هر ماژول جدید (اقدامات، صورتجلسات، مصوبات)
// دوباره استفاده می‌شود؛ هیچ ماژول قدیمی به این‌ها وابسته نیست.
// ======================================================================
function getAttachmentsSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(CONFIG_EXT.ATTACHMENTS_SHEET_NAME);
  if (!sh) { sh = ss.insertSheet(CONFIG_EXT.ATTACHMENTS_SHEET_NAME); sh.appendRow(['شناسه', 'نوع ماژول', 'شناسه آیتم', 'نام فایل', 'لینک', 'کاربر', 'تاریخ']); }
  return sh;
}
function addAttachment(moduleType, itemId, fileName, link, username) {
  fileName = String(fileName || '').trim();
  link = String(link || '').trim();
  if (!fileName || !link) throw new Error('نام فایل و لینک الزامی است.');
  getAttachmentsSheet().appendRow([Utilities.getUuid(), moduleType, String(itemId), fileName, link, username, nowJalaliString()]);
  logActivity(moduleType, itemId, 'پیوست', username, 'پیوست «' + fileName + '» افزوده شد.');
}
function listAttachments(moduleType, itemId) {
  var values = getAttachmentsSheet().getDataRange().getValues();
  var out = [];
  for (var r = 1; r < values.length; r++) {
    if (values[r][1] === moduleType && String(values[r][2]) === String(itemId)) {
      out.push({ id: values[r][0], fileName: values[r][3], link: values[r][4], username: values[r][5], date: values[r][6] });
    }
  }
  return out;
}

function getCommentsSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(CONFIG_EXT.COMMENTS_SHEET_NAME);
  if (!sh) { sh = ss.insertSheet(CONFIG_EXT.COMMENTS_SHEET_NAME); sh.appendRow(['شناسه', 'نوع ماژول', 'شناسه آیتم', 'کاربر', 'متن', 'تاریخ']); }
  return sh;
}
function addComment(moduleType, itemId, username, text) {
  text = String(text || '').trim();
  if (!text) throw new Error('متن نظر خالی است.');
  getCommentsSheet().appendRow([Utilities.getUuid(), moduleType, String(itemId), username, text, nowJalaliString()]);
  logActivity(moduleType, itemId, 'نظر', username, text.substring(0, 80));
}
function listComments(moduleType, itemId) {
  var values = getCommentsSheet().getDataRange().getValues();
  var out = [];
  for (var r = 1; r < values.length; r++) {
    if (values[r][1] === moduleType && String(values[r][2]) === String(itemId)) {
      out.push({ id: values[r][0], username: values[r][3], text: values[r][4], date: formatCellDate(values[r][5]) });
    }
  }
  return out;
}

function getActivityLogSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(CONFIG_EXT.ACTIVITY_LOG_SHEET_NAME);
  if (!sh) { sh = ss.insertSheet(CONFIG_EXT.ACTIVITY_LOG_SHEET_NAME); sh.appendRow(['شناسه', 'نوع ماژول', 'شناسه آیتم', 'رویداد', 'کاربر', 'جزئیات', 'تاریخ']); }
  return sh;
}
function logActivity(moduleType, itemId, eventType, username, details) {
  getActivityLogSheet().appendRow([Utilities.getUuid(), moduleType, String(itemId), eventType, username, details || '', nowJalaliString()]);
}
function listActivity(moduleType, itemId) {
  var values = getActivityLogSheet().getDataRange().getValues();
  var out = [];
  for (var r = values.length - 1; r >= 1; r--) {
    if (values[r][1] === moduleType && String(values[r][2]) === String(itemId)) {
      out.push({ eventType: values[r][3], username: values[r][4], details: values[r][5], date: formatCellDate(values[r][6]) });
    }
  }
  return out;
}

// کامپوننت مشترک نمایش پیوست/نظر/لاگ در صفحه‌ی جزئیات هر آیتم (بدون تغییر ماژول‌های قدیمی)
function crossCuttingWidgetsHtml(scriptUrl, session, moduleType, itemId, redirectView, redirectId) {
  var atts = listAttachments(moduleType, itemId);
  var cmts = listComments(moduleType, itemId);
  var log = listActivity(moduleType, itemId);
  var token = session.__token || '';
  var backFieldsHtml = redirectView
    ? '<input type="hidden" name="backView" value="' + escapeHtml(redirectView) + '"><input type="hidden" name="backId" value="' + escapeHtml(redirectId || '') + '">'
    : '';

  var attHtml = atts.length
    ? atts.map(function (a) { return '<div class="dash-item"><a target="_blank" href="' + escapeHtml(a.link) + '">' + escapeHtml(a.fileName) + '</a><span class="dash-item-date">' + escapeHtml(a.username) + ' · ' + escapeHtml(a.date) + '</span></div>'; }).join('')
    : '<div class="dash-empty">پیوستی ثبت نشده.</div>';

  var cmtHtml = cmts.length
    ? cmts.map(function (c) { return '<div class="dash-item" style="display:block;"><b>' + escapeHtml(c.username) + '</b> <span class="dash-item-date">' + escapeHtml(c.date) + '</span><div>' + escapeHtml(c.text) + '</div></div>'; }).join('')
    : '<div class="dash-empty">نظری ثبت نشده.</div>';

  var logHtml = log.length
    ? log.slice(0, 20).map(function (l) { return '<div class="dash-item">' + escapeHtml(l.eventType) + ' — ' + escapeHtml(l.details || '') + '<span class="dash-item-date">' + escapeHtml(l.username) + ' · ' + escapeHtml(l.date) + '</span></div>'; }).join('')
    : '<div class="dash-empty">فعالیتی ثبت نشده.</div>';

  return (
    '<div class="dash-grid" style="margin-top:20px;">' +
      '<div class="dash-card">' +
        '<div class="dash-card-head"><span class="dash-card-title">پیوست‌ها</span></div>' +
        '<div class="dash-card-body">' + attHtml + '</div>' +
        '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form" style="margin-top:10px;">' +
          '<input type="hidden" name="action" value="ccAddAttachment">' +
          '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
          '<input type="hidden" name="moduleType" value="' + escapeHtml(moduleType) + '">' +
          '<input type="hidden" name="itemId" value="' + escapeHtml(itemId) + '">' +
          backFieldsHtml +
          '<input type="text" name="fileName" placeholder="نام فایل" required>' +
          '<input type="text" name="link" placeholder="لینک درایو" required>' +
          '<button type="submit">افزودن پیوست</button>' +
        '</form>' +
      '</div>' +
      '<div class="dash-card">' +
        '<div class="dash-card-head"><span class="dash-card-title">نظرات</span></div>' +
        '<div class="dash-card-body">' + cmtHtml + '</div>' +
        '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form" style="margin-top:10px;">' +
          '<input type="hidden" name="action" value="ccAddComment">' +
          '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
          '<input type="hidden" name="moduleType" value="' + escapeHtml(moduleType) + '">' +
          '<input type="hidden" name="itemId" value="' + escapeHtml(itemId) + '">' +
          backFieldsHtml +
          '<input type="text" name="commentText" placeholder="نظر خود را بنویسید..." required>' +
          '<button type="submit">ثبت نظر</button>' +
        '</form>' +
      '</div>' +
      '<div class="dash-card">' +
        '<div class="dash-card-head"><span class="dash-card-title">لاگ فعالیت</span></div>' +
        '<div class="dash-card-body">' + logHtml + '</div>' +
      '</div>' +
    '</div>'
  );
}

// ======================================================================
// ماژول: اقدامات (Actions) — کاملاً جدید
// ======================================================================
function getActionsSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(CONFIG_EXT.ACTIONS_SHEET_NAME);
  if (!sh) {
    sh = ss.insertSheet(CONFIG_EXT.ACTIONS_SHEET_NAME);
    sh.appendRow(['شناسه', 'عنوان', 'شرح', 'منبع', 'شناسه مرجع', 'بخش', 'کاربر مسئول', 'اولویت', 'وضعیت', 'پیشرفت', 'مهلت', 'تاریخ تکمیل', 'ایجادکننده', 'تاریخ ایجاد', 'ویرایش‌کننده', 'تاریخ ویرایش', 'وضعیت انتشار']);
  } else {
    // سازگاری با شیت‌های قبلی: ستون «وضعیت انتشار» را در صورت نبود اضافه می‌کند، بدون دست‌زدن به ستون‌های موجود
    var header = sh.getRange(1, 1, 1, 17).getValues()[0];
    if (!header[16]) sh.getRange(1, 17).setValue('وضعیت انتشار');
  }
  return sh;
}
function rowToAction_(row) {
  return {
    id: String(row[0] == null ? '' : row[0]),
    title: String(row[1] == null ? '' : row[1]),
    description: String(row[2] == null ? '' : row[2]),
    source: String(row[3] == null ? '' : row[3]),
    sourceRefId: String(row[4] == null ? '' : row[4]),
    department: String(row[5] == null ? '' : row[5]),
    assignedUser: String(row[6] == null ? '' : row[6]),
    priority: String(row[7] == null ? '' : row[7]),
    status: String(row[8] == null ? '' : row[8]),
    progress: row[9],
    dueDate: formatCellDateOnly(row[10]),
    completionDate: formatCellDateOnly(row[11]),
    createdBy: String(row[12] == null ? '' : row[12]),
    createdAt: formatCellDate(row[13]),
    updatedBy: String(row[14] == null ? '' : row[14]),
    updatedAt: formatCellDate(row[15]),
    publicationStatus: String(row[16] || CONFIG_EXT.PUB_STATUS_DRAFT)
  };
}
function canManageAction_(session, action) {
  if (isSystemAdmin(session)) return true;
  if (isDeptManager(session)) return action.department === getSessionDepartment(session);
  return action.assignedUser === session.username;
}
function canViewAction_(session, action) {
  if (isSystemAdmin(session)) return true;
  if (action.createdBy === session.username) return true;
  if (!isRecordRegistered_(action)) return false; // پیش‌نویس: فقط ایجادکننده/مدیر سیستم می‌بینند
  return canManageAction_(session, action);
}
// فقط مدیر سیستم/مدیر بخشِ همان بخش/ایجادکننده می‌تواند «تأیید و بستن» یا «عودت برای اصلاح» بزند
function canApproveAction_(session, action) {
  if (isSystemAdmin(session)) return true;
  if (isDeptManager(session)) return action.department === getSessionDepartment(session);
  return action.createdBy === session.username;
}
// مدیر بخش فقط می‌تواند به کاربران بخش خودش ارجاع دهد (سمت سرور، صرف‌نظر از UI)
function validateAssigneeInDept_(session, department, assignedUser) {
  if (!assignedUser || isSystemAdmin(session)) return;
  if (isDeptManager(session)) {
    var target = listUsersExtended().filter(function (u) { return u.username === assignedUser; })[0];
    if (!target || target.department !== getSessionDepartment(session)) {
      throw new Error('مدیر بخش فقط می‌تواند به کاربران بخش خودش ارجاع دهد.');
    }
  }
}
function createAction(session, data) {
  if (!isSystemAdmin(session) && !isDeptManager(session)) throw new Error('فقط مدیر سیستم یا مدیر بخش می‌تواند اقدام ایجاد کند.');
  if (isDeptManager(session) && data.department && data.department !== getSessionDepartment(session)) {
    throw new Error('مدیر بخش فقط می‌تواند برای بخش خودش اقدام ثبت کند.');
  }
  validateAssigneeInDept_(session, data.department, data.assignedUser);
  var title = String(data.title || '').trim();
  if (!title) throw new Error('عنوان الزامی است.');
  var id = Utilities.getUuid();
  var now = nowJalaliString();
  getActionsSheet().appendRow([
    id, title, data.description || '', data.source || 'ارجاع مستقیم مدیر', data.sourceRefId || '',
    data.department || '', data.assignedUser || '', data.priority || 'متوسط', data.status || 'در انتظار', data.progress || '0',
    data.dueDate || '', '', session.username, now, session.username, now, CONFIG_EXT.PUB_STATUS_DRAFT
  ]);
  logActivity('action', id, 'ایجاد', session.username, 'اقدام «' + title + '» ایجاد شد.');
  return id;
}
function findActionRow_(id) {
  var sh = getActionsSheet();
  var values = sh.getDataRange().getValues();
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]) === String(id)) return { rowIndex: r + 1, obj: rowToAction_(values[r]) };
  }
  return null;
}
function getActionById(id) {
  var f = findActionRow_(id);
  return f ? f.obj : null;
}
function updateActionFields_(session, id, fields) {
  var found = findActionRow_(id);
  if (!found) throw new Error('اقدام پیدا نشد.');
  assertRecordEditable_(session, found.obj, canManageAction_(session, found.obj));
  var sh = getActionsSheet();
  var colMap = { title: 2, description: 3, source: 4, sourceRefId: 5, department: 6, assignedUser: 7, priority: 8, status: 9, progress: 10, dueDate: 11, completionDate: 12, publicationStatus: 17 };
  Object.keys(fields).forEach(function (k) {
    if (colMap[k]) sh.getRange(found.rowIndex, colMap[k]).setValue(fields[k]);
  });
  sh.getRange(found.rowIndex, 15).setValue(session.username);
  sh.getRange(found.rowIndex, 16).setValue(nowJalaliString());
  return found.obj;
}
// یادداشت: کارمندِ صرفِ مسئول (نه مدیر/ایجادکننده) نمی‌تواند مستقیماً وضعیت را «بسته» کند —
// باید از مسیر «علامت‌گذاری به‌عنوان تکمیل‌شده» بگذرد که به «در انتظار تأیید» می‌رود.
function setActionStatus(session, id, status, progress) {
  var before = getActionById(id);
  if (!before) throw new Error('اقدام پیدا نشد.');
  if (status === CONFIG_EXT.ACTION_STATUS_CLOSED && !canApproveAction_(session, before)) {
    throw new Error('فقط مدیر بخش/مدیر سیستم یا ایجادکننده می‌تواند اقدام را نهایی و ببندد.');
  }
  var fields = { status: status };
  if (progress !== undefined && progress !== null && progress !== '') fields.progress = progress;
  if (status === CONFIG_EXT.ACTION_STATUS_CLOSED) fields.completionDate = nowJalaliString();
  updateActionFields_(session, id, fields);
  logActivity('action', id, 'تغییر وضعیت', session.username, (before ? before.status : '') + ' ← ' + status);
}
// گردش کار: کاربر مسئول تکمیل را اعلام می‌کند → در انتظار تأیید
function markActionCompleted(session, id) {
  var a = getActionById(id);
  if (!a) throw new Error('اقدام پیدا نشد.');
  if (!canManageAction_(session, a)) throw new Error('شما مسئول این اقدام نیستید.');
  updateActionFields_(session, id, { status: CONFIG_EXT.ACTION_STATUS_PENDING_APPROVAL, progress: '100' });
  logActivity('action', id, 'ارسال برای تأیید', session.username, 'کاربر اعلام کرد اقدام تکمیل شده است.');
}
// مدیر/ایجادکننده تأیید و می‌بندد
function approveAction(session, id) {
  var a = getActionById(id);
  if (!a) throw new Error('اقدام پیدا نشد.');
  if (!canApproveAction_(session, a)) throw new Error('شما اجازه‌ی تأیید این اقدام را ندارید.');
  updateActionFields_(session, id, { status: CONFIG_EXT.ACTION_STATUS_CLOSED, completionDate: nowJalaliString() });
  logActivity('action', id, 'تأیید و بستن', session.username, 'اقدام تأیید و بسته شد.');
}
// مدیر/ایجادکننده برای اصلاح برمی‌گرداند
function returnActionForRevision(session, id, note) {
  var a = getActionById(id);
  if (!a) throw new Error('اقدام پیدا نشد.');
  if (!canApproveAction_(session, a)) throw new Error('شما اجازه‌ی عودت این اقدام را ندارید.');
  updateActionFields_(session, id, { status: CONFIG_EXT.ACTION_STATUS_IN_PROGRESS });
  logActivity('action', id, 'عودت برای اصلاح', session.username, note || '');
}
function assignAction(session, id, department, assignedUser) {
  var a = getActionById(id);
  if (!a) throw new Error('اقدام پیدا نشد.');
  if (isDeptManager(session) && department && department !== getSessionDepartment(session)) {
    throw new Error('مدیر بخش فقط می‌تواند به بخش خودش ارجاع دهد.');
  }
  validateAssigneeInDept_(session, department, assignedUser);
  updateActionFields_(session, id, { department: department, assignedUser: assignedUser });
  logActivity('action', id, 'ارجاع', session.username, 'به ' + (assignedUser || department));
}
function matchesActionFilter_(a, f) {
  if (!f) return true;
  if (f.q) {
    var hay = (a.title + ' ' + a.description + ' ' + a.id).toLowerCase();
    if (hay.indexOf(String(f.q).toLowerCase()) === -1) return false;
  }
  if (f.status && a.status !== f.status) return false;
  if (f.priority && a.priority !== f.priority) return false;
  if (f.department && a.department !== f.department) return false;
  if (f.assignedUser && a.assignedUser !== f.assignedUser) return false;
  if (f.dueDate && String(a.dueDate).indexOf(f.dueDate) === -1) return false;
  if (f.number && String(a.id).indexOf(f.number) === -1) return false;
  return true;
}
function listActions(session, filters) {
  var values = getActionsSheet().getDataRange().getValues();
  var out = [];
  for (var r = values.length - 1; r >= 1; r--) {
    var a = rowToAction_(values[r]);
    if (!canViewAction_(session, a)) continue;
    if (!matchesActionFilter_(a, filters)) continue;
    out.push(a);
    if (out.length >= CONFIG.MAX_LIST_ROWS) break;
  }
  return out;
}

// حذف گروهی اقدامات — فقط مدیر سیستم (نیازمندی ۱)
function deleteActions(session, ids) {
  if (!isSystemAdmin(session)) throw new Error('فقط مدیر سیستم می‌تواند حذف کند.');
  var n = 0;
  (ids || []).forEach(function (id) {
    var f = findActionRow_(id);
    if (!f) return;
    getActionsSheet().deleteRow(f.rowIndex);
    logActivity('action', id, 'حذف', session.username, 'اقدام «' + f.obj.title + '» حذف شد.');
    n++;
  });
  return n;
}

// «ارسال و ارجاع» گروهی — ارجاع به بخش/کاربر انتخاب‌شده و ثبت رسمی اقدامات انتخاب‌شده (نیازمندی ۳)
function submitAndAssignActions(session, ids, department, assignedUser) {
  if (!isSystemAdmin(session) && !isDeptManager(session)) throw new Error('فقط مدیر سیستم یا مدیر بخش می‌تواند ارسال و ارجاع کند.');
  var n = 0;
  (ids || []).forEach(function (id) {
    var a = getActionById(id);
    if (!a) return;
    validateAssigneeInDept_(session, department, assignedUser);
    var fields = { publicationStatus: CONFIG_EXT.PUB_STATUS_REGISTERED };
    if (department) fields.department = department;
    if (assignedUser) fields.assignedUser = assignedUser;
    updateActionFields_(session, id, fields);
    logActivity('action', id, 'ارسال و ارجاع', session.username, 'ثبت شد' + (assignedUser ? (' — ارجاع به ' + assignedUser) : (department ? (' — ارجاع به بخش ' + department) : '')));
    n++;
  });
  return n;
}

// ---------- کامپوننت مشترک: نوار فیلتر پیشرفته (تاریخ/شماره/عنوان/وضعیت/اولویت/بخش/کاربر) ----------
// یک کامپوننت واحد که در همه‌ی صفحات فهرست جدید (اقدامات، مصوبات) استفاده می‌شود.
function advancedFilterBarHtml(scriptUrl, session, view, opts, values, extraHidden) {
  opts = opts || {};
  values = values || {};
  var canSeeOrg = isSystemAdmin(session) || isDeptManager(session);
  var html = '<form method="GET" action="' + escapeHtml(scriptUrl) + '" target="_top" class="filter-bar-docked adv-filter-bar">' +
    '<input type="hidden" name="view" value="' + escapeHtml(view) + '">' +
    '<input type="hidden" name="token" value="' + escapeHtml(session.__token || '') + '">' +
    (extraHidden || '');
  if (opts.title) {
    html += '<input type="text" name="q" value="' + escapeHtml(values.q || '') + '" placeholder="' + escapeHtml(CONTEXT_SEARCH_PLACEHOLDER) + '" class="ctx-search-input">';
  }
  if (opts.number) {
    html += '<input type="text" name="number" value="' + escapeHtml(values.number || '') + '" placeholder="شماره/شناسه" style="width:100px;">';
  }
  if (opts.date) {
    html += '<input type="text" name="dueDate" value="' + escapeHtml(values.dueDate || '') + '" placeholder="تاریخ (1405/04)" style="width:110px;">';
  }
  if (opts.status) {
    html += '<select name="status"><option value="">همه وضعیت‌ها</option>' + CONFIG_EXT.ACTION_STATUSES.map(function (s) {
      return '<option value="' + escapeHtml(s) + '"' + (values.status === s ? ' selected' : '') + '>' + escapeHtml(s) + '</option>';
    }).join('') + '</select>';
  }
  if (opts.priority) {
    html += '<select name="priority"><option value="">همه اولویت‌ها</option>' + CONFIG_EXT.ACTION_PRIORITIES.map(function (p) {
      return '<option value="' + escapeHtml(p) + '"' + (values.priority === p ? ' selected' : '') + '>' + escapeHtml(p) + '</option>';
    }).join('') + '</select>';
  }
  if (opts.department && canSeeOrg) {
    var depts = listDepartments();
    html += '<select name="department"><option value="">همه بخش‌ها</option>' + depts.map(function (d) {
      return '<option value="' + escapeHtml(d.name) + '"' + (values.department === d.name ? ' selected' : '') + '>' + escapeHtml(d.name) + '</option>';
    }).join('') + '</select>';
  }
  if (opts.user && canSeeOrg) {
    var users = listUsersExtended();
    html += '<select name="assignedUser"><option value="">همه کاربران</option>' + users.map(function (u) {
      return '<option value="' + escapeHtml(u.username) + '"' + (values.assignedUser === u.username ? ' selected' : '') + '>' + escapeHtml(u.fullName || u.username) + '</option>';
    }).join('') + '</select>';
  }
  html += '<button type="submit" class="mini-btn">فیلتر</button></form>';
  return html;
}
function readActionFilters_(e) {
  return {
    q: e.parameter.q || '', number: e.parameter.number || '', dueDate: e.parameter.dueDate || '',
    status: e.parameter.status || '', priority: e.parameter.priority || '',
    department: e.parameter.department || '', assignedUser: e.parameter.assignedUser || ''
  };
}
function exportActionsCSV(session, filters) {
  var rows = listActions(session, filters);
  var header = ['شناسه', 'عنوان', 'شرح', 'منبع', 'بخش', 'کاربر مسئول', 'اولویت', 'وضعیت', 'پیشرفت', 'مهلت', 'تاریخ تکمیل', 'ایجادکننده', 'تاریخ ایجاد'];
  var csv = header.join(',') + '\n' + rows.map(function (a) {
    return [a.id, a.title, a.description, a.source, a.department, a.assignedUser, a.priority, a.status, a.progress, a.dueDate, a.completionDate, a.createdBy, a.createdAt]
      .map(function (v) { return '"' + String(v || '').replace(/"/g, '""') + '"'; }).join(',');
  }).join('\n');
  return ContentService.createTextOutput('\uFEFF' + csv).setMimeType(ContentService.MimeType.CSV);
}

// ======================================================================
// ماژول: صورتجلسات و مصوبات جلسات — کاملاً جدید
// ======================================================================
function getMeetingsSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(CONFIG_EXT.MEETINGS_SHEET_NAME);
  if (!sh) {
    sh = ss.insertSheet(CONFIG_EXT.MEETINGS_SHEET_NAME);
    sh.appendRow(['شماره جلسه', 'تاریخ جلسه', 'موضوع', 'حاضرین', 'ثبت‌کننده', 'تاریخ ثبت', 'وضعیت انتشار']);
  } else {
    var header = sh.getRange(1, 1, 1, 7).getValues()[0];
    if (!header[6]) sh.getRange(1, 7).setValue('وضعیت انتشار');
  }
  return sh;
}
function rowToMeeting_(row) {
  return {
    number: String(row[0] == null ? '' : row[0]),
    date: formatCellDateOnly(row[1]),
    subject: String(row[2] == null ? '' : row[2]),
    attendees: String(row[3] == null ? '' : row[3]),
    createdBy: String(row[4] == null ? '' : row[4]),
    createdAt: formatCellDate(row[5]),
    publicationStatus: String(row[6] || CONFIG_EXT.PUB_STATUS_DRAFT)
  };
}
function createMeeting(session, data) {
  if (!isSystemAdmin(session) && !isDeptManager(session)) throw new Error('فقط مدیر سیستم یا مدیر بخش می‌تواند صورتجلسه ثبت کند.');
  var number = String(data.number || '').trim();
  if (!number) throw new Error('شماره جلسه الزامی است.');
  var sh = getMeetingsSheet();
  var values = sh.getDataRange().getValues();
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]).trim() === number) throw new Error('جلسه‌ای با این شماره قبلاً ثبت شده.');
  }
  sh.appendRow([number, data.date || '', data.subject || '', data.attendees || '', session.username, nowJalaliString(), CONFIG_EXT.PUB_STATUS_DRAFT]);
  logActivity('meeting', number, 'ایجاد', session.username, 'صورتجلسه «' + number + '» ثبت شد.');
  return number;
}
function findMeetingRow_(number) {
  var sh = getMeetingsSheet();
  var values = sh.getDataRange().getValues();
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]).trim() === String(number).trim()) return { rowIndex: r + 1, obj: rowToMeeting_(values[r]) };
  }
  return null;
}
function getMeetingByNumber(number) {
  var f = findMeetingRow_(number);
  return f ? f.obj : null;
}
function listMeetings(filters) {
  var values = getMeetingsSheet().getDataRange().getValues();
  var out = [];
  for (var r = values.length - 1; r >= 1; r--) {
    var m = rowToMeeting_(values[r]);
    if (filters && filters.q) {
      var hay = (m.number + ' ' + m.subject).toLowerCase();
      if (hay.indexOf(String(filters.q).toLowerCase()) === -1) continue;
    }
    out.push(m);
    if (out.length >= CONFIG.MAX_LIST_ROWS) break;
  }
  return out;
}

function getResolutionsSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(CONFIG_EXT.RESOLUTIONS_SHEET_NAME);
  if (!sh) {
    sh = ss.insertSheet(CONFIG_EXT.RESOLUTIONS_SHEET_NAME);
    sh.appendRow(['شناسه', 'شماره جلسه', 'تاریخ جلسه', 'بخش', 'کاربر مسئول', 'مهلت', 'وضعیت', 'پیشرفت', 'توضیحات', 'ثبت‌کننده', 'تاریخ ثبت', 'شناسه اقدام مرتبط', 'وضعیت انتشار']);
  } else {
    var header = sh.getRange(1, 1, 1, 13).getValues()[0];
    if (!header[12]) sh.getRange(1, 13).setValue('وضعیت انتشار');
  }
  return sh;
}
function rowToResolution_(row) {
  return {
    id: String(row[0] == null ? '' : row[0]),
    meetingNumber: String(row[1] == null ? '' : row[1]),
    meetingDate: formatCellDateOnly(row[2]),
    department: String(row[3] == null ? '' : row[3]),
    assignedUser: String(row[4] == null ? '' : row[4]),
    dueDate: formatCellDateOnly(row[5]),
    status: String(row[6] == null ? '' : row[6]),
    progress: row[7],
    description: String(row[8] == null ? '' : row[8]),
    createdBy: String(row[9] == null ? '' : row[9]),
    createdAt: formatCellDate(row[10]),
    linkedActionId: String(row[11] == null ? '' : row[11]),
    publicationStatus: String(row[12] || CONFIG_EXT.PUB_STATUS_DRAFT)
  };
}
function createResolution(session, meetingNumber, data) {
  var meeting = getMeetingByNumber(meetingNumber);
  if (!meeting) throw new Error('جلسه پیدا نشد.');
  assertMeetingEditable_(session, meeting);
  if (isDeptManager(session) && data.department && data.department !== getSessionDepartment(session)) {
    throw new Error('مدیر بخش فقط می‌تواند برای بخش خودش مصوبه ثبت کند.');
  }
  validateAssigneeInDept_(session, data.department, data.assignedUser);
  var id = Utilities.getUuid();
  var now = nowJalaliString();
  var actionId = createAction(session, {
    title: 'مصوبه جلسه ' + meetingNumber + ': ' + (data.description || '').substring(0, 60),
    description: data.description || '', source: 'مصوبه جلسه', sourceRefId: meetingNumber,
    department: data.department || '', assignedUser: data.assignedUser || '', priority: data.priority || 'متوسط',
    status: 'در انتظار', progress: '0', dueDate: data.dueDate || ''
  });
  getResolutionsSheet().appendRow([id, meetingNumber, meeting.date, data.department || '', data.assignedUser || '', data.dueDate || '', 'در انتظار', '0', data.description || '', session.username, now, actionId, CONFIG_EXT.PUB_STATUS_DRAFT]);
  logActivity('meeting', meetingNumber, 'مصوبه جدید', session.username, data.description || '');
  return id;
}
function findResolutionRow_(id) {
  var sh = getResolutionsSheet();
  var values = sh.getDataRange().getValues();
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]) === String(id)) return { rowIndex: r + 1, obj: rowToResolution_(values[r]) };
  }
  return null;
}
function canViewResolution_(session, res) {
  if (isSystemAdmin(session)) return true;
  if (res.createdBy === session.username) return true;
  if (!isRecordRegistered_(res)) return false; // پیش‌نویس: فقط ایجادکننده/مدیر سیستم می‌بینند
  if (isDeptManager(session)) return res.department === getSessionDepartment(session);
  return res.assignedUser === session.username;
}
function canApproveResolution_(session, res) {
  if (isSystemAdmin(session)) return true;
  return res.createdBy === session.username;
}
function updateResolutionStatus(session, id, status, progress) {
  var found = findResolutionRow_(id);
  if (!found) throw new Error('مصوبه پیدا نشد.');
  if (!canViewResolution_(session, found.obj) || (!isSystemAdmin(session) && found.obj.assignedUser !== session.username)) {
    throw new Error('شما اجازه‌ی ویرایش این مصوبه را ندارید.');
  }
  assertRecordEditable_(session, found.obj, true);
  if (status === CONFIG_EXT.ACTION_STATUS_CLOSED && !canApproveResolution_(session, found.obj)) {
    throw new Error('فقط ایجادکننده‌ی جلسه یا مدیر سیستم می‌تواند مصوبه را نهایی و ببندد.');
  }
  var sh = getResolutionsSheet();
  sh.getRange(found.rowIndex, 7).setValue(status);
  if (progress !== undefined && progress !== null && progress !== '') sh.getRange(found.rowIndex, 8).setValue(progress);
  logActivity('meeting', found.obj.meetingNumber, 'به‌روزرسانی مصوبه', session.username, (found.obj.status || '') + ' ← ' + status);
  // همگام‌سازی وضعیت با اقدام مرتبط تا در ماژول اقدامات هم دیده شود
  if (found.obj.linkedActionId) {
    try { setActionStatus(session, found.obj.linkedActionId, status, progress); } catch (e) { /* اقدام مرتبط ممکن است حذف شده باشد یا مجوز مجزا داشته باشد */ }
  }
}
// کاربر/بخشِ مسئولِ مصوبه، تکمیل را اعلام می‌کند → در انتظار تأیید (نمی‌تواند مستقیم ببندد)
function markResolutionCompleted(session, id) {
  var found = findResolutionRow_(id);
  if (!found) throw new Error('مصوبه پیدا نشد.');
  if (!isSystemAdmin(session) && found.obj.assignedUser !== session.username) {
    throw new Error('شما مسئول این مصوبه نیستید.');
  }
  assertRecordEditable_(session, found.obj, true);
  var sh = getResolutionsSheet();
  sh.getRange(found.rowIndex, 7).setValue(CONFIG_EXT.ACTION_STATUS_PENDING_APPROVAL);
  sh.getRange(found.rowIndex, 8).setValue('100');
  logActivity('meeting', found.obj.meetingNumber, 'ارسال مصوبه برای تأیید', session.username, 'مسئول اعلام کرد مصوبه تکمیل شده است.');
  if (found.obj.linkedActionId) { try { markActionCompleted(session, found.obj.linkedActionId); } catch (e) { /* نادیده گرفته می‌شود */ } }
}
// مدیر/ثبت‌کننده تأیید و می‌بندد
function approveResolution(session, id) {
  var found = findResolutionRow_(id);
  if (!found) throw new Error('مصوبه پیدا نشد.');
  if (!canApproveResolution_(session, found.obj)) throw new Error('شما اجازه‌ی تأیید این مصوبه را ندارید.');
  assertRecordEditable_(session, found.obj, true);
  var sh = getResolutionsSheet();
  sh.getRange(found.rowIndex, 7).setValue(CONFIG_EXT.ACTION_STATUS_CLOSED);
  logActivity('meeting', found.obj.meetingNumber, 'تأیید و بستن مصوبه', session.username, 'مصوبه تأیید و بسته شد.');
  if (found.obj.linkedActionId) { try { approveAction(session, found.obj.linkedActionId); } catch (e) { /* نادیده گرفته می‌شود */ } }
}
// مدیر/ثبت‌کننده برای اصلاح برمی‌گرداند
function returnResolutionForRevision(session, id, note) {
  var found = findResolutionRow_(id);
  if (!found) throw new Error('مصوبه پیدا نشد.');
  if (!canApproveResolution_(session, found.obj)) throw new Error('شما اجازه‌ی عودت این مصوبه را ندارید.');
  assertRecordEditable_(session, found.obj, true);
  var sh = getResolutionsSheet();
  sh.getRange(found.rowIndex, 7).setValue(CONFIG_EXT.ACTION_STATUS_IN_PROGRESS);
  logActivity('meeting', found.obj.meetingNumber, 'عودت مصوبه برای اصلاح', session.username, note || '');
  if (found.obj.linkedActionId) { try { returnActionForRevision(session, found.obj.linkedActionId, note); } catch (e) { /* نادیده گرفته می‌شود */ } }
}
function listResolutions(session, filters) {
  var values = getResolutionsSheet().getDataRange().getValues();
  var out = [];
  for (var r = values.length - 1; r >= 1; r--) {
    var res = rowToResolution_(values[r]);
    if (!canViewResolution_(session, res)) continue;
    if (filters) {
      if (filters.status && res.status !== filters.status) continue;
      if (filters.department && res.department !== filters.department) continue;
      if (filters.assignedUser && res.assignedUser !== filters.assignedUser) continue;
      if (filters.number && res.id.indexOf(filters.number) === -1 && String(res.meetingNumber).indexOf(filters.number) === -1) continue;
      if (filters.dueDate && String(res.dueDate).indexOf(filters.dueDate) === -1 && String(res.meetingDate).indexOf(filters.dueDate) === -1) continue;
      if (filters.q) {
        var hay = (res.description + ' ' + res.meetingNumber).toLowerCase();
        if (hay.indexOf(String(filters.q).toLowerCase()) === -1) continue;
      }
    }
    out.push(res);
    if (out.length >= CONFIG.MAX_LIST_ROWS) break;
  }
  return out;
}
function listResolutionsForMeeting(meetingNumber) {
  var values = getResolutionsSheet().getDataRange().getValues();
  var out = [];
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][1]).trim() === String(meetingNumber).trim()) out.push(rowToResolution_(values[r]));
  }
  return out;
}
function exportResolutionsCSV(session, filters) {
  var rows = listResolutions(session, filters);
  var header = ['شناسه', 'شماره جلسه', 'تاریخ جلسه', 'بخش', 'کاربر مسئول', 'مهلت', 'وضعیت', 'پیشرفت', 'توضیحات', 'ثبت‌کننده', 'تاریخ ثبت'];
  var csv = header.join(',') + '\n' + rows.map(function (r) {
    return [r.id, r.meetingNumber, r.meetingDate, r.department, r.assignedUser, r.dueDate, r.status, r.progress, r.description, r.createdBy, r.createdAt]
      .map(function (v) { return '"' + String(v || '').replace(/"/g, '""') + '"'; }).join(',');
  }).join('\n');
  return ContentService.createTextOutput('\uFEFF' + csv).setMimeType(ContentService.MimeType.CSV);
}

