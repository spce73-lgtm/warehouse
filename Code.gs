  body += crossCuttingWidgetsHtml(scriptUrl, session, 'meeting', meetingNumber);
  return HtmlService.createHtmlOutput(wrapPage(body, '', session, { activeView: 'meetings' })).setTitle('جزئیات جلسه').addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

