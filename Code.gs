  return HtmlService.createHtmlOutput(wrapPage(body, '', session, { activeView: 'meetings' })).setTitle('صورتجلسات').addMetaTag('viewport', 'width=device-width, initial-scale=1');
}
// ======================================================================
// ماژول: مدیریت قفسه و وزن کالا (Shelf & Item Weight Management)
// همه‌ی موارد این بخش کاملاً افزودنی هستند:
// - شیت «قفسه‌ها» از قبل موجود است و اینجا هرگز ساخته یا rename نمی‌شود؛
//   فقط با تطبیق نام ستون‌ها (همان الگوی findCol موجود در buildItemData) خوانده می‌شود.
// - شیت اصلی کالاها (getSheets()[0]) دست‌نخورده باقی می‌ماند؛ فقط در صورت نبودن،
//   دو ستون جدید «وزن واحد (kg)» و «قفسه» در انتهای آن اضافه می‌شود (idempotent،
//   دقیقاً هم‌الگو با ensureUserExtColumns_ موجود). این افزودن با فرآیند وارد کردن
//   اطلاعات از راهکاران (applyImportPlan_) تداخلی ندارد چون آن تابع فقط ستون‌های
//   شناخته‌شده‌ی خودش را ست می‌کند و کاری به ستون‌های اضافی ندارد.
// - QR اسکنر، لاگین، شمارش انبار و تمام APIهای موجود دقیقاً مثل قبل باقی مانده‌اند.
// - محاسبات/اعتبارسنجی وزن کل و انتخاب قفسه، طبق الزام معماری، فقط سمت سرور
//   (Google Apps Script) انجام می‌شود؛ کلاینت (وب یا اسکنر گیت‌هاب) فقط مقدار
//   آماده را نمایش می‌دهد.
// ======================================================================

var SHELF_CONFIG = {
  SHEET_NAME: 'قفسه‌ها',       // شیت از قبل موجود — هرگز ساخته یا rename نمی‌شود
  ACTIVE_STATUS_VALUE: 'فعال'  // مقدار ستون «وضعیت» که به‌معنای «فعال» است
};

// ---------- خواندن شیت «قفسه‌ها» (فقط خواندنی، بدون ساخت/تغییر ساختار) ----------
function getShelvesSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHELF_CONFIG.SHEET_NAME);
  if (!sh) {
    throw new Error('شیت «' + SHELF_CONFIG.SHEET_NAME + '» پیدا نشد. این شیت باید از قبل در فایل گوگل‌شیت وجود داشته باشد.');
  }
  return sh;
}

function shelvesColumnMap_(headers) {
  function findCol(keyword) {
    for (var i = 0; i < headers.length; i++) if (String(headers[i]).trim().indexOf(keyword) !== -1) return i;
    return -1;
  }
  return {
    codeCol: findCol('کد قفسه'),
    locationCol: findCol('محل'),
    capacityCol: findCol('ظرفیت'),
    statusCol: findCol('وضعیت'),
    descCol: findCol('توضیحات')
  };
}

function listShelves() {
  var sh = getShelvesSheet_();
  var values = sh.getDataRange().getValues();
  if (values.length < 2) return [];
  var headers = values[0].map(function (h) { return String(h).trim(); });
  var cols = shelvesColumnMap_(headers);
  if (cols.codeCol === -1) throw new Error('ستون «کد قفسه» در شیت «' + SHELF_CONFIG.SHEET_NAME + '» پیدا نشد.');

  var out = [];
  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    var code = String(row[cols.codeCol] || '').trim();
    if (!code) continue;
    out.push({
      code: code,
      location: cols.locationCol !== -1 ? String(row[cols.locationCol] || '').trim() : '',
      capacityKg: cols.capacityCol !== -1 ? row[cols.capacityCol] : '',
      status: cols.statusCol !== -1 ? String(row[cols.statusCol] || '').trim() : '',
      description: cols.descCol !== -1 ? String(row[cols.descCol] || '').trim() : ''
    });
  }
  return out;
}

function listActiveShelves() {
  return listShelves().filter(function (s) { return s.status === SHELF_CONFIG.ACTIVE_STATUS_VALUE; });
}

function findShelfByCode_(code) {
  var normalized = normalizePersianDigits_(String(code || '').trim());
  if (!normalized) return null;
  var all = listShelves();
  for (var i = 0; i < all.length; i++) {
    if (normalizePersianDigits_(all[i].code) === normalized) return all[i];
  }
  return null;
}

// ---------- افزودن idempotent ستون‌های «وزن واحد»/«قفسه» به شیت اصلی کالاها (فقط در مسیر ویرایش، نه در مسیر خواندن) ----------
function ensureItemWeightShelfColumns_() {
  var mainSheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
  var lastCol = mainSheet.getLastColumn();
  var headers = lastCol > 0 ? mainSheet.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h).trim(); }) : [];
  function findCol(keyword) {
    for (var i = 0; i < headers.length; i++) if (headers[i].indexOf(keyword) !== -1) return i;
    return -1;
  }
  var weightCol = findCol('وزن واحد');
  var shelfCol = findCol('قفسه');
  if (weightCol === -1) {
    lastCol += 1;
    mainSheet.getRange(1, lastCol).setValue('وزن واحد (kg)');
    weightCol = lastCol - 1;
  }
  if (shelfCol === -1) {
    lastCol += 1;
    mainSheet.getRange(1, lastCol).setValue('قفسه');
    shelfCol = lastCol - 1;
  }
  return { weightCol: weightCol, shelfCol: shelfCol };
}

// ---------- ویرایش وزن واحد / قفسه یک کالا (منطق اصلی، مشترک بین وب‌اپ، google.script.run و API موبایل) ----------
// همه‌ی اعتبارسنجی‌ها و محاسبات اینجا (سمت سرور) انجام می‌شود؛ هیچ کلاینتی مقدار نهایی را خودش حساب نمی‌کند.
function updateItemWeightShelf(session, itemCode, newUnitWeight, newShelfCode) {
  if (!hasWarehouseAccess(session)) throw new Error('شما به بخش انبار دسترسی ندارید.');

  itemCode = String(itemCode || '').trim();
  if (!itemCode) throw new Error('کد کالا نامعتبر است.');

  // اعتبارسنجی وزن واحد: باید خالی یا عددی نامنفی باشد
  var weightRaw = normalizePersianDigits_(String(newUnitWeight === undefined || newUnitWeight === null ? '' : newUnitWeight).trim());
  var weight = '';
  if (weightRaw !== '') {
    weight = Number(weightRaw);
    if (isNaN(weight) || weight < 0) throw new Error('وزن واحد باید عددی نامنفی باشد.');
  }

  // اعتبارسنجی قفسه: فقط از بین قفسه‌های فعالِ شیت «قفسه‌ها» (یا خالی = بدون قفسه)
  var shelfCode = String(newShelfCode || '').trim();
  if (shelfCode) {
    var shelf = findShelfByCode_(shelfCode);
    if (!shelf) throw new Error('قفسه‌ی انتخاب‌شده در شیت «' + SHELF_CONFIG.SHEET_NAME + '» پیدا نشد.');
    if (shelf.status !== SHELF_CONFIG.ACTIVE_STATUS_VALUE) throw new Error('فقط قفسه‌های فعال قابل انتخاب هستند.');
  }

  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var cols = ensureItemWeightShelfColumns_();
    var mainSheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
    var values = mainSheet.getDataRange().getValues();
    var headers = values[0].map(function (h) { return String(h).trim(); });
    function findCol(keyword) {
      for (var i = 0; i < headers.length; i++) if (headers[i].indexOf(keyword) !== -1) return i;
      return -1;
    }
    var idCol = findCol('کد');
    if (idCol === -1) throw new Error('ستون کد کالا در شیت کالاها پیدا نشد.');

    var normalizedId = normalizePersianDigits_(itemCode);
    var oldWeight = null, oldShelf = null, updatedAny = false;
    for (var r = 1; r < values.length; r++) {
      if (normalizePersianDigits_(String(values[r][idCol]).trim()) !== normalizedId) continue;
      if (!updatedAny) { oldWeight = values[r][cols.weightCol]; oldShelf = values[r][cols.shelfCol]; }
      mainSheet.getRange(r + 1, cols.weightCol + 1).setValue(weight);
      mainSheet.getRange(r + 1, cols.shelfCol + 1).setValue(shelfCode);
      updatedAny = true;
    }
    if (!updatedAny) throw new Error('کالایی با کد «' + itemCode + '» پیدا نشد.');

    // پاک‌سازی کش مقادیر شیت کالاها (و کش بار قفسه) تا تغییر بلافاصله در نمایش‌های بعدی (و همین صفحه) منعکس شود
    invalidateSheetCache_();

    // ثبت لاگ تغییرات: کاربر، مقدار قبلی، مقدار جدید، تاریخ+ساعت شمسی (از همان logActivity موجود)
    var oldWeightDisplay = (oldWeight === '' || oldWeight === null || oldWeight === undefined) ? '—' : String(oldWeight);
    var newWeightDisplay = (weight === '') ? '—' : String(weight);
    if (String(oldWeight || '') !== String(weight)) {
      logActivity('item', normalizedId, 'ویرایش وزن واحد', session.username, 'از «' + oldWeightDisplay + '» به «' + newWeightDisplay + '» (kg)');
    }
    var oldShelfDisplay = oldShelf ? String(oldShelf) : '—';
    var newShelfDisplay = shelfCode || '—';
    if (String(oldShelf || '') !== String(shelfCode)) {
      logActivity('item', normalizedId, 'ویرایش قفسه', session.username, 'از «' + oldShelfDisplay + '» به «' + newShelfDisplay + '»');
    }
  } finally {
    lock.releaseLock();
  }

  // بازخوانی کامل اطلاعات به‌روزشده‌ی کالا (شامل وزن کل تازه‌محاسبه‌شده) — همان buildItemData موجود
  return buildItemData(itemCode);
}

// پوسته‌ی نازک برای فراخوانی از طریق google.script.run در صفحه‌ی جزئیات کالا (همان الگوی recordCount)
function updateItemWeightShelfClient(token, code, unitWeight, shelfCode) {
  var session = getSession(token);
  if (!session) return { success: false, message: 'نشست شما منقضی شده؛ صفحه را رفرش کنید.' };
  try {
    var fresh = updateItemWeightShelf(session, code, unitWeight, shelfCode);
    return {
      success: true,
      unitWeightDisplay: fresh.unitWeightDisplay,
      totalWeightDisplay: fresh.totalWeightDisplay,
      shelfDisplay: fresh.shelfDisplay,
      shelfCode: fresh.shelfCode,
      shelfLoad: fresh.shelfLoad // متریک تازه‌ی ظرفیت قفسه، تا پنل ظرفیت هم بدون رفرش صفحه به‌روز شود
    };
  } catch (err) {
    return { success: false, message: err.message };
  }
}

// ---------- API های JSONP برای اسکنر مستقل گیت‌هاب‌پیجز (همان الگوی apiLogin/apiLookupItem/apiRecordCount) ----------
function apiListActiveShelves(token, callback) {
  try {
    var session = getSession(token);
    if (!session) return jsonOut({ success: false, message: 'نشست منقضی شده؛ دوباره وارد شوید.', needLogin: true }, callback);
    if (!hasWarehouseAccess(session)) return jsonOut({ success: false, message: 'شما به بخش انبار دسترسی ندارید.' }, callback);
    return jsonOut({ success: true, shelves: listActiveShelves() }, callback);
  } catch (err) {
    return jsonOut({ success: false, message: err.message }, callback);
  }
}

function apiUpdateItemWeightShelf(token, code, unitWeight, shelfCode, callback) {
  try {
    var session = getSession(token);
    if (!session) return jsonOut({ success: false, message: 'نشست منقضی شده؛ دوباره وارد شوید.', needLogin: true }, callback);
    var fresh = updateItemWeightShelf(session, code, unitWeight, shelfCode);
    return jsonOut({
      success: true, code: fresh.code,
      unitWeight: fresh.unitWeight, shelfCode: fresh.shelfCode, shelf: fresh.shelf, totalWeight: fresh.totalWeight,
      unitWeightDisplay: fresh.unitWeightDisplay, totalWeightDisplay: fresh.totalWeightDisplay, shelfDisplay: fresh.shelfDisplay,
      shelfLoad: fresh.shelfLoad
    }, callback);
  } catch (err) {
    return jsonOut({ success: false, message: err.message }, callback);
  }
}
// ======================================================================
// ماژول: نظارت خودکار بار قفسه (Shelf Load Capacity Monitoring)
// همه‌ی محاسبات (بار فعلی، باقیمانده، درصد استفاده، وضعیت) فقط اینجا —
// سمت سرور Google Apps Script — انجام می‌شود. کلاینت‌ها (وب‌اپ، اسکنر
// موبایل گیت‌هاب‌پیجز) فقط همین مقادیر آماده را نمایش می‌دهند.
// بار فعلی هر قفسه = Σ(تعداد × وزن واحد) برای همه‌ی کالاهایی که «قفسه»‌شان
// برابر همان قفسه است — از شیت اصلی کالاها محاسبه می‌شود و به‌صورت کوتاه‌مدت
// کش می‌شود (برای جلوگیری از محاسبه‌ی تکراری روی هر مشاهده‌ی کالا/قفسه)؛
// با این حال، با هر تغییر تعداد، وزن واحد یا قفسه‌ی یک کالا (چه از راه
// ویرایش دستی، چه از راه وارد کردن اطلاعات از راهکاران)، کش بلافاصله
// پاک می‌شود، پس در همان درخواست بعدی هم‌چنان به‌طور خودکار به‌روز است.
// ======================================================================

// ---------- آستانه‌های وضعیت بار قفسه ----------
var SHELF_LOAD_THRESHOLDS = {
  WARNING: 70,   // ۷۰٪ تا ۸۵٪ = هشدار
  CRITICAL: 85,  // ۸۵٪ تا ۱۰۰٪ = بحرانی
  OVERLOAD: 100  // بیش از ۱۰۰٪ = اضافه‌بار
};

function shelfLoadStatus_(usagePercent) {
  if (usagePercent === null || usagePercent === undefined || isNaN(usagePercent)) return 'نامشخص';
  if (usagePercent > SHELF_LOAD_THRESHOLDS.OVERLOAD) return 'اضافه‌بار';
  if (usagePercent >= SHELF_LOAD_THRESHOLDS.CRITICAL) return 'بحرانی';
  if (usagePercent >= SHELF_LOAD_THRESHOLDS.WARNING) return 'هشدار';
  return 'عادی';
}
function shelfLoadStatusClass_(status) {
  if (status === 'اضافه‌بار') return 'load-badge-overload';
  if (status === 'بحرانی') return 'load-badge-critical';
  if (status === 'هشدار') return 'load-badge-warning';
  if (status === 'عادی') return 'load-badge-normal';
  return 'load-badge-unknown';
}
function shelfLoadStatusColor_(status) {
  if (status === 'اضافه‌بار') return '#c53030';
  if (status === 'بحرانی') return '#b25400';
  if (status === 'هشدار') return '#a15c00';
  if (status === 'عادی') return '#1a7f37';
  return '#8b94a0';
}

// ---------- محاسبه‌ی بار هر قفسه از روی شیت زنده‌ی کالاها ----------
// خروجی: { 'کد قفسه': { totalWeight: number, items: [{code,name,qty,unitWeight,totalWeight}, ...] } }
function computeShelfLoads_() {
  var cache = CacheService.getScriptCache();
  if (CONFIG.CACHE_SECONDS > 0) {
    try {
      var cached = cache.get('shelf_loads_v1');
      if (cached) return JSON.parse(cached);
    } catch (cacheErr) { /* در صورت خطای کش، مثل قبل محاسبه می‌شود */ }
  }

  var values = getSheetValues();
  var headers = values[0].map(function (h) { return String(h).trim(); });
  function findCol(keyword) {
    for (var i = 0; i < headers.length; i++) if (headers[i].indexOf(keyword) !== -1) return i;
    return -1;
  }
  var idCol = findCol('کد');
  var nameCol = findCol('نام کالا'); if (nameCol === -1) nameCol = findCol('نام');
  var qtyCol = findCol('تعداد');
  var weightCol = findCol('وزن واحد');
  var shelfCol = findCol('قفسه');

  var loadByShelf = {};
  if (idCol === -1 || qtyCol === -1 || weightCol === -1 || shelfCol === -1) return loadByShelf; // هنوز هیچ کالایی وزن/قفسه ندارد

  // چون یک کد کالا ممکن است چند ردیف (چند انبار) داشته باشد، ابتدا موجودی هر کد را جمع می‌زنیم
  var itemAgg = {}; // code -> {code, name, qty, unitWeight, shelfCode}
  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    var code = String(row[idCol] || '').trim();
    if (!code) continue;
    var qtyNum = Number(row[qtyCol]);
    if (isNaN(qtyNum)) qtyNum = 0;
    if (!itemAgg[code]) {
      itemAgg[code] = {
        code: code,
        name: nameCol !== -1 ? row[nameCol] : code,
        qty: 0,
        unitWeight: row[weightCol],
        shelfCode: String(row[shelfCol] || '').trim()
      };
    }
    itemAgg[code].qty += qtyNum;
  }

  Object.keys(itemAgg).forEach(function (code) {
    var it = itemAgg[code];
    if (!it.shelfCode) return; // کالای بدون قفسه در بار هیچ قفسه‌ای حساب نمی‌شود
    var uw = it.unitWeight;
    var unitWeightNum = (uw === '' || uw === null || uw === undefined) ? NaN : Number(uw);
    if (isNaN(unitWeightNum)) return; // کالای بدون وزن ثبت‌شده در بار قفسه حساب نمی‌شود
    var totalWeight = Math.round(unitWeightNum * it.qty * 1000) / 1000;
    if (!loadByShelf[it.shelfCode]) loadByShelf[it.shelfCode] = { totalWeight: 0, items: [] };
    loadByShelf[it.shelfCode].totalWeight = Math.round((loadByShelf[it.shelfCode].totalWeight + totalWeight) * 1000) / 1000;
    loadByShelf[it.shelfCode].items.push({ code: it.code, name: it.name, qty: it.qty, unitWeight: unitWeightNum, totalWeight: totalWeight });
  });

  if (CONFIG.CACHE_SECONDS > 0) {
    try { cache.put('shelf_loads_v1', JSON.stringify(loadByShelf), CONFIG.CACHE_SECONDS); } catch (putErr) { /* نادیده گرفته می‌شود، مثل getSheetValues */ }
  }
  return loadByShelf;
}

// یک شیء متریک کامل (ظرفیت/بار/باقیمانده/درصد/وضعیت) برای یک قفسه می‌سازد
function buildShelfLoadMetrics_(shelf, loadEntry) {
  var currentLoad = loadEntry ? loadEntry.totalWeight : 0;
  var capacityRaw = shelf.capacityKg;
  var capacity = (capacityRaw === '' || capacityRaw === null || capacityRaw === undefined) ? null : Number(capacityRaw);
  var capacityValid = capacity !== null && !isNaN(capacity) && capacity > 0;
  var remaining = capacityValid ? Math.round((capacity - currentLoad) * 1000) / 1000 : null;
  var usagePercent = capacityValid ? Math.round((currentLoad / capacity) * 1000) / 10 : null; // یک رقم اعشار
  var status = capacityValid ? shelfLoadStatus_(usagePercent) : 'نامشخص';
  return {
    code: shelf.code, location: shelf.location, status: shelf.status, description: shelf.description,
    capacityKg: capacityValid ? capacity : (capacityRaw || null),
    currentLoad: currentLoad,
    remainingCapacity: remaining,
    usagePercent: usagePercent,
    loadStatus: status,
    loadStatusClass: shelfLoadStatusClass_(status),
    itemCount: loadEntry ? loadEntry.items.length : 0
  };
}

// فهرست همه‌ی قفسه‌ها با متریک بار — برای صفحه‌ی فهرست قفسه‌ها و API موبایل
function listShelvesWithLoad() {
  var shelves = listShelves();
  var loadMap = computeShelfLoads_();
  return shelves.map(function (s) { return buildShelfLoadMetrics_(s, loadMap[s.code]); });
}

// جزئیات یک قفسه: متریک بار + فهرست کالاهای روی آن (کد | نام | تعداد | وزن واحد | وزن کل)
function getShelfDetail(shelfCode) {
  var shelf = findShelfByCode_(shelfCode);
  if (!shelf) throw new Error('قفسه‌ای با کد «' + shelfCode + '» پیدا نشد.');
  var loadMap = computeShelfLoads_();
  var loadEntry = loadMap[shelf.code];
  var metrics = buildShelfLoadMetrics_(shelf, loadEntry);
  // سنگین‌ترین کالاها اول — کمک به تصمیم‌گیری سریع هنگام بازچینی قفسه
  var items = (loadEntry ? loadEntry.items : []).slice().sort(function (a, b) { return b.totalWeight - a.totalWeight; });
  // >>> افزوده شد: سهم هر کالا از بار کل قفسه (درصد) — «کالاها و سهم آن‌ها از بار قفسه»
  items.forEach(function (it) {
    it.sharePercent = (metrics.currentLoad > 0) ? Math.round((it.totalWeight / metrics.currentLoad) * 1000) / 10 : 0;
  });
  // <<< پایان بخش افزوده‌شده
  metrics.items = items;
  return metrics;
}

// ----------------------------------------------------------------------
// صفحات وب‌اپ (درون همان پوسته‌ی سایدبار مشترک؛ با کامپوننت جدول قابل‌فیلتر/مرتب‌سازی)
// ----------------------------------------------------------------------
function shelfUsageBarHtml_(usagePercent, colorHex) {
  if (usagePercent === null || usagePercent === undefined || isNaN(usagePercent)) {
    return '<span style="color:#8b94a0;">—</span>';
  }
  var visualPct = Math.max(0, Math.min(100, usagePercent));
  return '<div style="display:flex;align-items:center;gap:7px;white-space:nowrap;">' +
    '<div class="load-bar-wrap"><div class="load-bar-fill" style="width:' + visualPct + '%;background:' + colorHex + ';"></div></div>' +
    '<span style="font-size:11px;color:' + colorHex + ';font-weight:700;">' + usagePercent + '%</span>' +
  '</div>';
}

