      '<div class="dash-dept-row"><span>منبع</span><span>' + escapeHtml(a.source) + '</span></div>' +
      '<div class="dash-dept-row"><span>بخش</span><span>' + escapeHtml(a.department || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>مسئول</span><span>' + escapeHtml(a.assignedUser || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>اولویت</span><span>' + escapeHtml(a.priority) + '</span></div>' +
      '<div class="dash-dept-row"><span>وضعیت</span><span>' + escapeHtml(a.status) + '</span></div>' +
      '<div class="dash-dept-row"><span>پیشرفت</span><span>' + escapeHtml(String(a.progress)) + '%</span></div>' +
      '<div class="dash-dept-row"><span>مهلت</span><span>' + escapeHtml(a.dueDate || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>تاریخ تکمیل</span><span>' + escapeHtml(a.completionDate || '—') + '</span></div>', null) +
    '</div>';
  // ---- گردش کار تأیید: در حال انجام → (تکمیل توسط مسئول) → در انتظار تأیید → (تأیید مدیر) → بسته ----
  if (canManage && a.status !== CONFIG_EXT.ACTION_STATUS_CLOSED && a.status !== CONFIG_EXT.ACTION_STATUS_PENDING_APPROVAL) {
    body += '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" style="margin:10px 0;">' +
      '<input type="hidden" name="action" value="markActionCompleted">' +
      '<input type="hidden" name="token" value="' + escapeHtml(session.__token) + '">' +
      '<input type="hidden" name="actionId" value="' + escapeHtml(a.id) + '">' +
      '<button type="submit" class="mini-btn" style="background:#0f9d58;color:#fff;">علامت‌گذاری به‌عنوان تکمیل‌شده</button>' +
    '</form>';
  }
  if (canApprove && a.status === CONFIG_EXT.ACTION_STATUS_PENDING_APPROVAL) {
    body += '<div style="display:flex;gap:8px;margin:10px 0;">' +
      '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top">' +
        '<input type="hidden" name="action" value="approveAction"><input type="hidden" name="token" value="' + escapeHtml(session.__token) + '"><input type="hidden" name="actionId" value="' + escapeHtml(a.id) + '">' +
        '<button type="submit" class="mini-btn" style="background:#0f9d58;color:#fff;">تأیید و بستن</button>' +
      '</form>' +
      '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top">' +
        '<input type="hidden" name="action" value="returnActionForRevision"><input type="hidden" name="token" value="' + escapeHtml(session.__token) + '"><input type="hidden" name="actionId" value="' + escapeHtml(a.id) + '">' +
        '<input type="text" name="reviewNote" placeholder="دلیل عودت (اختیاری)" class="mini-input">' +
        '<button type="submit" class="mini-btn" style="background:#c53030;color:#fff;">عودت برای اصلاح</button>' +
      '</form>' +
    '</div>';
  }
  if (canManage) {
    body += '<div class="admin-title">به‌روزرسانی</div>';
    body += '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form">' +
      '<input type="hidden" name="action" value="updateActionStatus">' +
      '<input type="hidden" name="token" value="' + escapeHtml(session.__token) + '">' +
      '<input type="hidden" name="actionId" value="' + escapeHtml(a.id) + '">' +
      '<select name="newStatus">' + CONFIG_EXT.ACTION_STATUSES.map(function (s) { return '<option value="' + escapeHtml(s) + '"' + (s === a.status ? ' selected' : '') + '>' + escapeHtml(s) + '</option>'; }).join('') + '</select>' +
      '<input type="number" name="newProgress" min="0" max="100" value="' + escapeHtml(String(a.progress || 0)) + '" placeholder="پیشرفت %">' +
      '<button type="submit">ثبت</button>' +
    '</form>';
    if (isSystemAdmin(session) || isDeptManager(session)) {
      body += '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form">' +
        '<input type="hidden" name="action" value="assignAction">' +
        '<input type="hidden" name="token" value="' + escapeHtml(session.__token) + '">' +
        '<input type="hidden" name="actionId" value="' + escapeHtml(a.id) + '">' +
        '<select name="newDepartment"><option value="">— بدون بخش —</option>' + depts.map(function (d) { return '<option value="' + escapeHtml(d.name) + '"' + (d.name === a.department ? ' selected' : '') + '>' + escapeHtml(d.name) + '</option>'; }).join('') + '</select>' +
        '<select name="newAssignedUser"><option value="">— ارجاع‌نشده —</option>' + users.map(function (u) { return '<option value="' + escapeHtml(u.username) + '"' + (u.username === a.assignedUser ? ' selected' : '') + '>' + escapeHtml(u.fullName || u.username) + '</option>'; }).join('') + '</select>' +
        '<button type="submit">ارجاع مجدد</button>' +
      '</form>';
    }
  }
  body += crossCuttingWidgetsHtml(scriptUrl, session, 'action', a.id);
  return HtmlService.createHtmlOutput(wrapPage(body, '', session, { activeView: 'actions' })).setTitle('جزئیات اقدام').addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

