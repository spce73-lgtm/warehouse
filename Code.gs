/**
 * سامانه انبار WOSCO - مرحله ۱: ورود کاربران + پنل مدیریت اکانت‌ها
 * ------------------------------------------------------------------
 * شیت‌های خودکارساخته:
 * - "کاربران": نام کاربری | رمز عبور (هش‌شده) | نام کامل | نقش
 * - "نشست‌ها": token | نام کاربری | نقش | createdAt | expiresAt
 * - شیت اول (همان شیت کالاها) دست‌نخورده می‌ماند.
 *
 * رفتار دسترسی:
 * - بدون ورود + با ?id=CODE  -> فقط مشخصات همان کالا (بدون جستجو/اسکن/شمارش)
 * - بدون ورود + بدون id      -> صفحه‌ی ورود
 * - با ورود                 -> جستجو + اسکن + ثبت شمارش کامل، طبق نقش
 * - نقش "مدیر"               -> دسترسی به پنل مدیریت کاربران (?view=admin)
 *
 * اکانت پیش‌فرض اولیه (حتماً بعد از اولین ورود عوض کنید):
 *   نام کاربری: admin   |   رمز عبور: ChangeMe123
 *
 * نصب: Extensions -> Apps Script -> جایگزینی کامل کد قبلی -> Deploy
 * -> Manage deployments -> ویرایش -> New version -> Deploy
 */

// ============ CONFIG ============
var CONFIG = {
  LOGO_URL: 'data:image/png;base64,',
  COMPANY_NAME: 'شرکت بهره‌برداری و پشتیبانی',
  COMPANY_NAME_LINE2: 'انتقال آب خلیج فارس',
  WAREHOUSE_NAME: 'انبار مرکزی قطعه اول',
  ACCENT_COLOR: '#0f4c81',
  CUSTOM_FONT_URL: '',
  CACHE_SECONDS: 60,
  COUNT_SHEET_NAME: 'شمارش انبار',
  MAX_SEARCH_RESULTS: 40,
  USERS_SHEET_NAME: 'کاربران',
  SESSIONS_SHEET_NAME: 'نشست‌ها',
  SESSION_DAYS: 14,
  PASSWORD_SALT: 'wosco-warehouse-2026',
  DEFAULT_ADMIN_USERNAME: 'admin',
  DEFAULT_ADMIN_PASSWORD: 'ChangeMe123',
  INBOX_SHEET_NAME: 'کارتابل',
  TASK_ACTIONS_SHEET_NAME: 'اقدامات وظایف',
  PERSONAL_TASKS_SHEET_NAME: 'وظایف شخصی',
  MAX_LIST_ROWS: 60,
  IMPORT_SHEET_NAME: 'ورود-راهکاران',
  IMAGE_COL_KEYWORDS: ['تصویر', 'عکس'],
  // آدرس پایه‌ی وب‌اپ بارکدخوان روی GitHub Pages — QR کدها به این آدرس اشاره می‌کنند
  GITHUB_PAGES_BASE_URL: 'https://spce73-lgtm.github.io/warehouse/',
  // اطلاعات ریپوی گیت‌هاب برای همگام‌سازی فایل استاتیک items.json
  GITHUB_OWNER: 'spce73-lgtm',
  GITHUB_REPO: 'warehouse',
  GITHUB_BRANCH: 'main',
  GITHUB_ITEMS_PATH: 'items.json',
  // توکن گیت‌هاب اینجا نوشته نمی‌شود؛ در Script Properties با کلید GITHUB_TOKEN ذخیره کنید
  GITHUB_TOKEN_PROP_KEY: 'GITHUB_TOKEN'
};
// =================================

function doGet(e) {
  try {
    return doGetInner(e);
  } catch (err) {
    return renderErrorPage(err);
  }
}

function redirectToView(view, session, message) {
  if (view === 'sent') return renderSentPage(session, message, {});
  if (view === 'mytasks') return renderMyTasksPage(session, message);
  if (view === 'trash') return renderTrashPage(session, message);
  if (view === 'taskadmin') return renderTaskAdminPage(session, message, {});
  return renderInboxPage(session, message, {});
}

function doGetInner(e) {
  // ============ API سبک JSON برای اسکنر موبایل مستقل (خارج از اپس‌اسکریپت میزبانی می‌شود) ============
  if (e.parameter.action === 'apiLogin') return apiLogin(e.parameter.username, e.parameter.password, e.parameter.callback);
  if (e.parameter.action === 'apiLookup') return apiLookupItem(e.parameter.token, e.parameter.code, e.parameter.callback);
  if (e.parameter.action === 'apiPublicItem') return apiPublicItem(e.parameter.code, e.parameter.callback); // بدون نیاز به توکن، برای پیش‌نمایش قبل از ورود
  if (e.parameter.action === 'apiSearch') return apiSearchItems(e.parameter.token, e.parameter.q, e.parameter.callback);
  if (e.parameter.action === 'apiRecordCount') return apiRecordCount(e.parameter.token, e.parameter.code, e.parameter.qty, e.parameter.note, e.parameter.warehouse, e.parameter.callback);
  if (e.parameter.action === 'apiGetImportPreview') return apiGetImportPreview(e.parameter.token, e.parameter.callback);
  if (e.parameter.action === 'apiConfirmImport') return apiConfirmImport(e.parameter.token, e.parameter.callback);
  // >>> افزوده شد: API های وزن/قفسه برای اسکنر موبایل (همان الگوی JSONP سایر apiهای بالا)
  if (e.parameter.action === 'apiListActiveShelves') return apiListActiveShelves(e.parameter.token, e.parameter.callback);
  if (e.parameter.action === 'apiUpdateItemWeightShelf') return apiUpdateItemWeightShelf(e.parameter.token, e.parameter.code, e.parameter.unitWeight, e.parameter.shelfCode, e.parameter.callback);
  // <<< پایان بخش افزوده‌شده
  // >>> افزوده شد: API های نظارت خودکار بار قفسه، برای اسکنر موبایل
  if (e.parameter.action === 'apiListShelvesWithLoad') return apiListShelvesWithLoad(e.parameter.token, e.parameter.callback);
  if (e.parameter.action === 'apiGetShelfDetail') return apiGetShelfDetail(e.parameter.token, e.parameter.shelf, e.parameter.callback);
  // <<< پایان بخش افزوده‌شده

  var token = e.parameter.token || '';
  var session = token ? getSession(token) : null;
  if (session) session.__token = token;
  var id = e.parameter.id;
  var q = e.parameter.q || '';
  var view = e.parameter.view || '';

  if (e.parameter.logout) {
    if (token) deleteSession(token);
    return renderLoginPage('با موفقیت خارج شدید.', null);
  }

  if (!session) {
    if (id) {
      return renderDetailPage(id, '', null); // نمایش عمومی محدود، بدون لاگین
    }
    return renderLoginPage('', null, e.parameter.redirectId || '');
  }

  if (e.parameter.redirectId) {
    if (!hasWarehouseAccess(session)) {
      return denyAccessPage(session, '', 'شما به بخش انبار دسترسی ندارید.');
    }
    return renderDetailPage(e.parameter.redirectId, '', session);
  }

  if (view === 'admin') {
    if (session.role !== 'مدیر') {
      return denyAccessPage(session, q, 'شما دسترسی مدیریتی ندارید.');
    }
    return renderAdminPage(session, null);
  }
  if (view === 'importExcel') {
    if (session.role !== 'مدیر') {
      return denyAccessPage(session, q, 'شما دسترسی مدیریتی ندارید.');
    }
    return renderImportPage(session, null, null, null);
  }
  if (view === 'inbox') {
    return renderInboxPage(session, null, readFilters(e));
  }
  if (view === 'sent') {
    return renderSentPage(session, null, readFilters(e));
  }
  if (view === 'compose') {
    return renderComposePage(session, null);
  }
  if (view === 'mytasks') {
    return renderMyTasksPage(session, null, e.parameter.tq || '');
  }
  if (view === 'trash') {
    return renderTrashPage(session, null);
  }
  if (view === 'exportTasks') {
    if (session.role !== 'مدیر') {
      return denyAccessPage(session, q, 'شما دسترسی مدیریتی ندارید.');
    }
    return exportTasksCSV();
  }
  if (view === 'countReport') {
    if (!hasWarehouseAccess(session)) {
      return denyAccessPage(session, q, 'شما به بخش انبار دسترسی ندارید.');
    }
    return renderCountReportPage(session, readCountFilters(e));
  }
  // >>> افزوده شد: نظارت خودکار بار قفسه (فهرست قفسه‌ها + جزئیات یک قفسه)
  if (view === 'shelves') {
    if (!hasWarehouseAccess(session)) {
      return denyAccessPage(session, q, 'شما به بخش انبار دسترسی ندارید.');
    }
    return renderShelvesListPage(session, null);
  }
  if (view === 'shelfDetail' && e.parameter.shelf) {
    if (!hasWarehouseAccess(session)) {
      return denyAccessPage(session, q, 'شما به بخش انبار دسترسی ندارید.');
    }
    return renderShelfDetailPage(session, e.parameter.shelf, null);
  }
  // <<< پایان بخش افزوده‌شده
  if (view === 'exportCounts') {
    if (!hasWarehouseAccess(session)) {
      return denyAccessPage(session, q, 'شما به بخش انبار دسترسی ندارید.');
    }
    return exportCountsCSV(readCountFilters(e));
  }
  if (view === 'exportRemainingItems') {
    if (!hasWarehouseAccess(session)) {
      return denyAccessPage(session, q, 'شما به بخش انبار دسترسی ندارید.');
    }
    return exportRemainingItemsCSV();
  }
  if (view === 'qrLabels') {
    if (session.role !== 'مدیر') {
      return denyAccessPage(session, q, 'شما دسترسی مدیریتی ندارید.');
    }
    return renderQrLabelsPage(session);
  }
  if (view === 'taskadmin') {
    if (session.role !== 'مدیر') {
      return denyAccessPage(session, q, 'شما دسترسی مدیریتی ندارید.');
    }
    return renderTaskAdminPage(session, null, readFilters(e));
  }
  if (view === 'item' && e.parameter.itemId) {
    return renderInboxItemPage(session, e.parameter.itemId, null, e.parameter.back || '');
  }
  // >>> افزوده شد: مسیر جدید داشبورد (برای همه‌ی کاربران واردشده)
  if (view === 'dashboard') {
    return renderDashboardPage(session, null);
  }
  // <<< پایان بخش افزوده‌شده
  // >>> افزوده شد: مسیرهای ماژول اقدامات و جلسات/مصوبات (کاملاً جدید)
  if (view === 'actions') {
    return renderActionsListPageV2(session, null, readActionFilters_(e));
  }
  if (view === 'actionDetail' && e.parameter.id) {
    return renderActionDetailPageV2(session, e.parameter.id, null);
  }
  if (view === 'exportActions') {
    return exportActionsCSV(session, readActionFilters_(e));
  }
  if (view === 'meetings') {
    return renderMeetingsListPageV3(session, null, { q: e.parameter.q || '' });
  }
  if (view === 'meetingDetail' && e.parameter.number) {
    return renderMeetingDetailPageV3(session, e.parameter.number, null, e.parameter.expandRes || '');
  }
  // سازگاری با لینک‌های قدیمی: منوی جداگانه‌ی «مصوبات جلسات» حذف شده؛ مصوبات درون همان جلسه مدیریت می‌شوند
  if (view === 'resolutions') {
    return renderMeetingsListPageV3(session, null, {});
  }
  if (view === 'resolutionDetail' && e.parameter.id) {
    var foundRes_ = findResolutionRow_(e.parameter.id);
    var resMeetingNo_ = foundRes_ ? foundRes_.obj.meetingNumber : '';
    return renderMeetingDetailPageV3(session, resMeetingNo_, null, e.parameter.id);
  }
  if (view === 'exportResolutions') {
    return exportResolutionsCSV(session, readActionFilters_(e));
  }
  // <<< پایان بخش افزوده‌شده
  // >>> افزوده شد: مسیر جدید ماژول مدیریت کاربران/دسترسی‌ها (فقط مدیر سیستم) — هیچ مسیر قبلی را تغییر نمی‌دهد
  if (view === 'userManagement') {
    if (!isSystemAdmin(session)) {
      return denyAccessPage(session, q, 'شما دسترسی مدیریتی ندارید.');
    }
    return renderUserManagementPage(session, null, e.parameter.uq || '');
  }
  // <<< پایان بخش افزوده‌شده

  // >>> افزوده شد: گارد دسترسی انبار برای صفحه‌ی جزئیات کالا / جستجوی پیش‌فرض (فقط برای کاربر واردشده؛
  // مسیر عمومیِ بدون‌لاگین بالاتر و بدون تغییر باقی مانده است)
  if (!hasWarehouseAccess(session)) {
    return denyAccessPage(session, q, 'شما به بخش انبار دسترسی ندارید.');
  }
  // <<< پایان بخش افزوده‌شده
  if (id) {
    return renderDetailPage(id, q, session);
  }
  return renderSearchPage(q, session, '');
}

function doPost(e) {
  try {
    return doPostInner(e);
  } catch (err) {
    return renderErrorPage(err);
  }
}

function renderErrorPage(err) {
  var msg = (err && err.message) ? err.message : String(err);
  var html =
    '<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8">' +
    '<meta name="viewport" content="width=device-width, initial-scale=1">' +
    '<style>body{font-family:Tahoma,sans-serif;background:#fff;color:#1c1f24;padding:40px 20px;text-align:center;}' +
    '.box{max-width:480px;margin:0 auto;background:#fff3f3;border:1px solid #f3c8c8;border-radius:12px;padding:20px;}' +
    'h2{color:#c53030;font-size:16px;margin-bottom:10px;}pre{white-space:pre-wrap;text-align:left;direction:ltr;font-size:12.5px;color:#8b1f1f;}</style>' +
    '</head><body><div class="box"><h2>خطایی رخ داد</h2><pre>' + escapeHtml(msg) + '</pre></div></body></html>';
  return HtmlService.createHtmlOutput(html);
}

function doPostInner(e) {
  var action = e.parameter.action;

  if (action === 'login') {
    return handleLoginAttempt(e.parameter.username, e.parameter.password, e.parameter.redirectId || '');
  }

  var token = e.parameter.token || '';
  var session = token ? getSession(token) : null;
  if (session) session.__token = token;
  if (!session) {
    return renderLoginPage('نشست شما معتبر نیست. دوباره وارد شوید.', null);
  }

  // ---- اکشن‌های عمومی (هر کاربر واردشده) ----
  if (action === 'sendItem') {
    try {
      createInboxItem(e.parameter.itemType, session.username, e.parameter.recipient, e.parameter.subject, e.parameter.body, e.parameter.category);
      return renderSentPage(session, 'ارسال شد.');
    } catch (err) {
      return renderComposePage(session, 'خطا: ' + err.message);
    }
  }
  if (action === 'addTaskAction') {
    addTaskAction(e.parameter.itemId, session.username, e.parameter.actionText);
    return renderInboxItemPage(session, e.parameter.itemId, 'اقدام ثبت شد.', e.parameter.back || '');
  }
  if (action === 'addPersonalTask') {
    createPersonalTask(session.username, e.parameter.taskText);
    return renderMyTasksPage(session, 'وظیفه اضافه شد.');
  }
  if (action === 'closePersonalTask') {
    closePersonalTask(e.parameter.taskId, session.username);
    return renderMyTasksPage(session, 'بسته شد.');
  }
  if (action === 'setReminder') {
    var backView1 = e.parameter.backView || 'inbox';
    try {
      var keys = String(e.parameter.itemKeys || '').split(',').filter(function (k) { return k; });
      var n = setReminders(session, keys, e.parameter.reminderDate);
      return redirectToView(backView1, session, n > 0 ? ('یادآوری برای ' + n + ' مورد ثبت شد.') : 'موردی ثبت نشد.');
    } catch (err) {
      return redirectToView(backView1, session, 'خطا: ' + err.message);
    }
  }
  if (action === 'clearReminder') {
    var backView1b = e.parameter.backView || 'inbox';
    clearReminder(session, e.parameter.reminderRowId);
    return redirectToView(backView1b, session, 'یادآوری حذف شد.');
  }
  if (action === 'trashItems') {
    var backView2 = e.parameter.backView || 'inbox';
    try {
      var ids = String(e.parameter.itemKeys || '').split(',').filter(function (k) { return k; })
        .map(function (k) { return k.split(':'); }).filter(function (p) { return p[0] === 'inbox'; }).map(function (p) { return p[1]; });
      var res = trashInboxItems(session, ids);
      var msg = res.moved + ' مورد به سطل زباله منتقل شد.' + (res.blocked ? (' (' + res.blocked + ' مورد «' + TASK_TYPE + '» قابل حذف نبود.)') : '');
      return redirectToView(backView2, session, msg);
    } catch (err) {
      return redirectToView(backView2, session, 'خطا: ' + err.message);
    }
  }
  if (action === 'restoreTrashItem') {
    restoreTrashItem(session, e.parameter.itemId);
    return renderTrashPage(session, 'بازگردانی شد.');
  }
  if (action === 'permanentDeleteTrashItem') {
    try {
      permanentDeleteTrashItem(session, e.parameter.itemId);
      return renderTrashPage(session, 'برای همیشه حذف شد.');
    } catch (err) {
      return renderTrashPage(session, 'خطا: ' + err.message);
    }
  }

  // >>> افزوده شد: اکشن‌های ماژول اقدامات/جلسات/مصوبات و زیرساخت مشترک پیوست/نظر
  // (این بلوک قبل از گیت «مخصوص مدیر» است چون کارمندان هم باید بتوانند نظر/پیوست ثبت کنند
  // یا وضعیت اقدامِ ارجاع‌شده به خودشان را به‌روزرسانی کنند — مجوز دقیق داخل خودِ توابع بررسی می‌شود)
  if (action === 'createAction') {
    try {
      var newActionId = createAction(session, {
        title: e.parameter.title, description: e.parameter.description, source: e.parameter.source,
        department: e.parameter.department, assignedUser: e.parameter.assignedUser,
        priority: e.parameter.priority, dueDate: e.parameter.dueDate
      });
      return renderActionDetailPageV2(session, newActionId, 'اقدام ایجاد شد.');
    } catch (err) {
      return renderActionsListPageV2(session, 'خطا: ' + err.message, {});
    }
  }
  if (action === 'updateActionStatus') {
    try {
      setActionStatus(session, e.parameter.actionId, e.parameter.newStatus, e.parameter.newProgress);
      return renderActionDetailPageV2(session, e.parameter.actionId, 'وضعیت به‌روزرسانی شد.');
    } catch (err) {
      return renderActionDetailPageV2(session, e.parameter.actionId, 'خطا: ' + err.message);
    }
  }
  if (action === 'assignAction') {
    try {
      assignAction(session, e.parameter.actionId, e.parameter.newDepartment, e.parameter.newAssignedUser);
      return renderActionDetailPageV2(session, e.parameter.actionId, 'ارجاع به‌روزرسانی شد.');
    } catch (err) {
      return renderActionDetailPageV2(session, e.parameter.actionId, 'خطا: ' + err.message);
    }
  }
  if (action === 'markActionCompleted') {
    try {
      markActionCompleted(session, e.parameter.actionId);
      return renderActionDetailPageV2(session, e.parameter.actionId, 'برای تأیید ارسال شد.');
    } catch (err) {
      return renderActionDetailPageV2(session, e.parameter.actionId, 'خطا: ' + err.message);
    }
  }
  if (action === 'approveAction') {
    try {
      approveAction(session, e.parameter.actionId);
      return renderActionDetailPageV2(session, e.parameter.actionId, 'تأیید و بسته شد.');
    } catch (err) {
      return renderActionDetailPageV2(session, e.parameter.actionId, 'خطا: ' + err.message);
    }
  }
  if (action === 'returnActionForRevision') {
    try {
      returnActionForRevision(session, e.parameter.actionId, e.parameter.reviewNote);
      return renderActionDetailPageV2(session, e.parameter.actionId, 'برای اصلاح عودت داده شد.');
    } catch (err) {
      return renderActionDetailPageV2(session, e.parameter.actionId, 'خطا: ' + err.message);
    }
  }
  // >>> افزوده شد: عملیات گروهی روی اقدامات — حذف (فقط مدیر سیستم) و «ارسال و ارجاع» (نیازمندی‌های ۱ و ۳)
  if (action === 'deleteActions') {
    try {
      var delActIds = String(e.parameter.ids || '').split(',').filter(function (x) { return x; });
      var delActN = deleteActions(session, delActIds);
      return renderActionsListPageV2(session, delActN + ' اقدام حذف شد.', {});
    } catch (err) {
      return renderActionsListPageV2(session, 'خطا: ' + err.message, {});
    }
  }
  if (action === 'submitAndAssignActions') {
    try {
      var subActIds = String(e.parameter.ids || '').split(',').filter(function (x) { return x; });
      var subActN = submitAndAssignActions(session, subActIds, e.parameter.department, e.parameter.assignedUser);
      return renderActionsListPageV2(session, subActN + ' اقدام ارسال و ارجاع شد.', {});
    } catch (err) {
      return renderActionsListPageV2(session, 'خطا: ' + err.message, {});
    }
  }
  // <<< پایان بخش افزوده‌شده
  // >>> نسخه‌ی ۳: تمام اکشن‌های مصوبه به صفحه‌ی جزئیاتِ همان جلسه (با گسترش همان مصوبه) بازمی‌گردند
  if (action === 'markResolutionCompleted' || action === 'approveResolution' || action === 'returnResolutionForRevision' || action === 'updateResolutionStatus' || action === 'assignResolution') {
    var mn_ = e.parameter.meetingNumber;
    if (!mn_ && e.parameter.resolutionId) {
      var fr_ = findResolutionRow_(e.parameter.resolutionId);
      mn_ = fr_ ? fr_.obj.meetingNumber : '';
    }
    var resBack = function (msg) { return renderMeetingDetailPageV3(session, mn_, msg, e.parameter.resolutionId); };
    try {
      if (action === 'markResolutionCompleted') { markResolutionCompleted(session, e.parameter.resolutionId); return resBack('برای تأیید ارسال شد.'); }
      if (action === 'approveResolution') { approveResolution(session, e.parameter.resolutionId); return resBack('تأیید و بسته شد.'); }
      if (action === 'returnResolutionForRevision') { returnResolutionForRevision(session, e.parameter.resolutionId, e.parameter.reviewNote); return resBack('برای اصلاح عودت داده شد.'); }
      if (action === 'assignResolution') { assignResolution(session, e.parameter.resolutionId, e.parameter.newDepartment, e.parameter.newAssignedUser); return resBack('ارجاع مصوبه به‌روزرسانی شد.'); }
      updateResolutionStatus(session, e.parameter.resolutionId, e.parameter.newStatus, e.parameter.newProgress);
      return resBack('مصوبه به‌روزرسانی شد.');
    } catch (err) {
      return resBack('خطا: ' + err.message);
    }
  }
  // <<< پایان بخش نسخه‌ی ۳
  if (action === 'createMeeting') {
    try {
      var newMeetingNo = createMeeting(session, { number: e.parameter.meetingNumber, date: e.parameter.meetingDate, subject: e.parameter.subject, attendees: e.parameter.attendees });
      return renderMeetingsListPageV3(session, 'صورتجلسه ثبت شد.', {});
    } catch (err) {
      return renderMeetingsListPageV3(session, 'خطا: ' + err.message, {});
    }
  }
  if (action === 'createResolution') {
    try {
      createResolution(session, e.parameter.meetingNumber, {
        department: e.parameter.department, assignedUser: e.parameter.assignedUser,
        dueDate: e.parameter.dueDate, description: e.parameter.description
      });
      return renderMeetingDetailPageV3(session, e.parameter.meetingNumber, 'مصوبه ثبت شد.', '');
    } catch (err) {
      return renderMeetingDetailPageV3(session, e.parameter.meetingNumber, 'خطا: ' + err.message, '');
    }
  }
  if (action === 'updateMeetingInfo') {
    try {
      updateMeetingInfo(session, e.parameter.meetingNumber, {
        date:      e.parameter.meetingDate,
        subject:   e.parameter.subject,
        attendees: e.parameter.attendees
      });
      return renderMeetingDetailPageV3(session, e.parameter.meetingNumber, 'صورتجلسه ویرایش شد.', '');
    } catch (err) {
      return renderMeetingDetailPageV3(session, e.parameter.meetingNumber, 'خطا: ' + err.message, '');
    }
  }
  // >>> افزوده شد: عملیات گروهی روی صورتجلسات و مصوبات — حذف (فقط مدیر سیستم) و «ارسال و ارجاع» (نیازمندی‌های ۱ و ۳)
  if (action === 'deleteMeetings') {
    try {
      var delMtgIds = String(e.parameter.ids || '').split(',').filter(function (x) { return x; });
      var delMtgN = deleteMeetings(session, delMtgIds);
      return renderMeetingsListPageV3(session, delMtgN + ' صورتجلسه حذف شد.', {});
    } catch (err) {
      return renderMeetingsListPageV3(session, 'خطا: ' + err.message, {});
    }
  }
  if (action === 'registerMeetings') {
    try {
      var pubMtgIds = String(e.parameter.ids || '').split(',').filter(function (x) { return x; });
      var pubMtgN = registerMeetings(session, pubMtgIds);
      return renderMeetingsListPageV3(session, pubMtgN + ' صورتجلسه ثبت رسمی شد.', {});
    } catch (err) {
      return renderMeetingsListPageV3(session, 'خطا: ' + err.message, {});
    }
  }
  if (action === 'deleteResolutions') {
    try {
      var delResIds = String(e.parameter.ids || '').split(',').filter(function (x) { return x; });
      var delResMn = e.parameter.meetingNumber || '';
      var delResN = deleteResolutions(session, delResIds);
      return renderMeetingDetailPageV3(session, delResMn, delResN + ' مصوبه حذف شد.', '');
    } catch (err) {
      return renderMeetingDetailPageV3(session, e.parameter.meetingNumber || '', 'خطا: ' + err.message, '');
    }
  }
  if (action === 'submitAndAssignResolutions') {
    try {
      var subResIds = String(e.parameter.ids || '').split(',').filter(function (x) { return x; });
      var subResMn = e.parameter.meetingNumber || '';
      var subResN = submitAndAssignResolutions(session, subResIds, e.parameter.department, e.parameter.assignedUser);
      return renderMeetingDetailPageV3(session, subResMn, subResN + ' مصوبه ارسال و ارجاع شد.', '');
    } catch (err) {
      return renderMeetingDetailPageV3(session, e.parameter.meetingNumber || '', 'خطا: ' + err.message, '');
    }
  }
  // <<< پایان بخش افزوده‌شده
  if (action === 'ccAddAttachment') {
    // پیوست از رابط کاربری ماژول‌های جدید حذف شده؛ این هندلر فقط برای سازگاری با فراخوانی‌های قدیمی نگه داشته شده است
    var ccBack1 = (e.parameter.moduleType === 'meeting') ? function () { return renderMeetingDetailPageV3(session, e.parameter.itemId, null, ''); } :
      function () { return renderActionDetailPageV2(session, e.parameter.itemId, null); };
    try {
      addAttachment(e.parameter.moduleType, e.parameter.itemId, e.parameter.fileName, e.parameter.link, session.username);
      return ccBack1();
    } catch (err) {
      return ccBack1();
    }
  }
  if (action === 'ccAddComment') {
    // فرم نظرِ مصوبات، «meetingNumber»/«resolutionId» را ارسال می‌کند (نه backMeeting/backResolution)؛
    // هر دو نام بررسی می‌شود تا پس از ثبت نظر روی یک مصوبه، کاربر به همان صفحه‌ی جزئیاتِ جلسه بازگردد.
    var backMeeting_ = e.parameter.backMeeting || e.parameter.meetingNumber || '';
    var backResolution_ = e.parameter.backResolution || e.parameter.resolutionId || '';
    var ccBack2;
    if (backMeeting_) {
      ccBack2 = function (msg) { return renderMeetingDetailPageV3(session, backMeeting_, msg, backResolution_); };
    } else if (e.parameter.moduleType === 'meeting') {
      ccBack2 = function (msg) { return renderMeetingDetailPageV3(session, e.parameter.itemId, msg, ''); };
    } else {
      ccBack2 = function (msg) { return renderActionDetailPageV2(session, e.parameter.itemId, msg); };
    }
    try {
      if (e.parameter.moduleType === 'action') {
        var commentAction_ = getActionById(e.parameter.itemId);
        if (!commentAction_) throw new Error('مورد پیدا نشد.');
        var commentAllowed_ = backMeeting_
          // نظرِ مصوبه: طبق قانونِ سخت‌گیرانه‌ترِ صورتجلسات — فقط مسئولِ مصوبه، ایجادکننده یا مدیر سیستم
          ? (isSystemAdmin(session) || commentAction_.assignedUser === session.username || commentAction_.createdBy === session.username)
          // اقدام مستقل (خارج از صورتجلسات): همان قانون قبلی ماژول اقدامات، بدون تغییر
          : (canManageAction_(session, commentAction_) || commentAction_.createdBy === session.username);
        if (!commentAllowed_) throw new Error('شما اجازه‌ی ثبت نظر روی این مورد را ندارید.');
      }
      addComment(e.parameter.moduleType, e.parameter.itemId, session.username, e.parameter.commentText);
      return ccBack2(null);
    } catch (err) {
      return ccBack2('خطا: ' + err.message);
    }
  }
  // <<< پایان بخش افزوده‌شده

  // ---- اکشن‌های مخصوص مدیر ----
  if (session.role !== 'مدیر') {
    return renderSearchPage('', session, 'شما دسترسی کافی برای این عملیات ندارید.');
  }

  if (action === 'closeTask') {
    closeInboxTask(e.parameter.itemId, session.username);
    return renderInboxItemPage(session, e.parameter.itemId, 'کار بسته شد.', e.parameter.back || '');
  }
  if (action === 'deleteInboxItem') {
    deleteInboxItem(e.parameter.itemId);
    return renderTaskAdminPage(session, 'حذف شد.', {});
  }
  if (action === 'deleteCountRecords') {
    var cFilters = { username: e.parameter.cuser || '', dateQuery: e.parameter.cdate || '', itemQuery: e.parameter.citem || '', onlyMismatch: e.parameter.cmis === '1' };
    try {
      var rIdx = String(e.parameter.rowIndexes || '').split(',').filter(function (x) { return x; });
      var delN = deleteCountRecords(session, rIdx);
      return renderCountReportPage(session, cFilters, delN + ' رکورد شمارش حذف شد.');
    } catch (err) {
      return renderCountReportPage(session, cFilters, 'خطا: ' + err.message);
    }
  }
  if (action === 'addCategory') {
    try {
      addCategory(e.parameter.categoryName);
      return renderTaskAdminPage(session, 'دسته اضافه شد.', {});
    } catch (err) {
      return renderTaskAdminPage(session, 'خطا: ' + err.message, {});
    }
  }
  if (action === 'deleteCategory') {
    deleteCategory(e.parameter.categoryName);
    return renderTaskAdminPage(session, 'دسته حذف شد.', {});
  }
  if (action === 'createUser') {
    createUser(e.parameter.newUsername, e.parameter.newPassword, e.parameter.newFullName, e.parameter.newRole);
    return renderAdminPage(session, 'حساب جدید ایجاد شد.');
  }
  if (action === 'changePassword') {
    setUserPassword(e.parameter.targetUsername, e.parameter.newPassword);
    return renderAdminPage(session, 'رمز عبور تغییر کرد.');
  }
  if (action === 'changeUsername') {
    renameUser(e.parameter.targetUsername, e.parameter.newUsernameValue);
    return renderAdminPage(session, 'نام کاربری تغییر کرد.');
  }
  if (action === 'deleteUser') {
    deleteUser(e.parameter.targetUsername);
    return renderAdminPage(session, 'کاربر حذف شد.');
  }
  if (action === 'previewImport') {
    try {
      var previewPlan = buildImportPlan_();
      return renderImportPage(session, null, previewPlan);
    } catch (err) {
      return renderImportPage(session, 'خطا: ' + err.message, null);
    }
  }
  if (action === 'confirmImport') {
    try {
      var confirmPlan = buildImportPlan_();
      applyImportPlan_(confirmPlan);
      invalidateSheetCache_();
      return renderImportPage(session, '✓ ایمپورت با موفقیت انجام شد: ' + confirmPlan.toAdd.length + ' مورد جدید اضافه شد، ' + confirmPlan.toUpdate.length + ' مورد آپدیت شد.', null);
    } catch (err) {
      return renderImportPage(session, 'خطا: ' + err.message, null);
    }
  }
  if (action === 'confirmImportUpload') {
    if (session.role !== 'مدیر') return renderAdminPage(session, 'شما دسترسی مدیریتی ندارید.');
    var lock2 = LockService.getScriptLock();
    lock2.waitLock(60000);
    try {
      var tempFileId3 = e.parameter.tempFileId;
      var sheet3 = SpreadsheetApp.openById(tempFileId3).getSheets()[0];
      var data3 = sheet3.getDataRange().getValues();
      var headers3 = data3[0].map(function (h) { return String(h).trim(); });
      var rows3 = data3.slice(1);
      var plan3 = buildImportPlanCore_(headers3, rows3);
      applyImportPlan_(plan3);
      try { DriveApp.getFileById(tempFileId3).setTrashed(true); } catch (delErr) {}
      invalidateSheetCache_();
      var githubMsg = '';
      try {
        var syncedCount = pushItemsJsonToGitHub_();
        githubMsg = ' فایل کالاها روی گیت‌هاب هم به‌روزرسانی شد (' + syncedCount + ' قلم).';
      } catch (ghErr) {
        githubMsg = ' ⚠ همگام‌سازی با گیت‌هاب ناموفق بود: ' + ghErr.message;
      }
      return renderImportPage(session, '✓ ایمپورت با موفقیت انجام شد: ' + plan3.toAdd.length + ' مورد جدید اضافه شد، ' + plan3.toUpdate.length + ' مورد آپدیت شد، ' + plan3.unchanged + ' بدون تغییر.' + githubMsg, null);
    } catch (err) {
      return renderImportPage(session, 'خطا: ' + err.message, null);
    } finally {
      lock2.releaseLock();
    }
  }
  // >>> افزوده شد: اکشن‌های ماژول جدید مدیریت کاربران/دپارتمان‌ها
  // (این بلوک زیر همان گیت موجود «if (session.role !== 'مدیر') return ...» قرار دارد،
  // پس دقیقاً مثل بقیه‌ی اکشن‌های مدیریتی فقط برای مدیر سیستم فعال است)
  if (action === 'umCreateDept') {
    try {
      createDepartment(e.parameter.deptName, e.parameter.managerUsername);
      return renderUserManagementPage(session, 'بخش ایجاد شد.');
    } catch (err) {
      return renderUserManagementPage(session, 'خطا: ' + err.message);
    }
  }
  if (action === 'umSetDeptManager') {
    try {
      setDepartmentManager(e.parameter.deptName, e.parameter.managerUsername);
      return renderUserManagementPage(session, 'مدیر بخش ثبت شد.');
    } catch (err) {
      return renderUserManagementPage(session, 'خطا: ' + err.message);
    }
  }
  if (action === 'umDeleteDept') {
    deleteDepartment(e.parameter.deptName);
    return renderUserManagementPage(session, 'بخش حذف شد.');
  }
  if (action === 'umCreateUser') {
    try {
      createUserExt(e.parameter.newUsername, e.parameter.newPassword, e.parameter.newFullName, e.parameter.newRole, e.parameter.newDept, e.parameter.newWarehouseAccess === '1');
      return renderUserManagementPage(session, 'حساب جدید ایجاد شد.');
    } catch (err) {
      return renderUserManagementPage(session, 'خطا: ' + err.message);
    }
  }
  if (action === 'umSetRole') {
    try {
      setUserRoleExt(e.parameter.targetUsername, e.parameter.newRoleValue);
      return renderUserManagementPage(session, 'نقش کاربر به‌روزرسانی شد.');
    } catch (err) {
      return renderUserManagementPage(session, 'خطا: ' + err.message);
    }
  }
  if (action === 'umSetDepartment') {
    try {
      setUserDepartment(e.parameter.targetUsername, e.parameter.newDept);
      return renderUserManagementPage(session, 'بخش کاربر به‌روزرسانی شد.');
    } catch (err) {
      return renderUserManagementPage(session, 'خطا: ' + err.message);
    }
  }
  if (action === 'umSetWarehouseAccess') {
    try {
      setUserWarehouseAccess(e.parameter.targetUsername, e.parameter.warehouseAccessValue === '1');
      return renderUserManagementPage(session, 'دسترسی انبار به‌روزرسانی شد.');
    } catch (err) {
      return renderUserManagementPage(session, 'خطا: ' + err.message);
    }
  }
  if (action === 'umChangePassword') {
    try {
      setUserPassword(e.parameter.targetUsername, e.parameter.newPassword); // تابع موجود، دست‌نخورده
      return renderUserManagementPage(session, 'رمز عبور تغییر کرد.');
    } catch (err) {
      return renderUserManagementPage(session, 'خطا: ' + err.message);
    }
  }
  if (action === 'umDeleteUser') {
    try {
      deleteUser(e.parameter.targetUsername); // تابع موجود، دست‌نخورده
      return renderUserManagementPage(session, 'کاربر حذف شد.');
    } catch (err) {
      return renderUserManagementPage(session, 'خطا: ' + err.message);
    }
  }
  // <<< پایان بخش افزوده‌شده

  if (action === 'syncGithubNow') {
    if (session.role !== 'مدیر') return renderAdminPage(session, 'شما دسترسی مدیریتی ندارید.');
    try {
      var syncedCount2 = pushItemsJsonToGitHub_();
      return renderImportPage(session, '✓ ' + syncedCount2 + ' قلم کالا با گیت‌هاب همگام‌سازی شد.', null);
    } catch (err) {
      return renderImportPage(session, 'خطا: ' + err.message, null);
    }
  }

  return renderAdminPage(session, 'عملیات ناشناخته.');
}

// ============ کاربران و نشست‌ها ============
function getUsersSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(CONFIG.USERS_SHEET_NAME);
  if (!sh) {
    sh = ss.insertSheet(CONFIG.USERS_SHEET_NAME);
    sh.appendRow(['نام کاربری', 'رمز عبور (هش)', 'نام کامل', 'نقش']);
    sh.appendRow([
      CONFIG.DEFAULT_ADMIN_USERNAME,
      hashPassword(CONFIG.DEFAULT_ADMIN_PASSWORD),
      'مدیر سیستم',
      'مدیر'
    ]);
  }
  return sh;
}

function getSessionsSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(CONFIG.SESSIONS_SHEET_NAME);
  if (!sh) {
    sh = ss.insertSheet(CONFIG.SESSIONS_SHEET_NAME);
    sh.appendRow(['token', 'نام کاربری', 'نقش', 'createdAt', 'expiresAt']);
  }
  return sh;
}

function hashPassword(pw) {
  var digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(pw) + CONFIG.PASSWORD_SALT);
  return Utilities.base64Encode(digest);
}

function findUserRow(username) {
  var sh = getUsersSheet();
  var values = sh.getDataRange().getValues();
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]).trim().toLowerCase() === String(username).trim().toLowerCase()) {
      return { rowIndex: r + 1, username: values[r][0], passwordHash: values[r][1], fullName: values[r][2], role: values[r][3] };
    }
  }
  return null;
}

function listUsers() {
  var sh = getUsersSheet();
  var values = sh.getDataRange().getValues();
  var list = [];
  for (var r = 1; r < values.length; r++) {
    list.push({ username: values[r][0], fullName: values[r][2], role: values[r][3] });
  }
  return list;
}

function createUser(username, password, fullName, role) {
  username = String(username || '').trim();
  if (!username || !password) throw new Error('نام کاربری و رمز عبور الزامی است.');
  if (findUserRow(username)) throw new Error('این نام کاربری قبلاً وجود دارد.');
  var sh = getUsersSheet();
  sh.appendRow([username, hashPassword(password), fullName || '', role === 'مدیر' ? 'مدیر' : 'کارمند']);
}

function setUserPassword(username, newPassword) {
  var u = findUserRow(username);
  if (!u) throw new Error('کاربر پیدا نشد.');
  getUsersSheet().getRange(u.rowIndex, 2).setValue(hashPassword(newPassword));
}

function renameUser(oldUsername, newUsername) {
  newUsername = String(newUsername || '').trim();
  if (!newUsername) throw new Error('نام کاربری جدید نامعتبر است.');
  if (findUserRow(newUsername)) throw new Error('این نام کاربری از قبل وجود دارد.');
  var u = findUserRow(oldUsername);
  if (!u) throw new Error('کاربر پیدا نشد.');
  getUsersSheet().getRange(u.rowIndex, 1).setValue(newUsername);
}

function deleteUser(username) {
  var u = findUserRow(username);
  if (!u) return;
  getUsersSheet().deleteRow(u.rowIndex);
}

function createSession(username, role) {
  var sh = getSessionsSheet();
  // >>> افزوده شد: پاک‌سازی نشست‌های منقضی‌شده در زمان ورود (کم‌تکرار) — از رشد بی‌رویه‌ی شیت
  // نشست‌ها جلوگیری می‌کند؛ چون هیچ خروج سمت سرور خودکاری برای اسکنر موبایل وجود ندارد، این
  // پاک‌سازی تنها راهِ جمع‌شدنِ نشست‌های منقضیِ رهاشده است. کاملاً ایمن و بدون اثر روی نشست‌های معتبر.
  try { cleanupExpiredSessions_(sh); } catch (cleanupErr) { /* هرگز نباید ورود را مختل کند */ }
  // <<< پایان بخش افزوده‌شده
  var token = Utilities.getUuid();
  var now = new Date().getTime();
  var expires = now + CONFIG.SESSION_DAYS * 24 * 60 * 60 * 1000;
  sh.appendRow([token, username, role, now, expires]);
  return token;
}

// >>> افزوده شد: پاک‌سازیِ ردیف‌های نشستِ منقضی‌شده (فقط از انتها به ابتدا حذف می‌شود تا اندیس ردیف‌های
// باقی‌مانده به‌هم نریزد). فقط از createSession (زمان ورود) صدا زده می‌شود، نه در مسیر پرتکرارِ getSession.
function cleanupExpiredSessions_(sh) {
  var values = sh.getDataRange().getValues();
  var now = new Date().getTime();
  for (var r = values.length - 1; r >= 1; r--) {
    if (Number(values[r][4]) < now) sh.deleteRow(r + 1);
  }
}
// <<< پایان بخش افزوده‌شده

// >>> افزوده شد: کش نتیجه‌ی معتبرِ نشست (فقط موارد یافت‌شده/معتبر — هرگز موارد نامعتبر/منقضی) تا
// درخواست‌های پرتکرار (هر جست‌وجو، هر مشاهده‌ی کالا، هر بارگذاری صفحه) نیازی به اسکن کامل شیت
// نشست‌ها نداشته باشند. حجم هر مقدار بسیار کوچک است، پس با محدودیت ۱۰۰کیلوبایتی کش مشکلی ندارد.
function getSession(token) {
  if (!token) return null;
  var cache = CacheService.getScriptCache();
  var cacheKey = 'sess_' + token;
  try {
    var cached = cache.get(cacheKey);
    if (cached) return JSON.parse(cached);
  } catch (cacheErr) { /* در صورت خطای کش، مثل قبل از روی شیت خوانده می‌شود */ }

  var sh = getSessionsSheet();
  var values = sh.getDataRange().getValues();
  var now = new Date().getTime();
  for (var r = 1; r < values.length; r++) {
    if (values[r][0] === token) {
      if (Number(values[r][4]) < now) return null;
      var result = { username: values[r][1], role: values[r][2] };
      try { cache.put(cacheKey, JSON.stringify(result), 300); } catch (putErr) { /* نادیده گرفته می‌شود */ }
      return result;
    }
  }
  return null;
}
// <<< پایان بخش افزوده‌شده

function deleteSession(token) {
  var sh = getSessionsSheet();
  var values = sh.getDataRange().getValues();
  for (var r = 1; r < values.length; r++) {
    if (values[r][0] === token) {
      sh.deleteRow(r + 1);
      try { CacheService.getScriptCache().remove('sess_' + token); } catch (cacheErr) {} // >>> افزوده شد: هم‌گام‌سازی کش با خروج
      return;
    }
  }
}

function handleLoginAttempt(username, password, redirectId) {
  var u = findUserRow(username);
  if (!u || u.passwordHash !== hashPassword(password)) {
    return renderLoginPage('نام کاربری یا رمز عبور اشتباه است.', null, redirectId);
  }
  var token = createSession(u.username, u.role);
  var session = { username: u.username, role: u.role, __token: token };
  if (redirectId) {
    return renderDetailPage(redirectId, '', session);
  }
  return renderSearchPage('', session, 'خوش آمدید، ' + (u.fullName || u.username) + '.');
}

// ============ API سبک JSON برای اسکنر بارکد موبایل (صفحه‌ی مستقل خارج از اپس‌اسکریپت) ============
// خروجی هم به‌صورت JSON خام و هم (اگر پارامتر callback داده شود) به‌صورت JSONP
// برگردانده می‌شود تا هیچ محدودیت CORS ای در هیچ مرورگر/گوشی‌ای مانع کار نشود.
function jsonOut(obj, callback) {
  var json = JSON.stringify(obj);
  if (callback) {
    return ContentService.createTextOutput(callback + '(' + json + ');').setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);
}

function apiLogin(username, password, callback) {
  try {
    var u = findUserRow(username);
    if (!u || u.passwordHash !== hashPassword(password || '')) {
      return jsonOut({ success: false, message: 'نام کاربری یا رمز عبور اشتباه است.' }, callback);
    }
    var token = createSession(u.username, u.role);
    // >>> افزوده شد: پرچم دسترسی انبار در پاسخ ورود، برای نمایش/عدم‌نمایش امکانات مخصوص انبار در کلاینت
    var warehouseAccess = hasWarehouseAccess({ username: u.username, role: u.role });
    return jsonOut({ success: true, token: token, username: u.username, role: u.role, fullName: u.fullName || u.username, warehouseAccess: warehouseAccess }, callback);
    // <<< پایان بخش افزوده‌شده
  } catch (err) {
    return jsonOut({ success: false, message: err.message }, callback);
  }
}

/**
 * نسخه‌ی عمومیِ apiLookup — بدون نیاز به توکن/ورود.
 * برای پیش‌نمایش کالا هنگام اسکن QR قبل از لاگین در اپ بارکدخوان.
 * عمداً «موجودی سیستم» را برنمی‌گرداند.
 */
function apiPublicItem(code, callback) {
  try {
    if (!code) return jsonOut({ success: false, message: 'کد خالی است.' }, callback);
    var built = buildItemData(code);
    if (built.error) return jsonOut({ success: false, message: 'کالایی با این کد پیدا نشد.' }, callback);
    return jsonOut({
      success: true, code: built.code, name: built.name,
      images: built.images || [], fields: built.fields || []
      // توجه: systemQty عمداً ارسال نمی‌شود
    }, callback);
  } catch (err) {
    return jsonOut({ success: false, message: err.message }, callback);
  }
}

function apiLookupItem(token, code, callback) {
  try {
    var session = getSession(token);
    if (!session) return jsonOut({ success: false, message: 'نشست منقضی شده؛ دوباره وارد شوید.', needLogin: true }, callback);
    if (!code) return jsonOut({ success: false, message: 'بارکد خالی است.' }, callback);
    var built = buildItemData(code);
    if (built.error) return jsonOut({ success: false, message: 'کالایی با این کد پیدا نشد.' }, callback);
    var result = {
      success: true, code: built.code, name: built.name, systemQty: built.systemQty,
      images: built.images || [], fields: built.fields || [],
      warehouses: built.warehouses || [], lastCount: built.lastCount || null
    };
    // >>> افزوده شد: وزن واحد/قفسه/وزن کل — فقط برای کاربرانی که دسترسی انبار دارند
    if (hasWarehouseAccess(session)) {
      result.unitWeight = built.unitWeight;
      result.shelfCode = built.shelfCode;
      result.shelf = built.shelf;
      result.totalWeight = built.totalWeight;
      result.unitWeightDisplay = built.unitWeightDisplay;
      result.totalWeightDisplay = built.totalWeightDisplay;
      result.shelfDisplay = built.shelfDisplay;
      result.shelfLoad = built.shelfLoad; // ظرفیت/بار فعلی/باقیمانده/درصد/وضعیت قفسه‌ای که این کالا روی آن است
      // فهرست قفسه‌های فعال همراه همین پاسخ ارسال می‌شود تا کلاینت برای پر کردن
      // کشویی قفسه نیازی به یک درخواست جداگانه نداشته باشد (کارایی بهتر روی شبکه‌ی انبار)
      try { result.activeShelves = listActiveShelves(); } catch (shelfErr) { result.activeShelves = []; }
    }
    // <<< پایان بخش افزوده‌شده
    return jsonOut(result, callback);
  } catch (err) {
    return jsonOut({ success: false, message: err.message }, callback);
  }
}

// جست‌وجوی چندین کالای مشابه (دقیقاً همان موتور جست‌وجوی سامانه‌ی اصلی)
function apiSearchItems(token, q, callback) {
  try {
    var session = getSession(token);
    if (!session) return jsonOut({ success: false, message: 'نشست منقضی شده؛ دوباره وارد شوید.', needLogin: true }, callback);
    if (!q || !q.trim()) return jsonOut({ success: false, message: 'عبارت جست‌وجو خالی است.' }, callback);
    var results = searchItems(q);
    return jsonOut({ success: true, results: results }, callback);
  } catch (err) {
    return jsonOut({ success: false, message: err.message }, callback);
  }
}

function apiRecordCount(token, code, qty, note, warehouse, callback) {
  try {
    var res = recordCount(token, code, qty, note, warehouse);
    return jsonOut({ success: true, diff: res.diff }, callback);
  } catch (err) {
    return jsonOut({ success: false, message: err.message }, callback);
  }
}

function getScriptUrlWith(params) {
  var url = ScriptApp.getService().getUrl();
  var qs = Object.keys(params).map(function (k) { return k + '=' + encodeURIComponent(params[k]); }).join('&');
  return url + (qs ? '?' + qs : '');
}

function redirectPage(url) {
  var html = '<!doctype html><html><head><meta charset="utf-8"><script>window.top.location.replace(' + JSON.stringify(url) + ');</' + 'script></head><body></body></html>';
  return HtmlService.createHtmlOutput(html);
}

