// ----------------------------------------------------------------------
// API های JSONP برای اسکنر مستقل گیت‌هاب‌پیجز — فقط نمایش نتیجه‌ی آماده‌ی سرور
// ----------------------------------------------------------------------
function apiListShelvesWithLoad(token, callback) {
  try {
    var session = getSession(token);
    if (!session) return jsonOut({ success: false, message: 'نشست منقضی شده؛ دوباره وارد شوید.', needLogin: true }, callback);
    if (!hasWarehouseAccess(session)) return jsonOut({ success: false, message: 'شما به بخش انبار دسترسی ندارید.' }, callback);
    return jsonOut({ success: true, shelves: listShelvesWithLoad() }, callback);
  } catch (err) {
    return jsonOut({ success: false, message: err.message }, callback);
  }
}

function apiGetShelfDetail(token, shelfCode, callback) {
  try {
    var session = getSession(token);
    if (!session) return jsonOut({ success: false, message: 'نشست منقضی شده؛ دوباره وارد شوید.', needLogin: true }, callback);
    if (!hasWarehouseAccess(session)) return jsonOut({ success: false, message: 'شما به بخش انبار دسترسی ندارید.' }, callback);
    var shelf = getShelfDetail(shelfCode);
    return jsonOut({ success: true, shelf: shelf }, callback);
  } catch (err) {
    return jsonOut({ success: false, message: err.message }, callback);
  }
}
