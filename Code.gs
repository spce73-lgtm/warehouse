function findImportCol_(headers, candidates) {
  for (var c = 0; c < candidates.length; c++) {
    for (var i = 0; i < headers.length; i++) {
      if (headers[i] === candidates[c]) return i;
    }
  }
  for (var c2 = 0; c2 < candidates.length; c2++) {
    for (var i2 = 0; i2 < headers.length; i2++) {
      if (headers[i2].indexOf(candidates[c2]) !== -1) return i2;
    }
  }
  return -1;
}
// ======================================================================
// ماژول صورتجلسات و مصوبات — ادامه و بهبود
// این فایل را به انتهای کد اصلی (Code.gs) اضافه کنید.
// هیچ تابع، شیت یا مسیری از کد قبلی تغییر نمی‌کند.
// ======================================================================

// ======================================================================
// SECTION 1: انتخاب‌گر تاریخ شمسی (قابل استفاده مجدد در همه ماژول‌ها)
// ======================================================================
// این تابع یک فیلد ورودی تاریخ شمسی با پاپ‌آپ تقویم می‌سازد.
// از همان getJalaliMonthGrid و PERSIAN_MONTHS موجود استفاده می‌کند.
// inputName: نام فیلد فرم (مثل "meetingDate")
// inputId:   شناسه یکتا برای این نمونه (مثل "dp_meetingDate")
// value:     مقدار پیش‌فرض (مثل "1405/06/01")
// token:     توکن نشست (برای درخواست سرور)
// todayJ:    آرایه [jy, jm, jd] امروز
function jalaliDateInputHtml(inputName, inputId, value, token, todayJ) {
  var jy = todayJ[0], jm = todayJ[1], jd = todayJ[2];
  var overlayId = inputId + '_overlay';
  var labelId   = inputId + '_label';
  var gridId    = inputId + '_grid';
  var confirmId = inputId + '_confirm';
  var hiddenId  = inputId + '_hidden';
  var calJY     = inputId + '_jy';
  var calJM     = inputId + '_jm';
  var calSel    = inputId + '_sel';
  var monthNames = JSON.stringify(PERSIAN_MONTHS);
  var weekdays   = PERSIAN_WEEKDAYS.map(function(w){ return '<span>' + w + '</span>'; }).join('');
  var safeToken  = escapeHtml(token || '');
  var safeValue  = escapeHtml(value || '');
  var safeId     = escapeHtml(inputId);

  // جاوااسکریپت اختصاصی این نمونه (با نام‌های متغیر یکتا تا تداخل نداشته باشند)
  var script =
    'var ' + calJY + '=' + jy + ',' + calJM + '=' + jm + ',' + calSel + '=null;' +

    'function dpOpen_' + inputId + '(){' +
      calSel + '=null;' +
      'document.getElementById("' + confirmId + '").disabled=true;' +
      'document.getElementById("' + overlayId + '").classList.add("open");' +
      'dpLoad_' + inputId + '();' +
    '}' +

    'function dpClose_' + inputId + '(){' +
      'document.getElementById("' + overlayId + '").classList.remove("open");' +
    '}' +

    'function dpNav_' + inputId + '(dir){' +
      calJM + '+=dir;' +
      'if(' + calJM + '<1){' + calJM + '=12;' + calJY + '--;}' +
      'if(' + calJM + '>12){' + calJM + '=1;' + calJY + '++;}' +
      calSel + '=null;' +
      'document.getElementById("' + confirmId + '").disabled=true;' +
      'dpLoad_' + inputId + '();' +
    '}' +

    'function dpLoad_' + inputId + '(){' +
      'var mn=' + monthNames + ';' +
      'document.getElementById("' + labelId + '").textContent=mn[' + calJM + '-1]+" "+'  + calJY + ';' +
      'document.getElementById("' + gridId + '").innerHTML="<div style=\\"grid-column:1/-1;text-align:center;color:#8b94a0;font-size:12px;padding:14px;\\">در حال بارگذاری...</div>";' +
      'google.script.run' +
        '.withSuccessHandler(function(res){dpRender_' + inputId + '(res);})' +
        '.withFailureHandler(function(){' +
          'document.getElementById("' + gridId + '").innerHTML="<div style=\\"grid-column:1/-1;text-align:center;color:#c53030;font-size:12px;\\">خطا در بارگذاری</div>";' +
        '})' +
        '.getJalaliMonthGrid(' + JSON.stringify(token || '') + ',' + calJY + ',' + calJM + ');' +
    '}' +

    'function dpRender_' + inputId + '(res){' +
      'var grid=document.getElementById("' + gridId + '");' +
      'grid.innerHTML="";' +
      'if(!res||!res.days||!res.days.length)return;' +
      'var firstW=res.days[0].w;' +
      'for(var i=0;i<firstW;i++){var sp=document.createElement("div");grid.appendChild(sp);}' +
      'res.days.forEach(function(d){' +
        'var el=document.createElement("div");el.className="cal-day";el.textContent=d.jd;' +
        'if(res.jy===' + jy + '&&res.jm===' + jm + '&&d.jd===' + jd + ')el.classList.add("today");' +
        'el.onclick=function(){' +
          'Array.prototype.slice.call(grid.querySelectorAll(".cal-day")).forEach(function(x){x.classList.remove("selected");});' +
          'el.classList.add("selected");' + calSel + '=d.jd;' +
          'document.getElementById("' + confirmId + '").disabled=false;' +
        '};' +
        'grid.appendChild(el);' +
      '});' +
    '}' +

    'function dpConfirm_' + inputId + '(){' +
      'if(!' + calSel + ')return;' +
      'function p(n){return(n<10?"0":"")+n;}' +
      'var ds=' + calJY + '+"/"+p(' + calJM + ')+"/"+p(' + calSel + ');' +
      'document.getElementById("' + hiddenId + '").value=ds;' +
      'document.getElementById("' + inputId + '_display").value=ds;' +
      'dpClose_' + inputId + '();' +
    '}';

  return (
    '<div class="dp-wrap" style="position:relative;display:inline-block;width:100%;">' +
      // فیلد نمایشی که کاربر می‌بیند + دکمه تقویم
      '<div style="display:flex;gap:6px;align-items:center;">' +
        '<input type="text" id="' + safeId + '_display" value="' + safeValue + '" placeholder="1405/06/01"' +
          ' oninput="document.getElementById(\'' + hiddenId + '\').value=this.value;"' +
          ' style="flex:1;" autocomplete="off">' +
        '<button type="button" onclick="dpOpen_' + inputId + '()" style="' +
          'background:' + CONFIG.ACCENT_COLOR + ';color:#fff;border:none;border-radius:8px;' +
          'padding:7px 12px;cursor:pointer;font-size:14px;flex-shrink:0;" title="انتخاب تاریخ">📅</button>' +
      '</div>' +
      // فیلد مخفی واقعی که به فرم ارسال می‌شود
      '<input type="hidden" id="' + hiddenId + '" name="' + escapeHtml(inputName) + '" value="' + safeValue + '">' +
      // پاپ‌آپ تقویم (با همان CSS مودال یادآوری)
      '<div id="' + overlayId + '" class="modal-overlay no-print" style="z-index:2000;" onclick="if(event.target===this)dpClose_' + inputId + '()">' +
        '<div class="modal-box" style="max-width:320px;">' +
          '<div class="modal-title">انتخاب تاریخ شمسی</div>' +
          '<div class="cal-head">' +
            '<button type="button" class="cal-nav" onclick="dpNav_' + inputId + '(1)">›</button>' +
            '<div class="cal-label" id="' + labelId + '">—</div>' +
            '<button type="button" class="cal-nav" onclick="dpNav_' + inputId + '(-1)">‹</button>' +
          '</div>' +
          '<div class="cal-weekdays">' + weekdays + '</div>' +
          '<div class="cal-grid" id="' + gridId + '"></div>' +
          '<div class="modal-actions">' +
            '<button type="button" class="mini-btn" onclick="dpClose_' + inputId + '()">انصراف</button>' +
            '<button type="button" class="mini-btn" id="' + confirmId + '" disabled ' +
              'onclick="dpConfirm_' + inputId + '()" style="background:' + CONFIG.ACCENT_COLOR + ';color:#fff;">تأیید</button>' +
          '</div>' +
        '</div>' +
      '</div>' +
      '<script>' + script + '<\/script>' +
    '</div>'
  );
}

// ======================================================================
// SECTION 2: تابع کمکی وضعیت‌های مصوبه با رنگ‌بندی مناسب
// ======================================================================
// وضعیت‌های موجود (از CONFIG_EXT.ACTION_STATUSES):
//   در انتظار | در حال انجام | در انتظار تأیید | بسته | متوقف
// نگاشت به رنگ و لیبل خوانا برای UI
function resolutionStatusBadgeClass_(status) {
  if (status === 'بسته')                return 'badge-done';
  if (status === 'در انتظار تأیید')     return 'badge-progress';
  if (status === 'در حال انجام')        return 'badge-progress';
  if (status === 'متوقف')               return 'badge-warn';
  return 'badge-pending'; // در انتظار
}
// نشان «وضعیت انتشار» — نیازمندی ۱
function pubStatusBadgeHtml_(publicationStatus) {
  var registered = publicationStatus === CONFIG_EXT.PUB_STATUS_REGISTERED || publicationStatus === 'منتشر شده';
  return '<span class="pub-badge ' + (registered ? 'pub-badge-published' : 'pub-badge-draft') + '">' + escapeHtml(registered ? CONFIG_EXT.PUB_STATUS_REGISTERED : CONFIG_EXT.PUB_STATUS_DRAFT) + '</span>';
}

// ======================================================================
// SECTION 3: به‌روزرسانی اطلاعات پایه‌ی یک جلسه (تابع داده‌ای جدید)
// ======================================================================
// اضافه‌شدنی — هیچ تابع قبلی تغییر نمی‌کند.
function updateMeetingInfo(session, number, data) {
  var found = findMeetingRow_(number);
  if (!found) throw new Error('جلسه پیدا نشد.');
  assertMeetingEditable_(session, found.obj);
  var sh = getMeetingsSheet();
  if (data.date     !== undefined) sh.getRange(found.rowIndex, 2).setValue(data.date);
  if (data.subject  !== undefined) sh.getRange(found.rowIndex, 3).setValue(data.subject);
  if (data.attendees !== undefined) sh.getRange(found.rowIndex, 4).setValue(data.attendees);
  logActivity('meeting', number, 'ویرایش', session.username, 'اطلاعات صورتجلسه ویرایش شد.');
}

// آیا کاربر از حاضرینِ این جلسه است؟ — پایه‌ی نیازمندی ۷ (مشاهده‌ی کامل صورتجلسه توسط شرکت‌کنندگان)
function isMeetingAttendee_(session, meeting) {
  if (!session || !meeting) return false;
  return attendeesToUsernameArray_(meeting.attendees).indexOf(session.username) !== -1;
}
// آیا کاربر مجاز به دیدنِ کاملِ صورتجلسه (پنل جزئیات: جدول مصوبات + تاریخچه) است؟
// مدیر سیستم/مدیر بخش/حاضرین جلسه/ثبت‌کننده — سایر کارمندان فقط ردیف خلاصه را در فهرست می‌بینند
// تا جزئیات و تاریخچه‌ی مصوباتِ جلساتی که در آن‌ها شرکت نداشته‌اند فاش نشود (نیازمندی ۷).
function canViewMeetingFully_(session, meeting, resolutions) {
  if (isSystemAdmin(session)) return true;
  if (meeting.createdBy === session.username) return true;
  if (!isRecordRegistered_(meeting)) return false; // پیش‌نویس: فقط ایجادکننده/مدیر سیستم می‌بینند
  if (isDeptManager(session) || isMeetingAttendee_(session, meeting)) return true;
  // کارمندی که مستقیماً مسئولِ یکی از مصوباتِ این جلسه است هم باید کل جلسه را ببیند (نیازمندی ۳)
  if (resolutions && resolutions.some(function (r) { return r.assignedUser === session.username; })) return true;
  return false;
}

// حذف گروهی صورتجلسات — فقط مدیر سیستم؛ مصوبات و اقدامات مرتبط با هر جلسه هم حذف می‌شوند تا داده یتیم نماند (نیازمندی ۱)
function deleteMeetings(session, numbers) {
  if (!isSystemAdmin(session)) throw new Error('فقط مدیر سیستم می‌تواند حذف کند.');
  var n = 0;
  (numbers || []).forEach(function (number) {
    listResolutionsForMeeting(number).forEach(function (r) {
      if (r.linkedActionId) { var fa = findActionRow_(r.linkedActionId); if (fa) getActionsSheet().deleteRow(fa.rowIndex); }
      var fr = findResolutionRow_(r.id); if (fr) getResolutionsSheet().deleteRow(fr.rowIndex);
    });
    var fm = findMeetingRow_(number);
    if (!fm) return;
    getMeetingsSheet().deleteRow(fm.rowIndex);
    logActivity('meeting', number, 'حذف', session.username, 'صورتجلسه و مصوبات آن حذف شد.');
    n++;
  });
  return n;
}

// ثبت رسمی گروهی صورتجلسات — پس از ثبت، برای حاضرین/مسئولین مصوبات قابل مشاهده می‌شود (نیازمندی ۱)
function registerMeetings(session, numbers) {
  if (!isSystemAdmin(session) && !isDeptManager(session)) throw new Error('فقط مدیر سیستم یا مدیر بخش می‌تواند صورتجلسه را ثبت رسمی کند.');
  var n = 0;
  (numbers || []).forEach(function (number) {
    var found = findMeetingRow_(number);
    if (!found) return;
    if (!isRecordRegistered_(found.obj) && found.obj.createdBy !== session.username && !isSystemAdmin(session)) return;
    getMeetingsSheet().getRange(found.rowIndex, 7).setValue(CONFIG_EXT.PUB_STATUS_REGISTERED);
    // آبشاری: تمام مصوباتِ این جلسه (و اقدامِ مرتبط با هرکدام) هم ثبت رسمی می‌شوند تا کاربران/بخش‌های
    // ارجاع‌شده بلافاصله موارد واقعی را ببینند — نه فهرست خالی (رفع باگ: «۰ مورد پس از ثبت»).
    listResolutionsForMeeting(number).forEach(function (r) {
      var fr = findResolutionRow_(r.id);
      if (fr && !isRecordRegistered_(fr.obj)) {
        getResolutionsSheet().getRange(fr.rowIndex, 13).setValue(CONFIG_EXT.PUB_STATUS_REGISTERED);
      }
      if (r.linkedActionId) {
        var fa = findActionRow_(r.linkedActionId);
        if (fa && !isRecordRegistered_(fa.obj)) {
          getActionsSheet().getRange(fa.rowIndex, 17).setValue(CONFIG_EXT.PUB_STATUS_REGISTERED);
        }
      }
    });
    logActivity('meeting', number, 'ثبت رسمی', session.username, 'صورتجلسه و مصوبات آن ثبت رسمی شدند.');
    n++;
  });
  return n;
}

// ======================================================================
// SECTION 4: صفحه‌ی فهرست صورتجلسات — بازنویسی کامل با تقویم شمسی
// (تابع renderMeetingsListPage_ جدید؛ نام متفاوت برای backward compat)
// ======================================================================
// این تابع جایگزین renderMeetingsListPage می‌شود.
// برای فعال‌سازی: در doGetInner پیدا کنید:
//   if (view === 'meetings') return renderMeetingsListPage(...)
// و آن را به:
//   if (view === 'meetings') return renderMeetingsListPageV2(...)
// تغییر دهید.
function renderMeetingsListPageV2(session, message, filters) {
  var scriptUrl = ScriptApp.getService().getUrl();
  var token     = session.__token || '';
  var todayJ    = toJalali(new Date());
  var meetings  = listMeetings(filters);
  var canCreate = isSystemAdmin(session) || isDeptManager(session);

  var body = (message ? '<div class="login-msg ok-msg">' + escapeHtml(message) + '</div>' : '');
  body += contextSearchBarHtml(scriptUrl, session, 'meetings', 'q', (filters && filters.q) || '');

  // ---- فرم ثبت جلسه جدید ----
  if (canCreate) {
    body += '<div class="dash-card" style="margin-bottom:20px;">' +
      '<div class="dash-card-head"><span class="dash-card-title">ثبت صورتجلسه جدید</span></div>' +
      '<div class="dash-card-body">' +
      '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form">' +
        '<input type="hidden" name="action" value="createMeeting">' +
        '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
        '<input type="text" name="meetingNumber" placeholder="شماره جلسه (مثل: ۱۴۰۵/۶/۱)" required>' +
        // تقویم شمسی برای تاریخ جلسه
        '<label style="font-size:12px;color:#5a6472;margin-bottom:2px;display:block;">تاریخ جلسه</label>' +
        jalaliDateInputHtml('meetingDate', 'dp_newMeeting_date', '', token, todayJ) +
        '<input type="text" name="subject" placeholder="موضوع جلسه">' +
        '<textarea name="attendees" rows="2" placeholder="حاضرین (یک نفر در هر خط یا با ویرگول)" ' +
          'style="border:1px solid #dfe3e7;border-radius:9px;padding:9px 12px;font-size:13.5px;font-family:inherit;resize:vertical;"></textarea>' +
        '<button type="submit" style="background:' + CONFIG.ACCENT_COLOR + ';color:#fff;border:none;border-radius:9px;padding:10px 20px;font-size:14px;cursor:pointer;">ثبت صورتجلسه</button>' +
      '</form>' +
      '</div></div>';
  }

  // ---- جدول فهرست جلسات ----
  body += '<div class="admin-title">صورتجلسات (' + meetings.length + ')</div>';
  if (meetings.length === 0) {
    body += '<div class="dash-empty">صورتجلسه‌ای ثبت نشده.</div>';
  } else {
    body += '<div class="users-list">';
    meetings.forEach(function(m) {
      var mResolutions = listResolutionsForMeeting(m.number);
      var totalCount   = mResolutions.length;
      var closedCount  = mResolutions.filter(function(r){ return r.status === CONFIG_EXT.ACTION_STATUS_CLOSED; }).length;
      var pendingCount = mResolutions.filter(function(r){ return r.status === CONFIG_EXT.ACTION_STATUS_PENDING_APPROVAL; }).length;
      var inProgCount  = mResolutions.filter(function(r){ return r.status === CONFIG_EXT.ACTION_STATUS_IN_PROGRESS; }).length;
      var progressPct  = totalCount > 0 ? Math.round((closedCount / totalCount) * 100) : 0;
      body += '<a class="user-row" target="_top" href="' +
        escapeHtml(scriptUrl + '?view=meetings&view=meetingDetail&number=' + encodeURIComponent(m.number) + '&token=' + encodeURIComponent(token)) +
        '" style="text-decoration:none;color:inherit;">' +
        '<div class="user-main">' +
          '<div class="user-name">جلسه ' + escapeHtml(m.number) + ' — ' + escapeHtml(m.subject || 'بدون موضوع') + '</div>' +
          '<div class="user-sub">' +
            escapeHtml(m.date || '—') +
            ' · مصوبات: ' + totalCount +
            (closedCount ? ' · بسته: ' + closedCount : '') +
            (pendingCount ? ' · در انتظار تأیید: ' + pendingCount : '') +
            (inProgCount  ? ' · در حال انجام: ' + inProgCount  : '') +
          '</div>' +
          (totalCount > 0 ?
            '<div style="margin-top:6px;background:#e9edf2;border-radius:6px;height:6px;overflow:hidden;">' +
              '<div style="width:' + progressPct + '%;height:100%;background:' + CONFIG.ACCENT_COLOR + ';transition:width .3s;"></div>' +
            '</div>' : '') +
        '</div>' +
        '<div class="user-actions">' +
          '<span class="mini-btn">مشاهده</span>' +
        '</div>' +
      '</a>';
    });
    body += '</div>';
  }

  return HtmlService.createHtmlOutput(wrapPage(body, '', session, { activeView: 'meetings' }))
    .setTitle('صورتجلسات').addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

// ======================================================================
// SECTION 5: صفحه‌ی جزئیات جلسه — بازنویسی با تقویم شمسی و UI کامل
// (تابع renderMeetingDetailPageV2 جدید)
// ======================================================================
// برای فعال‌سازی در doGetInner:
//   if (view === 'meetingDetail' && e.parameter.number)
//     return renderMeetingDetailPageV2(session, e.parameter.number, null);
function renderMeetingDetailPageV2(session, meetingNumber, message) {
  var scriptUrl = ScriptApp.getService().getUrl();
  var token     = session.__token || '';
  var todayJ    = toJalali(new Date());
  var meeting   = getMeetingByNumber(meetingNumber);
  if (!meeting) return renderMeetingsListPageV2(session, 'جلسه پیدا نشد.', {});

  var canCreate = isSystemAdmin(session) || isDeptManager(session);
  var resolutions = listResolutionsForMeeting(meetingNumber)
    .filter(function(r){ return canViewResolution_(session, r); });

  // آمار مصوبات
  var totalCount  = resolutions.length;
  var closedCount = resolutions.filter(function(r){ return r.status === CONFIG_EXT.ACTION_STATUS_CLOSED; }).length;
  var progressPct = totalCount > 0 ? Math.round((closedCount / totalCount) * 100) : 0;

  var body = (message ? '<div class="login-msg ok-msg">' + escapeHtml(message) + '</div>' : '');

  // سربرگ جلسه
  body += '<div class="dash-card" style="margin-bottom:18px;">' +
    '<div class="dash-card-head">' +
      '<span class="dash-card-title">جلسه‌ی ' + escapeHtml(meeting.number) + '</span>' +
      '<a class="mini-btn" style="margin-inline-start:auto;" target="_top" href="' +
        escapeHtml(scriptUrl + '?view=meetings&token=' + encodeURIComponent(token)) + '">← فهرست جلسات</a>' +
    '</div>' +
    '<div class="dash-card-body">' +
      '<div class="dash-dept-row"><span>موضوع</span><span>' + escapeHtml(meeting.subject || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>تاریخ</span><span>' + escapeHtml(meeting.date || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>حاضرین</span><span style="white-space:pre-wrap;">' + escapeHtml(meeting.attendees || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>ثبت‌کننده</span><span>' + escapeHtml(meeting.createdBy) + ' · ' + escapeHtml(meeting.createdAt) + '</span></div>' +
      (totalCount > 0 ?
        '<div class="dash-dept-row"><span>پیشرفت کلی</span>' +
          '<span>' + progressPct + '% (' + closedCount + ' از ' + totalCount + ' بسته)</span>' +
        '</div>' +
        '<div style="margin-top:4px;background:#e9edf2;border-radius:6px;height:8px;overflow:hidden;">' +
          '<div style="width:' + progressPct + '%;height:100%;background:' + CONFIG.ACCENT_COLOR + ';transition:width .3s;"></div>' +
        '</div>' : '') +
    '</div>' +
  '</div>';

  // ویرایش اطلاعات جلسه (فقط مدیر)
  if (canCreate) {
    body += '<details class="dash-card" style="margin-bottom:18px;">' +
      '<summary style="cursor:pointer;padding:12px 16px;font-weight:700;color:' + CONFIG.ACCENT_COLOR + ';">ویرایش اطلاعات جلسه</summary>' +
      '<div class="dash-card-body">' +
      '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form">' +
        '<input type="hidden" name="action" value="updateMeetingInfo">' +
        '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
        '<input type="hidden" name="meetingNumber" value="' + escapeHtml(meetingNumber) + '">' +
        '<input type="text" name="subject" value="' + escapeHtml(meeting.subject || '') + '" placeholder="موضوع جلسه">' +
        '<label style="font-size:12px;color:#5a6472;display:block;margin-bottom:2px;">تاریخ جلسه</label>' +
        jalaliDateInputHtml('meetingDate', 'dp_editMeeting_date', meeting.date || '', token, todayJ) +
        '<textarea name="attendees" rows="3" placeholder="حاضرین" ' +
          'style="border:1px solid #dfe3e7;border-radius:9px;padding:9px 12px;font-size:13.5px;font-family:inherit;resize:vertical;">' +
          escapeHtml(meeting.attendees || '') + '</textarea>' +
        '<button type="submit">ذخیره تغییرات</button>' +
      '</form>' +
      '</div></details>';
  }

  // ---- مصوبات این جلسه ----
  body += '<div class="admin-title">مصوبات این جلسه (' + resolutions.length + ')</div>';

  // فرم افزودن مصوبه جدید
  if (canCreate) {
    var depts = isDeptManager(session)
      ? listDepartments().filter(function(d){ return d.name === getSessionDepartment(session); })
      : listDepartments();
    var users = isDeptManager(session)
      ? listUsersExtended().filter(function(u){ return u.department === getSessionDepartment(session); })
      : listUsersExtended();

    body += '<div class="dash-card" style="margin-bottom:18px;">' +
      '<div class="dash-card-head"><span class="dash-card-title">افزودن مصوبه</span></div>' +
      '<div class="dash-card-body">' +
      '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form">' +
        '<input type="hidden" name="action" value="createResolution">' +
        '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
        '<input type="hidden" name="meetingNumber" value="' + escapeHtml(meetingNumber) + '">' +
        '<textarea name="description" rows="3" placeholder="متن مصوبه (الزامی)" required ' +
          'style="border:1px solid #dfe3e7;border-radius:9px;padding:9px 12px;font-size:13.5px;font-family:inherit;resize:vertical;"></textarea>' +
        '<select name="department">' +
          '<option value="">— بدون بخش —</option>' +
          depts.map(function(d){ return '<option value="' + escapeHtml(d.name) + '">' + escapeHtml(d.name) + '</option>'; }).join('') +
        '</select>' +
        '<select name="assignedUser">' +
          '<option value="">— ارجاع‌نشده —</option>' +
          users.map(function(u){ return '<option value="' + escapeHtml(u.username) + '">' + escapeHtml(u.fullName || u.username) + '</option>'; }).join('') +
        '</select>' +
        '<label style="font-size:12px;color:#5a6472;display:block;margin-bottom:2px;">مهلت اجرا</label>' +
        jalaliDateInputHtml('dueDate', 'dp_newResolution_due', '', token, todayJ) +
        '<button type="submit" style="background:' + CONFIG.ACCENT_COLOR + ';color:#fff;border:none;border-radius:9px;padding:10px 20px;font-size:14px;cursor:pointer;">ثبت مصوبه</button>' +
      '</form>' +
      '</div></div>';
  }

  // فهرست مصوبات
  if (resolutions.length === 0) {
    body += '<div class="dash-empty">مصوبه‌ای برای این جلسه ثبت نشده.</div>';
  } else {
    body += '<div class="users-list">';
    resolutions.forEach(function(r) {
      body += resolutionRowHtmlV2(scriptUrl, session, r, token);
    });
    body += '</div>';
  }

  // ویجت‌های اشتراکی (پیوست، نظر، لاگ) برای خود جلسه
  body += '<div class="admin-title" style="margin-top:24px;">نظرات و پیوست‌های جلسه</div>';
  body += crossCuttingWidgetsHtml(scriptUrl, session, 'meeting', meetingNumber);

  return HtmlService.createHtmlOutput(wrapPage(body, '', session, { activeView: 'meetings' }))
    .setTitle('جزئیات جلسه').addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

// ======================================================================
// SECTION 6: ردیف مصوبه — نسخه ارتقاءیافته با نشانگر وضعیت و دکمه‌های workflow
// (تابع resolutionRowHtmlV2 جدید)
// ======================================================================
function resolutionRowHtmlV2(scriptUrl, session, res, token) {
  token = token || session.__token || '';
  var canManage = isSystemAdmin(session) || isDeptManager(session) || res.assignedUser === session.username;
  var canApprove = canApproveResolution_(session, res);

  // نشانگر وضعیت
  var statusClass = resolutionStatusBadgeClass_(res.status);
  var progressPct = parseInt(res.progress || 0, 10);

  // دکمه‌های workflow
  var workflowBtns = '';
  if (canManage && res.status !== CONFIG_EXT.ACTION_STATUS_CLOSED) {
    if (res.status !== CONFIG_EXT.ACTION_STATUS_PENDING_APPROVAL) {
      workflowBtns +=
        '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" style="display:inline;">' +
          '<input type="hidden" name="action" value="markResolutionCompleted">' +
          '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
          '<input type="hidden" name="resolutionId" value="' + escapeHtml(res.id) + '">' +
          '<input type="hidden" name="backView" value="meetingDetail">' +
          '<input type="hidden" name="meetingNumber" value="' + escapeHtml(res.meetingNumber) + '">' +
          '<button type="submit" class="mini-btn" style="background:#2d7a3a;color:#fff;" ' +
            'title="اعلام تکمیل — برای تأیید ارسال می‌شود">✓ تکمیل</button>' +
        '</form>';
    }
    if (canApprove && res.status === CONFIG_EXT.ACTION_STATUS_PENDING_APPROVAL) {
      workflowBtns +=
        '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" style="display:inline;">' +
          '<input type="hidden" name="action" value="approveResolution">' +
          '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
          '<input type="hidden" name="resolutionId" value="' + escapeHtml(res.id) + '">' +
          '<input type="hidden" name="backView" value="meetingDetail">' +
          '<input type="hidden" name="meetingNumber" value="' + escapeHtml(res.meetingNumber) + '">' +
          '<button type="submit" class="mini-btn" style="background:' + CONFIG.ACCENT_COLOR + ';color:#fff;" ' +
            'title="تأیید و بستن مصوبه">✓ تأیید</button>' +
        '</form>' +
        '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" style="display:inline;" ' +
          'onsubmit="var n=prompt(\'دلیل عودت:\');if(!n)return false;this.querySelector(\'[name=reviewNote]\').value=n;">' +
          '<input type="hidden" name="action" value="returnResolutionForRevision">' +
          '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
          '<input type="hidden" name="resolutionId" value="' + escapeHtml(res.id) + '">' +
          '<input type="hidden" name="reviewNote" value="">' +
          '<input type="hidden" name="backView" value="meetingDetail">' +
          '<input type="hidden" name="meetingNumber" value="' + escapeHtml(res.meetingNumber) + '">' +
          '<button type="submit" class="mini-btn danger" title="عودت برای اصلاح">↩ عودت</button>' +
        '</form>';
    }
  }

  // فرم تغییر وضعیت + پیشرفت (فشرده)
  var updateForm = '';
  if (canManage && res.status !== CONFIG_EXT.ACTION_STATUS_CLOSED) {
    updateForm =
      '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="inline-form" style="margin-top:6px;">' +
        '<input type="hidden" name="action" value="updateResolutionStatus">' +
        '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
        '<input type="hidden" name="resolutionId" value="' + escapeHtml(res.id) + '">' +
        '<input type="hidden" name="meetingNumber" value="' + escapeHtml(res.meetingNumber) + '">' +
        '<select name="newStatus" class="mini-input">' +
          CONFIG_EXT.ACTION_STATUSES.map(function(s){
            return '<option value="' + escapeHtml(s) + '"' + (s === res.status ? ' selected' : '') + '>' + escapeHtml(s) + '</option>';
          }).join('') +
        '</select>' +
        '<input type="number" name="newProgress" min="0" max="100" value="' + escapeHtml(String(progressPct)) + '" class="mini-input" style="width:65px;" placeholder="%">' +
        '<button type="submit" class="mini-btn">ثبت</button>' +
      '</form>';
  }

  return (
    '<div class="user-row" style="flex-wrap:wrap;gap:4px;">' +
      '<div class="user-main" style="flex:1;min-width:0;">' +
        '<div class="user-name">' + escapeHtml(res.description || '(بدون شرح)') + '</div>' +
        '<div class="user-sub">' +
          '<span class="status-badge ' + statusClass + '">' + escapeHtml(res.status) + '</span>' +
          ' · ' + escapeHtml(res.department || '—') +
          ' · ' + escapeHtml(res.assignedUser || 'ارجاع‌نشده') +
          (res.dueDate ? ' · مهلت: ' + escapeHtml(res.dueDate) : '') +
        '</div>' +
        // نوار پیشرفت
        '<div style="display:flex;align-items:center;gap:8px;margin-top:5px;">' +
          '<div style="flex:1;background:#e9edf2;border-radius:6px;height:5px;overflow:hidden;">' +
            '<div style="width:' + progressPct + '%;height:100%;background:' + CONFIG.ACCENT_COLOR + ';"></div>' +
          '</div>' +
          '<span style="font-size:11px;color:#5a6472;">' + progressPct + '%</span>' +
        '</div>' +
        updateForm +
      '</div>' +
      '<div class="user-actions" style="flex-direction:column;align-items:flex-end;gap:4px;">' +
        workflowBtns +
        '<a class="mini-btn" target="_top" href="' +
          escapeHtml(scriptUrl + '?view=resolutionDetail&id=' + encodeURIComponent(res.id) + '&token=' + encodeURIComponent(token)) +
          '">تاریخچه</a>' +
      '</div>' +
    '</div>'
  );
}

// ======================================================================
// SECTION 7: صفحه‌ی جزئیات مصوبه — ارتقاء با تقویم شمسی در به‌روزرسانی
// (تابع renderResolutionDetailPageV2 جدید)
// ======================================================================
// برای فعال‌سازی در doGetInner:
//   if (view === 'resolutionDetail' && e.parameter.id)
//     return renderResolutionDetailPageV2(session, e.parameter.id, null);
function renderResolutionDetailPageV2(session, id, message) {
  var scriptUrl = ScriptApp.getService().getUrl();
  var token     = session.__token || '';
  var todayJ    = toJalali(new Date());

  var found = findResolutionRow_(id);
  if (!found || !canViewResolution_(session, found.obj)) {
    return renderResolutionsListPageV2(session, 'مصوبه پیدا نشد یا دسترسی ندارید.', {});
  }
  var res       = found.obj;
  var canManage = isSystemAdmin(session) || isDeptManager(session) || res.assignedUser === session.username;
  var canApprove = canApproveResolution_(session, res);
  var linkedAction = res.linkedActionId ? getActionById(res.linkedActionId) : null;
  var progressPct = parseInt(res.progress || 0, 10);

  var body = (message ? '<div class="login-msg ok-msg">' + escapeHtml(message) + '</div>' : '');

  // سربرگ
  body += '<div class="dash-card" style="margin-bottom:18px;">' +
    '<div class="dash-card-head">' +
      '<span class="dash-card-title">مصوبه‌ی جلسه‌ی ' + escapeHtml(res.meetingNumber) + '</span>' +
      '<a class="mini-btn" target="_top" href="' +
        escapeHtml(scriptUrl + '?view=meetingDetail&number=' + encodeURIComponent(res.meetingNumber) + '&token=' + encodeURIComponent(token)) +
        '">← مشاهده جلسه</a>' +
    '</div>' +
    '<div class="dash-card-body">' +
      '<div class="dash-dept-row"><span>متن مصوبه</span>' +
        '<span style="white-space:pre-wrap;">' + escapeHtml(res.description || 'بدون شرح') + '</span></div>' +
      '<div class="dash-dept-row"><span>بخش</span><span>' + escapeHtml(res.department || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>مسئول</span><span>' + escapeHtml(res.assignedUser || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>وضعیت</span>' +
        '<span><span class="status-badge ' + resolutionStatusBadgeClass_(res.status) + '">' + escapeHtml(res.status) + '</span></span></div>' +
      '<div class="dash-dept-row"><span>پیشرفت</span>' +
        '<span>' + progressPct + '%' +
          '<div style="margin-top:4px;background:#e9edf2;border-radius:6px;height:6px;width:120px;overflow:hidden;display:inline-block;vertical-align:middle;margin-inline-start:8px;">' +
            '<div style="width:' + progressPct + '%;height:100%;background:' + CONFIG.ACCENT_COLOR + ';"></div>' +
          '</div>' +
        '</span></div>' +
      '<div class="dash-dept-row"><span>مهلت</span><span>' + escapeHtml(res.dueDate || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>تاریخ جلسه</span><span>' + escapeHtml(res.meetingDate || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>ثبت‌کننده</span><span>' + escapeHtml(res.createdBy) + ' · ' + escapeHtml(res.createdAt) + '</span></div>' +
    '</div>' +
  '</div>';

  // دکمه‌های workflow (تأیید / عودت / تکمیل)
  if (canManage && res.status !== CONFIG_EXT.ACTION_STATUS_CLOSED) {
    body += '<div class="dash-card" style="margin-bottom:18px;">' +
      '<div class="dash-card-head"><span class="dash-card-title">اقدامات گردش کار</span></div>' +
      '<div class="dash-card-body" style="display:flex;flex-wrap:wrap;gap:10px;">';

    // اعلام تکمیل (مسئول)
    if (res.status !== CONFIG_EXT.ACTION_STATUS_PENDING_APPROVAL) {
      body += '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top">' +
        '<input type="hidden" name="action" value="markResolutionCompleted">' +
        '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
        '<input type="hidden" name="resolutionId" value="' + escapeHtml(res.id) + '">' +
        '<input type="hidden" name="backView" value="resolutionDetail">' +
        '<button type="submit" style="background:#2d7a3a;color:#fff;border:none;border-radius:9px;padding:10px 20px;font-size:14px;cursor:pointer;">' +
          '✓ اعلام تکمیل — ارسال برای تأیید' +
        '</button>' +
      '</form>';
    }

    // تأیید و بستن (مدیر / ثبت‌کننده)
    if (canApprove && res.status === CONFIG_EXT.ACTION_STATUS_PENDING_APPROVAL) {
      body +=
        '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top">' +
          '<input type="hidden" name="action" value="approveResolution">' +
          '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
          '<input type="hidden" name="resolutionId" value="' + escapeHtml(res.id) + '">' +
          '<input type="hidden" name="backView" value="resolutionDetail">' +
          '<button type="submit" style="background:' + CONFIG.ACCENT_COLOR + ';color:#fff;border:none;border-radius:9px;padding:10px 20px;font-size:14px;cursor:pointer;">' +
            '✓ تأیید و بستن مصوبه' +
          '</button>' +
        '</form>' +
        '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" ' +
          'onsubmit="var n=prompt(\'دلیل عودت:\');if(!n)return false;this.querySelector(\'[name=reviewNote]\').value=n;">' +
          '<input type="hidden" name="action" value="returnResolutionForRevision">' +
          '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
          '<input type="hidden" name="resolutionId" value="' + escapeHtml(res.id) + '">' +
          '<input type="hidden" name="reviewNote" value="">' +
          '<input type="hidden" name="backView" value="resolutionDetail">' +
          '<button type="submit" class="mini-btn danger" style="padding:10px 16px;font-size:13px;">' +
            '↩ عودت برای اصلاح' +
          '</button>' +
        '</form>';
    }

    body += '</div></div>';
  }

  // به‌روزرسانی دستی وضعیت + مهلت با تقویم شمسی
  if (canManage && res.status !== CONFIG_EXT.ACTION_STATUS_CLOSED) {
    body += '<div class="dash-card" style="margin-bottom:18px;">' +
      '<div class="dash-card-head"><span class="dash-card-title">به‌روزرسانی پیشرفت / وضعیت</span></div>' +
      '<div class="dash-card-body">' +
      '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form">' +
        '<input type="hidden" name="action" value="updateResolutionStatus">' +
        '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' +
        '<input type="hidden" name="resolutionId" value="' + escapeHtml(res.id) + '">' +
        '<input type="hidden" name="meetingNumber" value="' + escapeHtml(res.meetingNumber) + '">' +
        '<input type="hidden" name="backView" value="resolutionDetail">' +
        '<select name="newStatus">' +
          CONFIG_EXT.ACTION_STATUSES.map(function(s){
            return '<option value="' + escapeHtml(s) + '"' + (s === res.status ? ' selected' : '') + '>' + escapeHtml(s) + '</option>';
          }).join('') +
        '</select>' +
        '<label style="font-size:12px;color:#5a6472;display:block;margin-bottom:2px;">پیشرفت (%)</label>' +
        '<input type="number" name="newProgress" min="0" max="100" value="' + escapeHtml(String(progressPct)) + '" placeholder="پیشرفت %">' +
        '<button type="submit">ثبت</button>' +
      '</form>' +
      '</div></div>';
  }

  // تاریخچه‌ی کامل اقدام مرتبط (پیوست، نظر، لاگ)
  body += '<div class="admin-title">تاریخچه‌ی کامل اقدام مرتبط' +
    (linkedAction ? ' — ' + escapeHtml(linkedAction.title) : '') + '</div>';
  if (linkedAction) {
    body += crossCuttingWidgetsHtml(scriptUrl, session, 'action', linkedAction.id, 'resolutionDetail', res.id);
  } else {
    body += '<div class="dash-empty">اقدام مرتبطی برای این مصوبه ثبت نشده است.</div>';
  }

  return HtmlService.createHtmlOutput(wrapPage(body, '', session, { activeView: 'resolutions' }))
    .setTitle('تاریخچه‌ی مصوبه').addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

// ======================================================================
// SECTION 8: فهرست مصوبات — نسخه ارتقاءیافته با نوار پیشرفت
// (تابع renderResolutionsListPageV2 جدید)
// ======================================================================
// برای فعال‌سازی در doGetInner:
//   if (view === 'resolutions') return renderResolutionsListPageV2(...)
function renderResolutionsListPageV2(session, message, filters) {
  var scriptUrl = ScriptApp.getService().getUrl();
  var token     = encodeURIComponent(session.__token || '');
  var resolutions = listResolutions(session, filters);

  var body = (message ? '<div class="login-msg ok-msg">' + escapeHtml(message) + '</div>' : '');
  body += advancedFilterBarHtml(scriptUrl, session, 'resolutions',
    { title: true, number: true, date: true, status: true, department: true, user: true }, filters);

  body += '<div class="admin-title">مصوبات جلسات (' + resolutions.length + ')' +
    '<a style="font-size:11px;font-weight:700;margin-inline-start:10px;" target="_top" ' +
      'href="' + escapeHtml(exportResolutionsQS_(scriptUrl, session.__token, filters)) + '">خروجی اکسل</a>' +
  '</div>';

  if (resolutions.length === 0) {
    body += '<div class="dash-empty">مصوبه‌ای یافت نشد.</div>';
  } else {
    body += '<div class="users-list">';
    resolutions.forEach(function(r) {
      var progressPct = parseInt(r.progress || 0, 10);
      body += '<div class="user-row" style="flex-wrap:wrap;">' +
        '<div class="user-main" style="flex:1;min-width:0;">' +
          '<div class="user-name">جلسه‌ی ' + escapeHtml(r.meetingNumber) + ': ' + escapeHtml(r.description || '') + '</div>' +
          '<div class="user-sub">' +
            '<span class="status-badge ' + resolutionStatusBadgeClass_(r.status) + '">' + escapeHtml(r.status) + '</span>' +
            ' · ' + escapeHtml(r.department || '—') +
            ' · ' + escapeHtml(r.assignedUser || '—') +
            (r.dueDate ? ' · مهلت: ' + escapeHtml(r.dueDate) : '') +
          '</div>' +
          '<div style="display:flex;align-items:center;gap:8px;margin-top:4px;">' +
            '<div style="flex:1;background:#e9edf2;border-radius:6px;height:5px;overflow:hidden;">' +
              '<div style="width:' + progressPct + '%;height:100%;background:' + CONFIG.ACCENT_COLOR + ';"></div>' +
            '</div>' +
            '<span style="font-size:11px;color:#5a6472;">' + progressPct + '%</span>' +
          '</div>' +
        '</div>' +
        '<div class="user-actions">' +
          '<a class="mini-btn" target="_top" href="' +
            escapeHtml(scriptUrl + '?view=resolutionDetail&id=' + encodeURIComponent(r.id) + '&token=' + token) +
            '">تاریخچه</a>' +
          '<a class="mini-btn" target="_top" href="' +
            escapeHtml(scriptUrl + '?view=meetingDetail&number=' + encodeURIComponent(r.meetingNumber) + '&token=' + token) +
            '">جلسه</a>' +
        '</div>' +
      '</div>';
    });
    body += '</div>';
  }

  return HtmlService.createHtmlOutput(wrapPage(body, '', session, { activeView: 'resolutions' }))
    .setTitle('مصوبات جلسات').addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

