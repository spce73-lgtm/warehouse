function qrLabelsScript(scriptUrl) {
  return (
    'function qlFilter(){' +
      'var q=document.getElementById("qlSearch").value.trim().toLowerCase();' +
      'document.querySelectorAll(".ql-row").forEach(function(r){' +
        'r.style.display=(!q||r.getAttribute("data-search").indexOf(q)!==-1)?"":"none";' +
      '});' +
    '}' +
    'function qlSelectAll(v){' +
      'document.querySelectorAll(".ql-row").forEach(function(r){' +
        'if(r.style.display==="none")return;' +
        'var c=r.querySelector(".ql-check");if(c)c.checked=v;' +
      '});' +
      'document.getElementById("qlHeadCheck").checked=v;' +
    '}' +
    'function qlGenerate(){' +
      'var checks=Array.prototype.slice.call(document.querySelectorAll(".ql-check:checked"));' +
      'if(!checks.length){alert("هیچ کالایی انتخاب نشده است.");return;}' +
      'if(typeof qrcode==="undefined"){alert("کتابخانه‌ی ساخت QR بارگذاری نشد. اتصال اینترنت را بررسی کنید.");return;}' +
      'var area=document.getElementById("qlPrintArea");' +
      'area.innerHTML="";' +
      'checks.forEach(function(c){' +
        'var code=c.value,name=c.getAttribute("data-name")||"";' +
        'var url=' + JSON.stringify(CONFIG.GITHUB_PAGES_BASE_URL) + '+"?id="+encodeURIComponent(code);' +
        'var qr=qrcode(0,"M");qr.addData(url);qr.make();' +
        'var cell=document.createElement("div");cell.className="ql-label";' +
        'var qrWrap=document.createElement("div");qrWrap.className="ql-qr";qrWrap.innerHTML=qr.createSvgTag({scalable:true});' +
        'var nameEl=document.createElement("div");nameEl.className="ql-name";nameEl.textContent=name||"(بدون نام)";' +
        'var codeEl=document.createElement("div");codeEl.className="ql-code";codeEl.textContent=code;' +
        'cell.appendChild(qrWrap);cell.appendChild(nameEl);cell.appendChild(codeEl);' +
        'area.appendChild(cell);' +
      '});' +
      'setTimeout(function(){window.print();},300);' +
    '}'
  );
}

function renderCountReportPage(session, filters, message) {
  filters = filters || {};
