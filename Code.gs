// ============ تاریخ شمسی (بدون نیاز به اینترنت، محاسبه‌ی محلی روی ساعت دقیق سرور) ============
function toJalali(date) {
  var gy = date.getFullYear();
  var gm = date.getMonth() + 1;
  var gd = date.getDate();
  var g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
  var jy;
  if (gy > 1600) { jy = 979; gy -= 1600; } else { jy = 0; gy -= 621; }
  var gy2 = (gm > 2) ? (gy + 1) : gy;
  var days = (365 * gy) + parseInt((gy2 + 3) / 4) - parseInt((gy2 + 99) / 100) + parseInt((gy2 + 399) / 400) - 80 + gd + g_d_m[gm - 1];
  jy += 33 * parseInt(days / 12053);
  days %= 12053;
  jy += 4 * parseInt(days / 1461);
  days %= 1461;
  if (days > 365) { jy += parseInt((days - 1) / 365); days = (days - 1) % 365; }
  var jm, jd;
  if (days < 186) { jm = 1 + parseInt(days / 31); jd = 1 + (days % 31); }
  else { jm = 7 + parseInt((days - 186) / 30); jd = 1 + ((days - 186) % 30); }
  return [jy, jm, jd];
}

function nowJalaliString() {
  var d = new Date();
  var j = toJalali(d);
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  var timeStr = Utilities.formatDate(d, Session.getScriptTimeZone(), 'HH:mm');
  return j[0] + '/' + pad(j[1]) + '/' + pad(j[2]) + ' ' + timeStr;
}

// گوگل‌شیت گاهی رشته‌ی تاریخ شمسی («۱۴۰۵/۰۴/۱۸ ۰۸:۱۷») را خودکار به یک سلول
// از نوع Date تبدیل می‌کند: چون رشته به‌شکل «سال/ماه/روز» است، گوگل‌شیت همان
// اعداد را عیناً به‌عنوان سال/ماه/روز میلادی ذخیره می‌کند (مثلاً سال ۱۴۰۵ میلادی).
// پس برای بازیابی، فقط کافی است همان اعداد را مستقیماً بخوانیم و هرگز دوباره
// به‌عنوان یک تاریخ میلادیِ واقعی از آن تبدیل شمسی نگیریم (وگرنه عدد سال باز هم
// یک‌بار دیگر جابه‌جا می‌شود، مثلاً ۱۴۰۵ به ۷۸۴).
function formatCellDate(value) {
  if (Object.prototype.toString.call(value) === '[object Date]') {
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    var y = value.getFullYear(), mo = value.getMonth() + 1, da = value.getDate();
    var hh = value.getHours(), mm = value.getMinutes();
    if (hh === 0 && mm === 0 && value.getSeconds() === 0) {
      return y + '/' + pad(mo) + '/' + pad(da);
    }
    return y + '/' + pad(mo) + '/' + pad(da) + ' ' + pad(hh) + ':' + pad(mm);
  }
  return value || '';
}

// مثل formatCellDate اما همیشه فقط تاریخ (بدون ساعت) برمی‌گرداند؛ برای فیلدهایی
// مثل «تاریخ یادآوری» که اصلاً ساعت ندارند.
function formatCellDateOnly(value) {
  if (Object.prototype.toString.call(value) === '[object Date]') {
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    return value.getFullYear() + '/' + pad(value.getMonth() + 1) + '/' + pad(value.getDate());
  }
  return value || '';
}

