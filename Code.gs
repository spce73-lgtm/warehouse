    ringLink(countReportUrl(scriptUrl, session.__token, filters, { csign: 'plus', cmis: '0' }), statRingWidget({ percent: 100, color: '#1a7f37', centerText: '', number: '+' + surplusSum, label: 'مجموع اضافه' })) +
    ringLink(countReportUrl(scriptUrl, session.__token, filters, { csign: 'minus', cmis: '0' }), statRingWidget({ percent: 100, color: '#c53030', centerText: '', number: shortageSum, label: 'مجموع کسری' })) +
