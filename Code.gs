// ----------------------------------------------------------------------
// SECTION 6: ارجاع مجدد مصوبه — مدیر بخش فقط داخل بخش خودش (تابع داده‌ای جدید)
// ----------------------------------------------------------------------
function assignResolution(session, id, department, assignedUser) {
  var found = findResolutionRow_(id);
  if (!found) throw new Error('مصوبه پیدا نشد.');
  var isPrivileged = isSystemAdmin(session) || isDeptManager(session);
  var isCurrentAssignee = found.obj.assignedUser === session.username;
  if (!isPrivileged && !isCurrentAssignee) throw new Error('شما اجازه‌ی ارجاع مصوبه را ندارید.');
  if (isDeptManager(session) && found.obj.department && found.obj.department !== getSessionDepartment(session)) {
    throw new Error('مدیر بخش فقط می‌تواند مصوبات بخش خودش را ارجاع دهد.');
  }
  if (isDeptManager(session) && department && department !== getSessionDepartment(session)) {
    throw new Error('مدیر بخش فقط می‌تواند به بخش خودش ارجاع دهد.');
  }
  var finalDepartment = department || found.obj.department;
  if (!isPrivileged && isCurrentAssignee) {
    // کارمندِ مسئولِ فعلی فقط می‌تواند این مصوبه را به همکاری در همان بخش خودش تفویض کند
    var myDept = getSessionDepartment(session);
    if (!myDept || finalDepartment !== myDept) {
      throw new Error('شما فقط می‌توانید این مصوبه را به همکاری در بخش خودتان ارجاع دهید.');
    }
    if (!assignedUser) throw new Error('کاربر مقصد را انتخاب کنید.');
    var targetUser_ = listUsersExtended().filter(function (u) { return u.username === assignedUser; })[0];
    if (!targetUser_ || targetUser_.department !== myDept) {
      throw new Error('کاربر مقصد باید همکارِ همان بخش شما باشد.');
    }
  }
  assertRecordEditable_(session, found.obj, isPrivileged || isCurrentAssignee);
  validateAssigneeInDept_(session, finalDepartment, assignedUser);
  var sh = getResolutionsSheet();
  sh.getRange(found.rowIndex, 4).setValue(finalDepartment || '');
  sh.getRange(found.rowIndex, 5).setValue(assignedUser || '');
  logActivity('meeting', found.obj.meetingNumber, 'ارجاع مصوبه', session.username, 'به ' + (assignedUser || finalDepartment || '—'));
  if (found.obj.linkedActionId) {
    try { assignAction(session, found.obj.linkedActionId, finalDepartment, assignedUser); } catch (e) { /* نادیده گرفته می‌شود */ }
  }
}

// حذف گروهی مصوبات — فقط مدیر سیستم؛ اقدام مرتبط هم حذف می‌شود تا داده یتیم نماند (نیازمندی ۱)
function deleteResolutions(session, ids) {
  if (!isSystemAdmin(session)) throw new Error('فقط مدیر سیستم می‌تواند حذف کند.');
  var n = 0;
  (ids || []).forEach(function (id) {
    var f = findResolutionRow_(id);
    if (!f) return;
    if (f.obj.linkedActionId) { var fa = findActionRow_(f.obj.linkedActionId); if (fa) getActionsSheet().deleteRow(fa.rowIndex); }
    getResolutionsSheet().deleteRow(f.rowIndex);
    logActivity('meeting', f.obj.meetingNumber, 'حذف مصوبه', session.username, 'مصوبه حذف شد.');
    n++;
  });
  return n;
}

// «ارسال و ارجاع» گروهی مصوبات — ارجاع + ثبت رسمی مصوبات انتخاب‌شده، هم‌گام با اقدام مرتبط
function submitAndAssignResolutions(session, ids, department, assignedUser) {
  if (!isSystemAdmin(session) && !isDeptManager(session)) throw new Error('فقط مدیر سیستم یا مدیر بخش می‌تواند ارسال و ارجاع کند.');
  var n = 0;
  (ids || []).forEach(function (id) {
    var found = findResolutionRow_(id);
    if (!found) return;
    assertRecordEditable_(session, found.obj, isSystemAdmin(session) || isDeptManager(session));
    validateAssigneeInDept_(session, department, assignedUser);
    var sh = getResolutionsSheet();
    if (department) sh.getRange(found.rowIndex, 4).setValue(department);
    if (assignedUser) sh.getRange(found.rowIndex, 5).setValue(assignedUser);
    sh.getRange(found.rowIndex, 13).setValue(CONFIG_EXT.PUB_STATUS_REGISTERED);
    logActivity('meeting', found.obj.meetingNumber, 'ارسال و ارجاع مصوبه', session.username, 'مصوبه ثبت رسمی شد.');
    if (found.obj.linkedActionId) {
      try { submitAndAssignActions(session, [found.obj.linkedActionId], department, assignedUser); } catch (e) { /* نادیده گرفته می‌شود */ }
    }
    n++;
  });
  return n;
}

