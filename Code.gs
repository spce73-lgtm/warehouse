        'f_desc': String(res.description || '').toLowerCase(), 's_desc': res.description || '',
        'f_user': String(assignedFullName || '').toLowerCase(), 's_user': assignedFullName,
        'f_creator': String(creatorFullName || '').toLowerCase(), 's_creator': creatorFullName,
        'f_status': res.status, 's_status': res.status,
        'f_progress': String(parseInt(res.progress || 0, 10) || 0), 's_progress': parseInt(res.progress || 0, 10) || 0,
