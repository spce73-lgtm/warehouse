// ============ ثبت شمارش (فقط با نشست معتبر) ============
// برای ویجت «انبارگردانی» داخل صفحه‌ی گزارش (جست‌وجو/اسکن + ثبت سریع شمارش)
function lookupItemForScan(token, code) {
  var session = getSession(token);
  if (!session) return { success: false, message: 'نشست منقضی شده؛ صفحه را رفرش کنید.' };
  code = String(code || '').trim();
  if (!code) return { success: false, message: 'کد خالی است.' };
  var built = buildItemData(code);
  if (built.error) return { success: false, message: 'کالایی با این کد پیدا نشد.' };
  return { success: true, code: built.code, name: built.name, systemQty: built.systemQty, warehouses: built.warehouses || [] };
}

function recordCount(token, id, physicalQty, note, warehouse) {
  var session = getSession(token);
  if (!session) throw new Error('نشست شما منقضی شده؛ صفحه را رفرش و دوباره وارد شوید.');

  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var itemsSheet = ss.getSheets()[0];
    var values = itemsSheet.getDataRange().getValues();
    var headers = values[0].map(function (h) { return String(h).trim(); });
    function findCol(keyword) { for (var i = 0; i < headers.length; i++) if (headers[i].indexOf(keyword) !== -1) return i; return -1; }
    var idCol = findCol('کد');
    var nameCol = findCol('نام کالا'); if (nameCol === -1) nameCol = findCol('نام');
    var qtyCol = findCol('تعداد');
    var whCol = findCol('نام انبار'); if (whCol === -1) whCol = findCol('کد انبار');
    if (idCol === -1) throw new Error('ستون کد کالا پیدا نشد.');

    var normalizedId = normalizePersianDigits_(String(id).trim());
    var matchingRows = [];
    for (var r = 1; r < values.length; r++) {
      if (normalizePersianDigits_(String(values[r][idCol]).trim()) === normalizedId) matchingRows.push(values[r]);
    }
    if (matchingRows.length === 0) throw new Error('کالا پیدا نشد.');

    var target;
    if (matchingRows.length === 1) {
      target = matchingRows[0];
    } else {
      // این کالا در چند انبار موجود است؛ باید مشخص شود کدام انبار شمارش می‌شود
      if (!warehouse) throw new Error('این کالا در چند انبار موجود است؛ لطفاً انبار مورد نظر را انتخاب کنید.');
      var whNormalized = String(warehouse).trim();
      var found = matchingRows.filter(function (row) {
        return whCol !== -1 && String(row[whCol] || '').trim() === whNormalized;
      });
      if (found.length === 0) throw new Error('انبار انتخاب‌شده برای این کالا پیدا نشد.');
      target = found[0];
    }

    var itemName = nameCol !== -1 ? target[nameCol] : '';
    var systemQty = qtyCol !== -1 ? target[qtyCol] : '';
    var itemWarehouse = whCol !== -1 ? String(target[whCol] || '').trim() : '';

    var physicalNum = Number(physicalQty);
    if (isNaN(physicalNum)) throw new Error('عدد موجودی فیزیکی معتبر نیست.');
    var sysNum = Number(systemQty);
    var diff = isNaN(sysNum) ? '' : (physicalNum - sysNum);

    var countSheet = getCountSheet();

    // قبل از ثبت شمارش جدید، شمارش(های) قبلیِ همین کالا (و همین انبار در صورت چندانباره بودن)
    // حذف می‌شوند تا فقط آخرین شمارش در آمار و گزارش‌ها لحاظ شود.
    var countData = countSheet.getDataRange().getValues();
    var rowsToDelete = [];
    for (var cr = 1; cr < countData.length; cr++) {
      var cRow = countData[cr];
      var cCode = normalizePersianDigits_(String(cRow[2] || '').trim());
      if (cCode !== normalizedId) continue;
      var cWarehouse = String(cRow[8] || '').trim();
      if (itemWarehouse) {
        if (cWarehouse === itemWarehouse) rowsToDelete.push(cr + 1); // شماره‌ی واقعی ردیف در شیت (۱-based)
      } else {
        // کالای تک‌انباره: هر شمارش قبلی این کد (صرف‌نظر از انبار) حذف می‌شود
        rowsToDelete.push(cr + 1);
      }
    }
    // حذف از پایین به بالا تا با جابه‌جایی شماره‌ی ردیف‌ها مشکلی پیش نیاید
    rowsToDelete.sort(function (a, b) { return b - a; }).forEach(function (rowNum) { countSheet.deleteRow(rowNum); });

    var now = nowJalaliString();
    countSheet.appendRow([now, session.username, id, itemName, systemQty, physicalNum, diff, note || '', itemWarehouse]);

    return { success: true, diff: diff };
  } finally {
    lock.releaseLock();
  }
}

// ============ دایره‌های آماری (Ring Chart) برای گزارش‌های حرفه‌ای ============
function svgRing(percent, color, centerText, trackColor) {
  var r = 40, C = 2 * Math.PI * r;
  var p = Math.max(0, Math.min(100, percent));
  var dash = (p / 100) * C;
  return '<svg viewBox="0 0 100 100" class="stat-ring-svg">' +
    '<circle cx="50" cy="50" r="' + r + '" fill="none" stroke="' + (trackColor || '#eef0f2') + '" stroke-width="10"/>' +
    '<circle cx="50" cy="50" r="' + r + '" fill="none" stroke="' + color + '" stroke-width="10" stroke-linecap="round" stroke-dasharray="' + dash.toFixed(1) + ' ' + C.toFixed(1) + '" transform="rotate(-90 50 50)"/>' +
    (centerText ? ('<text x="50" y="58" text-anchor="middle" font-size="24" font-weight="800" fill="' + color + '">' + escapeHtml(centerText) + '</text>') : '') +
  '</svg>';
}

function statRingWidget(opts) {
  // opts: {percent, color, centerText, number, label}
  return '<div class="stat-ring-box">' +
    svgRing(opts.percent, opts.color, opts.centerText) +
    '<div class="stat-ring-num" style="color:' + opts.color + ';">' + escapeHtml(String(opts.number)) + '</div>' +
    '<div class="stat-ring-label">' + escapeHtml(opts.label) + '</div>' +
  '</div>';
}

