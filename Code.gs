// ---------- کامپوننت مشترک: نوار جستجوی زمینه‌ای (Context Search) ----------
// یک کامپوننت واحد که در همه‌ی ماژول‌ها (کارتابل ورودی/ارسالی، وظایف، انبارگردانی،
// مدیریت کاربران) با همان پارامتر متنی هر صفحه دوباره استفاده می‌شود.
var CONTEXT_SEARCH_PLACEHOLDER = 'کلمه مورد نظر را جستجو کنید...';

function contextSearchBarHtml(scriptUrl, session, view, paramName, currentValue, extraHiddenHtml) {
  return (
    '<form method="GET" action="' + escapeHtml(scriptUrl) + '" target="_top" class="ctx-search-bar no-print">' +
      '<input type="hidden" name="view" value="' + escapeHtml(view) + '">' +
      '<input type="hidden" name="token" value="' + escapeHtml(session.__token || '') + '">' +
      (extraHiddenHtml || '') +
      '<input type="text" name="' + escapeHtml(paramName) + '" value="' + escapeHtml(currentValue || '') + '" placeholder="' + escapeHtml(CONTEXT_SEARCH_PLACEHOLDER) + '" class="ctx-search-input">' +
      '<button type="submit" class="ctx-search-btn" aria-label="جستجو">' + SEARCH_ICON_SVG + '</button>' +
    '</form>'
  );
}

// ---------- گارد سرورساید: مسیرهایی که داده‌ی انبار/کالا نشان می‌دهند فقط برای دارندگان پرچم «دسترسی انبار» ----------
// این تابع هیچ منطق موجودی (renderSearchPage/renderDetailPage/...) را تغییر نمی‌دهد؛
// فقط تصمیم می‌گیرد که با توجه به مجوز کاربر، کدام صفحه نمایش داده شود.
function guardWarehousePage(session, q, message, deniedFallback) {
  if (hasWarehouseAccess(session)) return null; // مجاز است؛ فراخواننده صفحه‌ی اصلی را رندر کند
  return deniedFallback || renderInboxPage(session, message || 'شما به بخش انبار دسترسی ندارید.', {});
}

// جایگزین امن برای فراخوانی‌های قبلیِ renderSearchPage به‌عنوان صفحه‌ی «دسترسی ندارید» —
// اگر کاربر اصلاً دسترسی انبار ندارد، به‌جای صفحه‌ی جستجوی کالا به کارتابل برمی‌گردد.
function denyAccessPage(session, q, message) {
  if (hasWarehouseAccess(session)) return renderSearchPage(q, session, message);
  return renderInboxPage(session, message, {});
}

function buildSidebar(session, scriptUrl, activeView) {
  var token = encodeURIComponent(session.__token || '');
  var counts = getBadgeCounts(session);

  function item(view, label, iconName, badgeCount) {
    var cls = 'sb-item' + (view === activeView ? ' active' : '');
    var href = scriptUrl + (view === 'search' ? ('?token=' + token) : ('?view=' + view + '&token=' + token));
    return '<a class="' + cls + '" target="_top" href="' + escapeHtml(href) + '">' +
      '<span class="sb-icon">' + sidebarIconSvg(iconName) + '</span>' +
      '<span class="sb-label">' + label + '</span>' +
      badgeSpan(badgeCount || 0) +
    '</a>';
  }

  // دسترسی‌ها — بر پایه‌ی همان منطق نقش/پرچم که در ماژول مدیریت کاربران ساخته شد
  var admin = isSystemAdmin(session);
  var warehouseOk = hasWarehouseAccess(session); // مدیر سیستم همیشه true؛ سایرین بر اساس پرچم «دسترسی انبار»

  var html = '<div class="sb-backdrop no-print" id="sbBackdrop" onclick="toggleSidebarMobile()"></div>';
  html += '<div class="app-sidebar no-print" id="appSidebar">';
  html += '<div class="sb-brand-mobile">' + escapeHtml(CONFIG_EXT.PORTAL_TITLE) + '</div>';
  html += '<a class="sb-compose" target="_top" href="' + escapeHtml(scriptUrl + '?view=compose&token=' + token) + '">' + sidebarIconSvg('compose') + '<span>پیام / کار جدید</span></a>';

  // ---- داشبورد (برای همه‌ی کاربران واردشده) ----
  html += '<div class="sb-group">';
  html += item('dashboard', 'داشبورد', 'dashboard');
  html += '</div>';

  // ---- گروه: کارتابل (برای همه کاربران واردشده) ----
  html += '<div class="sb-group-title">کارتابل</div>';
  html += '<div class="sb-group">';
  html += item('inbox', 'کارتابل ورودی', 'inbox', counts.inbox);
  html += item('sent', 'کارتابل ارسالی', 'sent');
  html += item('mytasks', 'وظایف شخصی من', 'tasks', counts.mytasks);
  html += item('trash', 'سطل زباله', 'trash');
  html += '</div>';

  // ---- گروه: اقدامات و جلسات (برای همه؛ محتوای هرکس فقط آیتم‌های مجازش را نشان می‌دهد) ----
  html += '<div class="sb-group-title">اقدامات و جلسات</div>';
  html += '<div class="sb-group">';
  html += item('actions', 'اقدامات', 'tasks');
  html += item('meetings', 'صورتجلسات', 'calendar');
  html += '</div>';

  // ---- گروه: انبار (فقط برای کاربرانی که پرچم «دسترسی انبار» دارند یا مدیر سیستم‌اند) ----
  if (warehouseOk) {
    html += '<div class="sb-group-title">انبار</div>';
    html += '<div class="sb-group">';
    html += item('search', 'جستجوی کالا', 'search');
    html += item('countReport', 'انبارگردانی', 'clipboard');
    html += item('shelves', 'قفسه‌ها', 'shelf');
    html += '</div>';
  }

  // ---- گروه: مدیریت سیستم (فقط مدیر سیستم) ----
  if (admin) {
    html += '<div class="sb-group-title">مدیریت سیستم</div>';
    html += '<div class="sb-group">';
    html += item('taskadmin', 'مدیریت ' + TASK_TYPE + 'ها', 'admin', counts.taskadmin);
    html += item('qrLabels', 'برچسب‌های QR', 'qrcode');
    html += item('importExcel', 'به‌روزرسانی موجودی', 'upload');
    html += item('userManagement', 'مدیریت کاربران و دسترسی‌ها', 'users'); // لینک تکراری قدیمی (admin) حذف شد
    html += '</div>';
  }

  html += '</div>';
  return html;
}

function buildAppTopbar(session, scriptUrl, currentQ) {
  var token = encodeURIComponent(session.__token || '');
  var logo = CONFIG.LOGO_URL ? toDirectImageLink(CONFIG.LOGO_URL) : '';
  var jalaliNow = nowJalaliString(); // مثل «۱۴۰۵/۰۴/۱۸ ۰۸:۱۷»
  var m = jalaliNow.match(/^(.*) (\d{2}):(\d{2})$/);
  var datePart = m ? m[1] : jalaliNow;
  var hh = m ? m[2] : '00';
  var mm = m ? m[3] : '00';
  var searchBox =
    '<form class="tb-search" method="GET" action="' + escapeHtml(scriptUrl) + '" target="_top">' +
      '<input type="hidden" name="token" value="' + escapeHtml(session.__token || '') + '">' +
      '<input type="text" name="q" value="' + escapeHtml(currentQ || '') + '" placeholder="جستجوی کد یا نام کالا...">' +
      '<button type="submit" class="tb-search-btn" aria-label="جستجو">' + SEARCH_ICON_SVG + '</button>' +
    '</form>';

  var reminders = getMyReminders(session);
  var remList = reminders.list.length
    ? reminders.list.map(function (r) {
        var link = r.href ? (scriptUrl + '?' + r.href + '&token=' + token) : '#';
        return '<div class="rem-item' + (r.due ? ' due' : '') + '">' +
