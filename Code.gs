      html += '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top">' +
        '<input type="hidden" name="action" value="approveResolution">' +
        '<input type="hidden" name="token" value="' + escapeHtml(token) + '">' + backFields +
        '<button type="submit" class="mini-btn" style="background:' + CONFIG.ACCENT_COLOR + ';color:#fff;">✓ تأیید و بستن</button>' +
      '</form>' +
      '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" onsubmit="var n=prompt(\'دلیل عودت:\');if(!n)return false;this.querySelector(\'[name=reviewNote]\').value=n;">' +
