function escapeHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

// ====================================================================
// ایمپورت اکسل راهکاران
// جریان کار:
//   ۱. مدیر فایل اکسل راهکاران را در شیت «ورود-راهکاران» پیست می‌کند
//   ۲. apiGetImportPreview: پیش‌نمایش تغییرات (اضافه/آپدیت/بدون تغییر)
//   ۳. apiConfirmImport:    اعمال واقعی تغییرات روی شیت اصلی
//
// ویژگی‌های کلیدی:
//   - ستون‌های «تصویر» و «عکس» هرگز بازنویسی نمی‌شوند
//   - کالاهای جدید (کد جدید) به شیت اصلی اضافه می‌شوند
//   - موجودی کالاهای موجود آپدیت می‌شود
//   - کالاهای قدیمی که در اکسل جدید نیستند دست‌نخورده می‌مانند
//   - بعد از ایمپورت موفق، کش پاک می‌شود تا اپ فوراً آپدیت شود
// ====================================================================

function apiGetImportPreview(token, callback) {
  try {
    var session = getSession(token);
    if (!session) return jsonOut({ success: false, message: 'نشست منقضی شده؛ دوباره وارد شوید.', needLogin: true }, callback);
    if (session.role !== 'مدیر') return jsonOut({ success: false, message: 'فقط کاربر با نقش مدیر می‌تواند ایمپورت انجام دهد.' }, callback);
    var result = buildImportPlan_();
    return jsonOut({ success: true, preview: result }, callback);
  } catch (err) {
    return jsonOut({ success: false, message: err.message }, callback);
  }
}

function apiConfirmImport(token, callback) {
  try {
    var session = getSession(token);
    if (!session) return jsonOut({ success: false, message: 'نشست منقضی شده؛ دوباره وارد شوید.', needLogin: true }, callback);
    if (session.role !== 'مدیر') return jsonOut({ success: false, message: 'فقط کاربر با نقش مدیر می‌تواند ایمپورت انجام دهد.' }, callback);

    var lock = LockService.getScriptLock();
    lock.waitLock(60000);
    try {
      var plan = buildImportPlan_();
      applyImportPlan_(plan);
      invalidateSheetCache_();
      return jsonOut({ success: true, message: 'ایمپورت با موفقیت انجام شد.', added: plan.toAdd.length, updated: plan.toUpdate.length, unchanged: plan.unchanged }, callback);
    } finally {
      lock.releaseLock();
    }
  } catch (err) {
    return jsonOut({ success: false, message: err.message }, callback);
  }
}

// ──────────────────────────────────────────────────────────────────
// مدیریت «کد انبار» ذخیره‌شده (برای فیلتر کردن فایل چندانباره راهکاران)
// ──────────────────────────────────────────────────────────────────
// ──────────────────────────────────────────────────────────────────
// آپلود فایل اکسل/CSV راهکاران و تبدیل به شیت موقت گوگل برای خواندن
// (شیت موقت تا زمان تأیید نهایی نگه داشته می‌شود، سپس حذف/انتقال به زباله می‌شود)
// نیازمند: فعال بودن سرویس پیشرفته «Drive API» در پروژه Apps Script
// (منوی Services → + → Drive API)
// ──────────────────────────────────────────────────────────────────
function handleRahkaranFileUpload_(blob) {
  var resource = {
    name: 'rahkaran-import-temp-' + new Date().getTime(),
    mimeType: MimeType.GOOGLE_SHEETS
  };
  var file;
  try {
    file = Drive.Files.create(resource, blob, { fields: 'id' });
  } catch (driveErr) {
    throw new Error(
      'خطا در تبدیل فایل. مطمئن شوید سرویس Drive API در Apps Script فعال است.\n' +
      '(Services ← + ← Drive API)\n\nجزئیات: ' + driveErr.message
    );
  }
  var tempFileId = file.id;
  var sheet = SpreadsheetApp.openById(tempFileId).getSheets()[0];
  var data = sheet.getDataRange().getValues();
  if (data.length < 2) {
    try { DriveApp.getFileById(tempFileId).setTrashed(true); } catch (e2) {}
    throw new Error('فایل آپلودشده خالی است یا فقط سرستون دارد.');
  }
  var headers = data[0].map(function (h) { return String(h).trim(); });
  var rows = data.slice(1);
  return { tempFileId: tempFileId, headers: headers, rows: rows };
}

/**
 * هسته‌ی مقایسه: کلید یکتا برای هر ردیف = ترکیب «کد کالا + انبار»
 * یعنی یک کالا می‌تواند همزمان در چند انبار مختلف با موجودی‌های جداگانه ثبت باشد.
 * @param {string[]} importHeaders سرستون‌های فایل ایمپورت (خروجی راهکاران)
 * @param {Array[]} importRows ردیف‌های داده (بدون سرستون)
 */
function buildImportPlanCore_(importHeaders, importRows) {
  var impIdCol   = findImportCol_(importHeaders, ['کد کالا', 'کد مالی', 'شناسه', 'کد']);
  var impNameCol = findImportCol_(importHeaders, ['نام کالا', 'عنوان کالا', 'شرح کالا', 'نام']);
  var impQtyCol  = findImportCol_(importHeaders, ['مانده خورده', 'تعداد موجودی', 'موجودی', 'مقدار', 'تعداد']);
  var impUnitCol = findImportCol_(importHeaders, ['واحد اندازه‌گیری', 'واحد شمارش', 'واحد']);
  var impCatCol  = findImportCol_(importHeaders, ['گروه کالا', 'دسته‌بندی', 'دسته']);
  var impTechCol = findImportCol_(importHeaders, ['TechnicalSpecification', 'مشخصات فنی']);
  var impWhCol   = findImportCol_(importHeaders, ['کد انبار', 'نام انبار']);

  if (impIdCol === -1) {
    throw new Error('ستون کد کالا در فایل ایمپورت پیدا نشد.\nسرستون‌های فایل: ' + importHeaders.join(' | ') + '\n\nباید یک ستون با کلمه «کد» در نامش وجود داشته باشد.');
  }
  if (impWhCol === -1) {
    throw new Error('ستون «کد انبار» در فایل ایمپورت پیدا نشد.\nسرستون‌های فایل: ' + importHeaders.join(' | '));
  }

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var mainSheet = ss.getSheets()[0];
  var mainData  = mainSheet.getDataRange().getValues();
  if (mainData.length < 1) throw new Error('شیت اصلی کالاها خالی است.');
  var mainHeaders = mainData[0].map(function (h) { return String(h).trim(); });

  var mainIdCol   = findImportCol_(mainHeaders, ['کد کالا', 'کد مالی', 'شناسه', 'کد']);
  var mainNameCol = findImportCol_(mainHeaders, ['نام کالا', 'عنوان کالا', 'شرح کالا', 'نام']);
  var mainQtyCol  = findImportCol_(mainHeaders, ['تعداد موجودی', 'موجودی', 'مقدار', 'تعداد']);
  var mainUnitCol = findImportCol_(mainHeaders, ['واحد اندازه‌گیری', 'واحد شمارش', 'واحد']);
  var mainCatCol  = findImportCol_(mainHeaders, ['گروه کالا', 'دسته‌بندی', 'دسته']);
  var mainTechCol = findImportCol_(mainHeaders, ['مشخصات فنی', 'TechnicalSpecification']);
  var mainWhCol   = findImportCol_(mainHeaders, ['نام انبار', 'کد انبار']);

  if (mainIdCol === -1) throw new Error('ستون کد کالا در شیت اصلی پیدا نشد.');
  if (mainWhCol === -1) {
    throw new Error(
      'ستون «نام انبار» در شیت اصلی («' + mainSheet.getName() + '») پیدا نشد.\n' +
      'سرستون‌های شیت اصلی: ' + mainHeaders.join(' | ') + '\n\n' +
      'برای پشتیبانی از چند انبار، یک ستون با عنوان «نام انبار» به سرستون شیت اصلی اضافه کنید.'
    );
  }

  var imageColIndices = [];
  var imageKeywords = CONFIG.IMAGE_COL_KEYWORDS || ['تصویر', 'عکس'];
  mainHeaders.forEach(function (h, i) {
    if (imageKeywords.some(function (kw) { return h.indexOf(kw) !== -1; })) imageColIndices.push(i);
  });

  // کلید ترکیبی: "کدکالا‖انبار"
  function makeKey(code, wh) { return String(code).trim() + '‖' + String(wh).trim(); }

  var keyToRowIdx = {};
  for (var r = 1; r < mainData.length; r++) {
    var code = String(mainData[r][mainIdCol] || '').trim();
    var wh   = String(mainData[r][mainWhCol] || '').trim();
    if (code) keyToRowIdx[makeKey(code, wh)] = r;
  }

  var toAdd = [], toUpdate = [], unchanged = 0;

  for (var i = 0; i < importRows.length; i++) {
    var iRow = importRows[i];
    var iCode = String(iRow[impIdCol] || '').trim();
    if (!iCode) continue;
    var iWh = String(iRow[impWhCol] || '').trim();
    if (!iWh) continue; // ردیف بدون انبار مشخص، رد می‌شود

    var iName = impNameCol !== -1 ? String(iRow[impNameCol] || '').trim() : '';
    var iQty  = impQtyCol  !== -1 ? iRow[impQtyCol]  : '';
    var iUnit = impUnitCol !== -1 ? String(iRow[impUnitCol] || '').trim() : '';
    var iCat  = impCatCol  !== -1 ? String(iRow[impCatCol]  || '').trim() : '';
    var iTech = impTechCol !== -1 ? String(iRow[impTechCol] || '').trim() : '';

    var key = makeKey(iCode, iWh);

    if (key in keyToRowIdx) {
      var mRow = mainData[keyToRowIdx[key]];
      var mName = mainNameCol !== -1 ? String(mRow[mainNameCol] || '').trim() : '';
      var mQty  = mainQtyCol  !== -1 ? mRow[mainQtyCol] : '';
      var qtyChanged  = String(iQty).trim() !== String(mQty).trim();
      var nameChanged = iName !== '' && iName !== mName;
      if (qtyChanged || nameChanged) {
        toUpdate.push({ code: iCode, warehouse: iWh, rowIdx: keyToRowIdx[key], oldName: mName, newName: iName, oldQty: mQty, newQty: iQty, unit: iUnit, category: iCat, tech: iTech });
      } else { unchanged++; }
    } else {
      toAdd.push({ code: iCode, warehouse: iWh, name: iName, qty: iQty, unit: iUnit, category: iCat, tech: iTech });
    }
  }

  return {
    toAdd: toAdd, toUpdate: toUpdate, unchanged: unchanged,
    _mainIdCol: mainIdCol, _mainNameCol: mainNameCol, _mainQtyCol: mainQtyCol,
    _mainUnitCol: mainUnitCol, _mainCatCol: mainCatCol, _mainTechCol: mainTechCol, _mainWhCol: mainWhCol,
    _mainHeaders: mainHeaders, _imageColIndices: imageColIndices
  };
}

/**
 * مسیر قدیمی (سازگاری با اپ موبایل): خواندن از شیت «ورود-راهکاران»
 */
function buildImportPlan_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var importSheet = ss.getSheetByName(CONFIG.IMPORT_SHEET_NAME);
  if (!importSheet) {
    throw new Error('شیت «' + CONFIG.IMPORT_SHEET_NAME + '» در این گوگل‌شیت پیدا نشد.\n\nیک شیت با همین نام دقیق بسازید و اکسل راهکاران را در آن پیست کنید، یا از آپلود مستقیم فایل در پنل وب استفاده کنید.');
  }
  var importRange = importSheet.getDataRange();
  if (importRange.getNumRows() < 2) throw new Error('شیت «' + CONFIG.IMPORT_SHEET_NAME + '» خالی است یا فقط یک ردیف هدر دارد.');
  var importData = importRange.getValues();
  var importHeaders = importData[0].map(function (h) { return String(h).trim(); });
  var importRows = importData.slice(1);

  return buildImportPlanCore_(importHeaders, importRows);
}

function applyImportPlan_(plan) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var mainSheet = ss.getSheets()[0];

  plan.toUpdate.forEach(function (item) {
    var sheetRow = item.rowIdx + 1;
    if (plan._mainNameCol !== -1 && item.newName !== '') mainSheet.getRange(sheetRow, plan._mainNameCol + 1).setValue(item.newName);
    if (plan._mainQtyCol  !== -1) mainSheet.getRange(sheetRow, plan._mainQtyCol  + 1).setValue(item.newQty);
    if (plan._mainUnitCol !== -1 && item.unit !== '') mainSheet.getRange(sheetRow, plan._mainUnitCol + 1).setValue(item.unit);
    if (plan._mainCatCol  !== -1 && item.category !== '') mainSheet.getRange(sheetRow, plan._mainCatCol  + 1).setValue(item.category);
    if (plan._mainTechCol !== -1 && item.tech !== '') mainSheet.getRange(sheetRow, plan._mainTechCol + 1).setValue(item.tech);
  });

  plan.toAdd.forEach(function (item) {
    var newRow = new Array(plan._mainHeaders.length).fill('');
    if (plan._mainIdCol   !== -1) newRow[plan._mainIdCol]   = item.code;
    if (plan._mainNameCol !== -1) newRow[plan._mainNameCol] = item.name;
    if (plan._mainQtyCol  !== -1) newRow[plan._mainQtyCol]  = item.qty;
    if (plan._mainUnitCol !== -1) newRow[plan._mainUnitCol] = item.unit;
    if (plan._mainCatCol  !== -1) newRow[plan._mainCatCol]  = item.category;
    if (plan._mainTechCol !== -1) newRow[plan._mainTechCol] = item.tech;
    if (plan._mainWhCol   !== -1) newRow[plan._mainWhCol]   = item.warehouse;
    mainSheet.appendRow(newRow);
  });
}

// ======================================================================
// ماژول: مدیریت کاربران و دسترسی‌ها (User Management & Permissions)
// همه‌ی موارد این بخش کاملاً افزودنی هستند:
// - هیچ شیت/ستون/تابع موجودی رنیم یا تغییر رفتار داده نشده است.
// - اسکنر گیت‌هاب، API های apiLogin/apiLookup/apiSearch/apiRecordCount/apiPublicItem،
//   ساختار شیت «کاربران» (۴ ستون قبلی)، و توابع createUser/listUsers/findUserRow/
//   setUserPassword/renameUser/deleteUser دقیقاً مثل قبل باقی مانده‌اند.
// - این ماژول فقط ۲ ستون جدید (بخش، دسترسی انبار) به انتهای شیت «کاربران»
//   اضافه می‌کند و یک شیت کاملاً جدید «دپارتمان‌ها» می‌سازد.
// ======================================================================

var CONFIG_EXT = {
  PORTAL_TITLE: 'سامانه اتوماسیون سازمانی', // عنوان خنثی سازمانی — جایگزین برندینگ انبار
  DEPARTMENTS_SHEET_NAME: 'دپارتمان‌ها',
  ROLE_ADMIN: 'مدیر',          // = مدیر سیستم (همان نقش فعلی، بدون تغییر معنا)
  ROLE_DEPT_MANAGER: 'مدیر بخش', // نقش جدید
  ROLE_EMPLOYEE: 'کارمند',
  USER_DEPT_COL: 5,   // ستون E در شیت «کاربران» (جدید)
  USER_WH_COL: 6,     // ستون F در شیت «کاربران» (جدید)
  ACTIONS_SHEET_NAME: 'اقدامات',
  MEETINGS_SHEET_NAME: 'صورتجلسات',
  RESOLUTIONS_SHEET_NAME: 'مصوبات جلسات',
  ATTACHMENTS_SHEET_NAME: 'پیوست‌ها',
  COMMENTS_SHEET_NAME: 'نظرات',
  ACTIVITY_LOG_SHEET_NAME: 'لاگ فعالیت‌ها',
  ACTION_PRIORITIES: ['کم', 'متوسط', 'زیاد', 'فوری'],
  ACTION_STATUSES: ['در انتظار', 'در حال انجام', 'در انتظار تأیید', 'بسته', 'متوقف'],
  ACTION_STATUS_CLOSED: 'بسته',
  ACTION_STATUS_PENDING_APPROVAL: 'در انتظار تأیید',
  ACTION_STATUS_IN_PROGRESS: 'در حال انجام',
  ACTION_SOURCES: ['کار', 'نامه وارده', 'نامه صادره', 'مصوبه جلسه', 'ارجاع مستقیم مدیر'],
  PUB_STATUS_DRAFT: 'پیش‌نویس',
  PUB_STATUS_REGISTERED: 'ثبت‌شده'
};

// ---------- شیت دپارتمان‌ها (کاملاً جدید) ----------
function getDepartmentsSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(CONFIG_EXT.DEPARTMENTS_SHEET_NAME);
  if (!sh) {
    sh = ss.insertSheet(CONFIG_EXT.DEPARTMENTS_SHEET_NAME);
    sh.appendRow(['نام بخش', 'مدیر بخش']);
  }
  return sh;
}

function listDepartments() {
  var sh = getDepartmentsSheet();
  var values = sh.getDataRange().getValues();
  var list = [];
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]).trim() === '') continue;
    list.push({ rowIndex: r + 1, name: values[r][0], manager: values[r][1] || '' });
  }
  return list;
}

function findDepartmentRow_(name) {
  var sh = getDepartmentsSheet();
  var values = sh.getDataRange().getValues();
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]).trim() === String(name || '').trim()) {
      return { rowIndex: r + 1, name: values[r][0], manager: values[r][1] || '' };
    }
  }
  return null;
}

function createDepartment(name, managerUsername) {
  name = String(name || '').trim();
  if (!name) throw new Error('نام بخش الزامی است.');
  if (findDepartmentRow_(name)) throw new Error('این بخش قبلاً وجود دارد.');
  getDepartmentsSheet().appendRow([name, managerUsername || '']);
}

function setDepartmentManager(name, managerUsername) {
  var d = findDepartmentRow_(name);
  if (!d) throw new Error('بخش پیدا نشد.');
  getDepartmentsSheet().getRange(d.rowIndex, 2).setValue(managerUsername || '');
}

function deleteDepartment(name) {
  var d = findDepartmentRow_(name);
  if (!d) return;
  getDepartmentsSheet().deleteRow(d.rowIndex);
}

// ---------- گسترش شیت «کاربران» (فقط افزودن ۲ ستون، بدون دست‌زدن به ستون‌های قبلی) ----------
function ensureUserExtColumns_() {
  var sh = getUsersSheet(); // تابع موجود، دست‌نخورده — فقط صدا زده می‌شود
  var header = sh.getRange(1, 1, 1, 6).getValues()[0];
  if (!header[4]) sh.getRange(1, 5).setValue('بخش');
  if (!header[5]) sh.getRange(1, 6).setValue('دسترسی انبار');
}

function getUserExt_(username) {
  ensureUserExtColumns_();
  var u = findUserRow(username); // تابع موجود، دست‌نخورده
  if (!u) return null;
  var row = getUsersSheet().getRange(u.rowIndex, 1, 1, 6).getValues()[0];
  return {
    rowIndex: u.rowIndex,
    username: u.username,
    fullName: u.fullName,
    role: u.role,
    department: row[4] || '',
    warehouseAccess: String(row[5] || '').trim() === 'بله'
  };
}

function listUsersExtended() {
  ensureUserExtColumns_();
  var values = getUsersSheet().getDataRange().getValues();
  var list = [];
  for (var r = 1; r < values.length; r++) {
    if (!values[r][0]) continue;
    list.push({
      username: values[r][0],
      fullName: values[r][2],
      role: values[r][3],
      department: values[r][4] || '',
      warehouseAccess: String(values[r][5] || '').trim() === 'بله'
    });
  }
  return list;
}

function setUserDepartment(username, department) {
  ensureUserExtColumns_();
  var u = findUserRow(username);
  if (!u) throw new Error('کاربر پیدا نشد.');
  getUsersSheet().getRange(u.rowIndex, CONFIG_EXT.USER_DEPT_COL).setValue(department || '');
}

function setUserWarehouseAccess(username, allowed) {
  ensureUserExtColumns_();
  var u = findUserRow(username);
  if (!u) throw new Error('کاربر پیدا نشد.');
  getUsersSheet().getRange(u.rowIndex, CONFIG_EXT.USER_WH_COL).setValue(allowed ? 'بله' : 'خیر');
}

function setUserRoleExt(username, role) {
  var allowed = [CONFIG_EXT.ROLE_ADMIN, CONFIG_EXT.ROLE_DEPT_MANAGER, CONFIG_EXT.ROLE_EMPLOYEE];
  if (allowed.indexOf(role) === -1) throw new Error('نقش نامعتبر است.');
  var u = findUserRow(username);
  if (!u) throw new Error('کاربر پیدا نشد.');
  getUsersSheet().getRange(u.rowIndex, 4).setValue(role);
}

// ایجاد کاربر با نقش سه‌سطحی + بخش + دسترسی انبار (کنار createUser قدیمی، جایگزین آن نیست)
function createUserExt(username, password, fullName, role, department, warehouseAccess) {
  username = String(username || '').trim();
  if (!username || !password) throw new Error('نام کاربری و رمز عبور الزامی است.');
  if (findUserRow(username)) throw new Error('این نام کاربری قبلاً وجود دارد.');
  var allowed = [CONFIG_EXT.ROLE_ADMIN, CONFIG_EXT.ROLE_DEPT_MANAGER, CONFIG_EXT.ROLE_EMPLOYEE];
  var finalRole = allowed.indexOf(role) !== -1 ? role : CONFIG_EXT.ROLE_EMPLOYEE;
  ensureUserExtColumns_();
  getUsersSheet().appendRow([username, hashPassword(password), fullName || '', finalRole, department || '', warehouseAccess ? 'بله' : 'خیر']);
}

// ---------- توابع کمکی دسترسی/نقش (منطق خالص، بدون اثر جانبی) ----------
function isSystemAdmin(session) { return !!session && session.role === CONFIG_EXT.ROLE_ADMIN; }
function isDeptManager(session) { return !!session && session.role === CONFIG_EXT.ROLE_DEPT_MANAGER; }
function isEmployeeRole(session) { return !!session && session.role === CONFIG_EXT.ROLE_EMPLOYEE; }

function getSessionDepartment(session) {
  if (!session) return '';
  var ext = getUserExt_(session.username);
  return ext ? ext.department : '';
}

// مدیر سیستم همیشه دسترسی انبار دارد (سازگار با رفتار امروز)؛ برای بقیه بر اساس پرچم است.
function hasWarehouseAccess(session) {
  if (!session) return false;
  if (isSystemAdmin(session)) return true;
  var ext = getUserExt_(session.username);
  return !!(ext && ext.warehouseAccess);
}

// ---------- گردش کار «پیش‌نویس / ثبت‌شده» — مشترک بین اقدامات و صورتجلسات/مصوبات ----------
// «پیش‌نویس» = فقط ایجادکننده (و مدیر سیستم) آن را می‌بیند و ویرایش می‌کند.
// «ثبت‌شده» = برای بخش/کاربرِ ارجاع‌شده قابل مشاهده می‌شود و طبق قوانین معمول نقش‌ها
// (مسئول/مدیر بخش/مدیر سیستم) قابل ویرایش است — هیچ قفل اضافه‌ای اعمال نمی‌شود.
function isRecordRegistered_(record) {
  // 'منتشر شده' برای سازگاری با داده‌های قدیمی‌ای که تحت نام‌گذاری قبلی ثبت شده‌اند نگه داشته شده.
  return !!record && (record.publicationStatus === CONFIG_EXT.PUB_STATUS_REGISTERED || record.publicationStatus === 'منتشر شده');
}
// baseAllowed: نتیجه‌ی همان قانونِ دسترسیِ قبلیِ ماژول (مثلاً canManageAction_)
function assertRecordEditable_(session, record, baseAllowed) {
  if (isSystemAdmin(session)) return;
  if (!isRecordRegistered_(record)) {
    if (record && record.createdBy === session.username) return; // ایجادکننده می‌تواند پیش‌نویس خودش را ویرایش کند
    throw new Error('این مورد هنوز پیش‌نویس است و فقط ایجادکننده یا مدیر سیستم می‌تواند آن را ویرایش کند.');
  }
  if (!baseAllowed) throw new Error('شما اجازه‌ی ویرایش این مورد را ندارید.');
}

// قفلِ ویرایشِ سطحِ جلسه (نیازمندی ۱): پیش از «ثبت رسمی» فقط ایجادکننده (یا مدیر سیستم) می‌تواند
// اطلاعات جلسه را ویرایش یا مصوبه‌ی جدید اضافه کند؛ پس از «ثبت رسمی»، این دو کار برای همه — even
// مدیر بخش — قفل می‌شود و فقط مدیر سیستم می‌تواند انجام دهد. (برخلاف مصوبات/اقدامات که پس از ثبت
// طبق قوانین معمولِ نقش‌ها قابل ویرایش می‌مانند؛ این قفل مخصوص خودِ جلسه است.)
function assertMeetingEditable_(session, meeting) {
  if (isSystemAdmin(session)) return;
  if (!isRecordRegistered_(meeting) && meeting.createdBy === session.username) return;
  if (!isRecordRegistered_(meeting)) {
    throw new Error('این صورتجلسه هنوز پیش‌نویس است و فقط ایجادکننده یا مدیر سیستم می‌تواند آن را ویرایش کند.');
  }
  throw new Error('این صورتجلسه ثبت رسمی شده و فقط مدیر سیستم می‌تواند اطلاعات آن را ویرایش یا مصوبه‌ی جدید اضافه کند.');
}

function canManageDepartment(session, deptName) {
  if (isSystemAdmin(session)) return true;
  if (isDeptManager(session)) return getSessionDepartment(session) === deptName;
  return false;
}

