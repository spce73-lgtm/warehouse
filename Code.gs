function simpleBarChart(counts) {
  var max = 0;
  Object.keys(counts).forEach(function (k) { if (counts[k] > max) max = counts[k]; });
  if (max === 0) max = 1;
  var html = '<div class="chart-box">';
  Object.keys(counts).forEach(function (k) {
    var pct = Math.round((counts[k] / max) * 100);
    html += '<div class="chart-row"><div class="chart-label">' + escapeHtml(k) + '</div>' +
      '<div class="chart-track"><div class="chart-fill" style="width:' + pct + '%"></div></div>' +
      '<div class="chart-value">' + counts[k] + '</div></div>';
  });
  html += '</div>';
  return html;
}

