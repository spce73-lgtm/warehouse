  var meetingsSelectable = isSystemAdmin(session) || isDeptManager(session);
  body += dataTableBootstrapScript_();
  body += dataTableHtml({
    id: 'meetingsTable',
    emptyMessage: 'صورتجلسه‌ای ثبت نشده.',
    selectable: meetingsSelectable,
    bulkToolbarHtml: meetingsSelectable ? bulkToolbarHtml_(scriptUrl, session, { tableId: 'meetingsTable', deleteAction: 'deleteMeetings', assignAction: 'registerMeetings', assignLabel: 'ثبت رسمی', showAssignFields: false, allDepts: allDepts, allUsers: allUsers }) : '',
    columns: [
      { key: 'number', label: 'شماره جلسه', sortable: true, filter: { type: 'text' } },
      { key: 'subject', label: 'موضوع جلسه', sortable: true, filter: { type: 'text' } },
      { key: 'date', label: 'تاریخ جلسه', sortable: true, filter: { type: 'text' } },
      { key: 'creator', label: 'ایجادکننده', sortable: true, filter: { type: 'text' } },
      { key: 'count', label: 'تعداد مصوبات', sortable: true, filter: { type: 'text' } },
      { key: 'progress', label: 'پیشرفت', sortable: true, filter: { type: 'text' } },
      { key: 'status', label: 'وضعیت', sortable: true, filter: { type: 'select', options: [{ value: 'باز', label: 'باز' }, { value: 'بسته', label: 'بسته' }, { value: 'بدون مصوبه', label: 'بدون مصوبه' }] } },
      { key: 'pub', label: 'وضعیت انتشار', sortable: true, filter: { type: 'select', options: [{ value: CONFIG_EXT.PUB_STATUS_DRAFT, label: CONFIG_EXT.PUB_STATUS_DRAFT }, { value: CONFIG_EXT.PUB_STATUS_REGISTERED, label: CONFIG_EXT.PUB_STATUS_REGISTERED }] } }
    ],
    rows: rows
  });

  if (expandMeetingNumber) {
    body += '<script>' +
      'setTimeout(function(){' +
        'var el=document.getElementById(' + JSON.stringify('mtg_' + safeId_(expandMeetingNumber) + '_row') + ');' +
        'if(el)el.scrollIntoView({block:"center",behavior:"smooth"});' +
