        (item.warehouse ? ' · انبار: ' + escapeHtml(String(item.warehouse)) : '') +
        (item.qty !== '' ? ' · موجودی: ' + escapeHtml(String(item.qty)) : '') + '</div>' +
      '</div></div>';
    });
    html += '</div>';
    if (plan.toAdd.length > 10) html += '<div class="login-sub">و ' + (plan.toAdd.length - 10) + ' مورد دیگر...</div>';
  }

  if (plan.toUpdate.length > 0) {
    html += '<div class="admin-title">نمونه آپدیت موجودی (حداکثر ۱۰ مورد)</div><div class="users-list">';
    plan.toUpdate.slice(0, 10).forEach(function (item) {
      html += '<div class="user-row"><div class="user-main">' +
        '<div class="user-name">' + escapeHtml(item.newName || item.oldName) + '</div>' +
        '<div class="user-sub">کد: ' + escapeHtml(String(item.code)) +
        (item.warehouse ? ' · انبار: ' + escapeHtml(String(item.warehouse)) : '') +
        ' · ' + escapeHtml(String(item.oldQty)) + ' ← ' + escapeHtml(String(item.newQty)) + '</div>' +
      '</div></div>';
    });
    html += '</div>';
    if (plan.toUpdate.length > 10) html += '<div class="login-sub">و ' + (plan.toUpdate.length - 10) + ' مورد دیگر...</div>';
  }

  if (plan.toAdd.length === 0 && plan.toUpdate.length === 0) {
    html += '<div class="login-msg">هیچ تغییری شناسایی نشد.</div>';
  } else {
    html +=
      '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" onsubmit="return confirm(\'آیا از اعمال این تغییرات مطمئن هستید؟\');">' +
