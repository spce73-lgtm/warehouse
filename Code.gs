    selectable: resSelectable,
    bulkToolbarHtml: resSelectable ? bulkToolbarHtml_(scriptUrl, session, { tableId: resTableId, deleteAction: 'deleteResolutions', assignAction: 'submitAndAssignResolutions', assignLabel: 'ارسال و ارجاع', extraHiddenHtml: extraHidden, allDepts: allDepts, allUsers: allUsers }) : '',
    columns: [
      { key: 'desc', label: 'شرح مصوبه', sortable: true, filter: { type: 'text' } },
      { key: 'meetingnum', label: 'شماره جلسه', sortable: false },
