function renderMeetingDetailPage(session, meetingNumber, message) {
  var scriptUrl = ScriptApp.getService().getUrl();
  var meeting = getMeetingByNumber(meetingNumber);
  if (!meeting) return renderMeetingsListPage(session, 'جلسه پیدا نشد.', {});
  var canCreate = isSystemAdmin(session) || isDeptManager(session);
  var resolutions = listResolutionsForMeeting(meetingNumber).filter(function (r) { return canViewResolution_(session, r); });
  var body = (message ? '<div class="login-msg ok-msg">' + escapeHtml(message) + '</div>' : '');
  body += '<div class="admin-title">جلسه‌ی ' + escapeHtml(meeting.number) + ' — ' + escapeHtml(meeting.subject || '') + '</div>';
  body += '<div class="hint-note" style="text-align:right;">تاریخ: ' + escapeHtml(meeting.date || '—') + ' | حاضرین: ' + escapeHtml(meeting.attendees || '—') + '</div>';

  body += '<div class="admin-title">مصوبات این جلسه (' + resolutions.length + ')</div>';
  if (canCreate) {
    var depts = isDeptManager(session) ? listDepartments().filter(function (d) { return d.name === getSessionDepartment(session); }) : listDepartments();
    var users = isDeptManager(session) ? listUsersExtended().filter(function (u) { return u.department === getSessionDepartment(session); }) : listUsersExtended();
    body += '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form">' +
      '<input type="hidden" name="action" value="createResolution">' +
      '<input type="hidden" name="token" value="' + escapeHtml(session.__token) + '">' +
      '<input type="hidden" name="meetingNumber" value="' + escapeHtml(meetingNumber) + '">' +
      '<input type="text" name="description" placeholder="متن مصوبه" required>' +
      '<select name="department"><option value="">— بدون بخش —</option>' + depts.map(function (d) { return '<option value="' + escapeHtml(d.name) + '">' + escapeHtml(d.name) + '</option>'; }).join('') + '</select>' +
      '<select name="assignedUser"><option value="">— ارجاع‌نشده —</option>' + users.map(function (u) { return '<option value="' + escapeHtml(u.username) + '">' + escapeHtml(u.fullName || u.username) + '</option>'; }).join('') + '</select>' +
      '<input type="text" name="dueDate" placeholder="مهلت (1405/05/10)">' +
      '<button type="submit">افزودن مصوبه</button>' +
    '</form>';
  }
