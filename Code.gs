}
function getPersonalTasksSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(CONFIG.PERSONAL_TASKS_SHEET_NAME);
  if (!sh) {
    sh = ss.insertSheet(CONFIG.PERSONAL_TASKS_SHEET_NAME);
    sh.appendRow(['شناسه', 'کاربر', 'متن', 'وضعیت', 'تاریخ ایجاد', 'تاریخ بستن']);
    sh.getRange(2, 5, 2000, 2).setNumberFormat('@');
  }
  return sh;
}
function getRemindersSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName('یادآوری‌ها');
  if (!sh) {
    sh = ss.insertSheet('یادآوری‌ها');
    sh.appendRow(['شناسه', 'کاربر', 'شناسه مورد', 'نوع مورد', 'تاریخ یادآوری', 'تاریخ ثبت']);
    sh.getRange(2, 5, 2000, 2).setNumberFormat('@');
  }
  return sh;
}

function createInboxItem(type, sender, recipient, subject, body, category) {
  if (!recipient) throw new Error('گیرنده مشخص نشده.');
  if (type === TASK_TYPE) {
    var senderUser = findUserRow(sender);
    if (!senderUser || senderUser.role !== 'مدیر') {
      throw new Error('تعریف «کار» فقط توسط مدیر سیستم مجاز است.');
    }
  }
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var sh = getInboxSheet();
    var id = Utilities.getUuid();
    var status = (type === TASK_TYPE) ? 'در انتظار اقدام' : 'خوانده‌نشده';
    sh.appendRow([id, type, sender, recipient, subject || '', body || '', status, nowJalaliString(), '', '', category || '', 'خیر', 'خیر']);
    return id;
  } finally {
    lock.releaseLock();
  }
}

function getInboxValues() {
  return getInboxSheet().getDataRange().getValues();
}

function rowToInboxObj(row) {
  return {
    id: row[0], type: row[1], sender: row[2], recipient: row[3],
    subject: row[4], body: row[5], status: row[6],
    createdAt: formatCellDate(row[7]), closedAt: formatCellDate(row[8]), closedBy: row[9], category: row[10] || '',
    delRecipient: row[11] === 'بله', delSender: row[12] === 'بله'
  };
}

function matchesFilter(it, filters) {
  if (filters.category && it.category !== filters.category) return false;
  if (filters.recipient && it.recipient !== filters.recipient) return false;
  if (filters.kq) {
    var needle = filters.kq.toLowerCase();
    var hay = (it.subject + ' ' + it.body + ' ' + it.sender + ' ' + it.recipient + ' ' + it.category).toLowerCase();
    if (hay.indexOf(needle) === -1) return false;
  }
  return true;
}

function listInbox(username, filters) {
  var values = getInboxValues();
  var out = [];
  for (var r = values.length - 1; r >= 1; r--) {
    if (String(values[r][3]).trim() === username && values[r][11] !== 'بله') {
      var obj = rowToInboxObj(values[r]);
      if (matchesFilter(obj, filters || {})) {
        out.push(obj);
        if (out.length >= CONFIG.MAX_LIST_ROWS) break;
      }
    }
  }
  return out;
}

function listSent(username, filters) {
  var values = getInboxValues();
  var out = [];
  for (var r = values.length - 1; r >= 1; r--) {
    if (String(values[r][2]).trim() === username && values[r][12] !== 'بله') {
      var obj = rowToInboxObj(values[r]);
      if (matchesFilter(obj, filters || {})) {
        out.push(obj);
        if (out.length >= CONFIG.MAX_LIST_ROWS) break;
      }
    }
  }
  return out;
}

function listTrash(username) {
  var values = getInboxValues();
  var out = [];
  for (var r = values.length - 1; r >= 1; r--) {
    var row = values[r];
    var recipient = String(row[3]).trim(), sender = String(row[2]).trim();
    var inRecipientTrash = recipient === username && row[11] === 'بله';
    var inSenderTrash = sender === username && row[12] === 'بله';
    if (inRecipientTrash || inSenderTrash) {
      var obj = rowToInboxObj(values[r]);
      obj.trashSide = inRecipientTrash ? 'recipient' : 'sender';
      out.push(obj);
    }
  }
  return out;
}

// فقط پیام‌ها (نه کارهایی که مدیر تعریف کرده) و فقط از دیدِ خودِ فرستنده/گیرنده قابل انتقال به سطل زباله‌اند
function trashInboxItems(session, itemIds) {
  var sh = getInboxSheet();
  var values = sh.getDataRange().getValues();
  var moved = 0, blocked = 0;
  itemIds.forEach(function (id) {
    for (var r = 1; r < values.length; r++) {
      if (String(values[r][0]) === String(id)) {
        var type = values[r][1];
        var recipient = String(values[r][3]).trim(), sender = String(values[r][2]).trim();
        if (type === TASK_TYPE) { blocked++; return; }
        if (recipient === session.username) sh.getRange(r + 1, 12).setValue('بله');
        if (sender === session.username) sh.getRange(r + 1, 13).setValue('بله');
        if (recipient === session.username || sender === session.username) moved++;
        return;
      }
    }
  });
  return { moved: moved, blocked: blocked };
}

function restoreTrashItem(session, id) {
  var sh = getInboxSheet();
  var values = sh.getDataRange().getValues();
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]) === String(id)) {
      if (String(values[r][3]).trim() === session.username) sh.getRange(r + 1, 12).setValue('خیر');
      if (String(values[r][2]).trim() === session.username) sh.getRange(r + 1, 13).setValue('خیر');
      return;
    }
  }
}

function permanentDeleteTrashItem(session, id) {
  var found = getInboxItemById(id);
  if (!found) return;
  var isOwner = found.obj.recipient === session.username || found.obj.sender === session.username;
  if (!isOwner) throw new Error('دسترسی ندارید.');
  if (found.obj.type === TASK_TYPE) throw new Error('حذف همیشگیِ «' + TASK_TYPE + '» فقط توسط مدیر از صفحه جزئیات مجاز است.');
  deleteInboxItem(id);
}

function listAllTasks(filters) {
  var values = getInboxValues();
  var out = [];
  for (var r = values.length - 1; r >= 1; r--) {
    if (String(values[r][1]).trim() === TASK_TYPE) {
      var obj = rowToInboxObj(values[r]);
      if (matchesFilter(obj, filters || {})) out.push(obj);
    }
  }
  return out;
}

function getInboxItemById(id) {
  var values = getInboxValues();
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][0]) === String(id)) return { rowIndex: r + 1, obj: rowToInboxObj(values[r]) };
  }
  return null;
}

function markInboxRead(id) {
  var found = getInboxItemById(id);
  if (!found) return;
  if (found.obj.type === 'پیام' && found.obj.status === 'خوانده‌نشده') {
    getInboxSheet().getRange(found.rowIndex, 7).setValue('خوانده‌شده');
  }
}

function closeInboxTask(id, closerUsername) {
  var found = getInboxItemById(id);
  if (!found) throw new Error('مورد پیدا نشد.');
  var sh = getInboxSheet();
  sh.getRange(found.rowIndex, 7).setValue('بسته‌شده');
  sh.getRange(found.rowIndex, 9).setValue(nowJalaliString());
  sh.getRange(found.rowIndex, 10).setValue(closerUsername);
}

function deleteInboxItem(id) {
  var found = getInboxItemById(id);
  if (!found) return;
  getInboxSheet().deleteRow(found.rowIndex);
  // پاک‌کردن اقدامات مرتبط
  var sh = getTaskActionsSheet();
  var values = sh.getDataRange().getValues();
  for (var r = values.length - 1; r >= 1; r--) {
    if (String(values[r][1]) === String(id)) sh.deleteRow(r + 1);
  }
}

function addTaskAction(inboxId, username, text) {
  if (!text || !text.trim()) throw new Error('متن اقدام خالی است.');
  var sh = getTaskActionsSheet();
  sh.appendRow([Utilities.getUuid(), inboxId, username, text, nowJalaliString()]);
  var found = getInboxItemById(inboxId);
  if (found && found.obj.status === 'در انتظار اقدام') {
    getInboxSheet().getRange(found.rowIndex, 7).setValue('در حال انجام');
  }
}

function listTaskActions(inboxId) {
  var values = getTaskActionsSheet().getDataRange().getValues();
  var out = [];
  for (var r = 1; r < values.length; r++) {
    if (String(values[r][1]) === String(inboxId)) {
      out.push({ username: values[r][2], text: values[r][3], date: formatCellDate(values[r][4]) });
    }
  }
  return out;
}

// ============ وظایف شخصی ============
function createPersonalTask(username, text) {
  if (!text || !text.trim()) throw new Error('متن وظیفه خالی است.');
  var sh = getPersonalTasksSheet();
  sh.appendRow([Utilities.getUuid(), username, text, 'باز', nowJalaliString(), '']);
}

function listPersonalTasks(username) {
  var values = getPersonalTasksSheet().getDataRange().getValues();
  var out = [];
  for (var r = values.length - 1; r >= 1; r--) {
    if (String(values[r][1]).trim() === username) {
      out.push({ id: values[r][0], text: values[r][2], status: values[r][3], createdAt: formatCellDate(values[r][4]), closedAt: formatCellDate(values[r][5]) });
