      '<div class="dash-dept-row"><span>وضعیت</span><span>' + escapeHtml(res.status) + '</span></div>' +
      '<div class="dash-dept-row"><span>پیشرفت</span><span>' + escapeHtml(String(res.progress)) + '%</span></div>' +
      '<div class="dash-dept-row"><span>مهلت</span><span>' + escapeHtml(res.dueDate || '—') + '</span></div>' +
      '<div class="dash-dept-row"><span>ثبت‌کننده</span><span>' + escapeHtml(res.createdBy) + ' · ' + escapeHtml(res.createdAt) + '</span></div>',
      scriptUrl + '?view=meetingDetail&number=' + encodeURIComponent(res.meetingNumber) + '&token=' + encodeURIComponent(session.__token), 'مشاهده جلسه') +
    '</div>';

  if (canManage) {
    body += '<div class="admin-title">به‌روزرسانی وضعیت</div>';
    body += '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="new-user-form">' +
      '<input type="hidden" name="action" value="updateResolutionStatus">' +
      '<input type="hidden" name="token" value="' + escapeHtml(session.__token) + '">' +
      '<input type="hidden" name="resolutionId" value="' + escapeHtml(res.id) + '">' +
      '<input type="hidden" name="meetingNumber" value="' + escapeHtml(res.meetingNumber) + '">' +
      '<input type="hidden" name="backView" value="resolutionDetail">' +
      '<select name="newStatus">' + CONFIG_EXT.ACTION_STATUSES.map(function (s) { return '<option value="' + escapeHtml(s) + '"' + (s === res.status ? ' selected' : '') + '>' + escapeHtml(s) + '</option>'; }).join('') + '</select>' +
      '<input type="number" name="newProgress" min="0" max="100" value="' + escapeHtml(String(res.progress || 0)) + '" placeholder="پیشرفت %">' +
      '<button type="submit">ثبت</button>' +
    '</form>';
  }

  // «تاریخچه‌ی کامل اقدام» — چون هر مصوبه هنگام ثبت یک اقدام مرتبط می‌سازد و هر تغییر وضعیت
  // با آن همگام می‌شود، لاگ فعالیت/نظرات/پیوست‌های همان اقدام = تاریخچه‌ی کامل مصوبه است.
  body += '<div class="admin-title">تاریخچه‌ی کامل اقدام مرتبط' + (linkedAction ? ' — ' + escapeHtml(linkedAction.title) : '') + '</div>';
  if (linkedAction) {
    body += crossCuttingWidgetsHtml(scriptUrl, session, 'action', linkedAction.id, 'resolutionDetail', res.id);
  } else {
    body += '<div class="dash-empty">اقدام مرتبطی برای این مصوبه ثبت نشده است.</div>';
  }

  return HtmlService.createHtmlOutput(wrapPage(body, '', session, { activeView: 'resolutions' })).setTitle('تاریخچه‌ی مصوبه').addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

