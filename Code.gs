      '<div class="modal-box">' +
        '<div id="cwLoading" class="lookup-loading" style="display:none;"><div class="spinner"></div> در حال جستجوی کالا...</div>' +
        '<div id="cwResult" style="display:none;">' +
          '<div class="modal-item-name" id="cwItemName">—</div>' +
          '<div class="modal-item-code" id="cwItemCode">—</div>' +
          '<div class="sys-qty-badge">موجودی سیستم: <b id="cwSysQty">—</b></div>' +
          '<div id="cwWarehouseWrap" style="display:none;margin-bottom:10px;">' +
            '<label class="count-label">انتخاب انبار</label>' +
            '<select id="cwWarehouseSelect" class="cw-wh-select"></select>' +
          '</div>' +
          '<div class="qty-row">' +
            '<button type="button" class="qty-step" onclick="cwStepQty(-1)">−</button>' +
