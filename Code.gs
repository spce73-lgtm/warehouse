        'errBox.style.display="block";errBox.textContent="دسترسی به دوربین در این صفحه ممکن نیست. از قسمت بالا کد را دستی وارد کنید.";return;' +
      '}' +
      'if(!cwHtml5Qrcode)cwHtml5Qrcode=new Html5Qrcode("cwReader",false);' +
      'if(cwCameraRunning)return;' +
      'var config={fps:12,qrbox:function(w,h){var s=Math.floor(Math.min(w,360)*0.75);return {width:s,height:Math.floor(s*0.55)};}};' +
      'cwHtml5Qrcode.start({facingMode:"environment"},config,cwOnScan,function(){}).then(function(){cwCameraRunning=true;})' +
      '.catch(function(err){' +
        'cwHtml5Qrcode.start({facingMode:"user"},config,cwOnScan,function(){}).then(function(){cwCameraRunning=true;})' +
        '.catch(function(err2){' +
          'var name=(err2&&(err2.name||err2.message))||"";' +
          'var msg="دسترسی به دوربین ممکن نشد.";' +
          'if(/NotAllowedError|Permission/i.test(name))msg="اجازه‌ی دوربین داده نشده یا توسط تنظیمات این صفحه مسدود شده است. از نسخه‌ی موبایل مستقل استفاده کنید یا کد را دستی وارد کنید.";' +
          'if(/NotFoundError/i.test(name))msg="دوربینی پیدا نشد.";' +
          'errBox.style.display="block";errBox.textContent=msg;' +
        '});' +
      '});' +
    '}' +
    'function cwStopScanner(){if(cwHtml5Qrcode&&cwCameraRunning){cwHtml5Qrcode.stop().then(function(){cwCameraRunning=false;}).catch(function(){cwCameraRunning=false;});}}' +
    'function cwOnScan(text){' +
      'var now=Date.now();if(text===cwLastCode&&(now-cwLastAt)<2500)return;cwLastCode=text;cwLastAt=now;' +
      'if(navigator.vibrate)try{navigator.vibrate(50);}catch(e){}' +
      'cwOpen(text);' +
    '}' +
    'function cwLookup(){' +
      'var code=document.getElementById("cwCode").value.trim();' +
      'if(!code)return;' +
      'cwOpen(code);' +
    '}' +
    'document.getElementById("cwCode").addEventListener("keydown",function(ev){if(ev.key==="Enter")cwLookup();});' +
    'var cwCurCode=null;' +
    'function cwOpen(code){' +
      'cwCurCode=code;' +
      'document.getElementById("cwOverlay").classList.add("open");' +
      'document.getElementById("cwLoading").style.display="flex";' +
      'document.getElementById("cwResult").style.display="none";' +
      'document.getElementById("cwError").style.display="none";' +
      'google.script.run.withSuccessHandler(function(res){' +
        'document.getElementById("cwLoading").style.display="none";' +
        'if(!res.success){' +
          'document.getElementById("cwError").style.display="block";' +
          'document.getElementById("cwErrorMsg").textContent=res.message||"کالا پیدا نشد.";' +
          'return;' +
