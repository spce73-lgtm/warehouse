      '</form>';
  }

  return html;
}

/**
 * فراخوانی سمت سرور از طریق google.script.run — فایل را می‌گیرد، تبدیل و مقایسه می‌کند
 * و فقط قطعه‌ی HTML نتیجه را برمی‌گرداند (نه کل صفحه)
 */
function serverHandleRahkaranUpload(base64Data, filename, mimeType, token) {
  var session = getSession(token);
  if (!session) throw new Error('نشست منقضی شده؛ صفحه را رفرش کرده و دوباره وارد شوید.');
  if (session.role !== 'مدیر') throw new Error('شما دسترسی مدیریتی ندارید.');
  if (!base64Data) throw new Error('فایلی دریافت نشد. لطفاً یک فایل اکسل (xlsx/xls/csv) انتخاب کنید.');

  var bytes = Utilities.base64Decode(base64Data);
  var blob = Utilities.newBlob(bytes, mimeType || 'application/octet-stream', filename || 'rahkaran-upload');
  var uploaded = handleRahkaranFileUpload_(blob);
  var plan = buildImportPlanCore_(uploaded.headers, uploaded.rows);
  var scriptUrl = ScriptApp.getService().getUrl();
  return renderImportPlanFragment_(plan, uploaded.tempFileId, token, scriptUrl);
}

