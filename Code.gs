function exportTasksCSV() {
  var tasks = listAllTasks({});
  var rows = [['موضوع', 'دسته', 'فرستنده', 'گیرنده', 'وضعیت', 'تاریخ ایجاد', 'تاریخ بستن', 'بسته‌شده توسط', 'متن']];
  tasks.forEach(function (it) {
    rows.push([it.subject, it.category, it.sender, it.recipient, it.status, it.createdAt, it.closedAt, it.closedBy, it.body]);
  });
  var csv = rows.map(function (row) {
    return row.map(function (cell) {
      var s = String(cell == null ? '' : cell).replace(/"/g, '""');
      return '"' + s + '"';
    }).join(',');
  }).join('\r\n');
  // BOM برای نمایش درست حروف فارسی در اکسل
  return ContentService.createTextOutput('\uFEFF' + csv).setMimeType(ContentService.MimeType.CSV);
}

// ============ گزارش شمارش‌های انبارگردانی ============
function listCountRecords(filters) {
  filters = filters || {};
  var values = getCountSheet().getDataRange().getValues();
  var out = [];
  for (var r = values.length - 1; r >= 1; r--) {
    var row = values[r];
    if (!row[2]) continue; // ردیف خالی
    var rec = {
      rowIndex: r + 1, date: formatCellDate(row[0]), username: row[1], itemCode: row[2], itemName: row[3],
      systemQty: row[4], physicalQty: row[5], diff: row[6], note: row[7] || '', warehouse: row[8] || ''
    };
    if (filters.username && rec.username !== filters.username) continue;
    if (filters.dateQuery && String(rec.date).indexOf(filters.dateQuery.trim()) === -1) continue;
    if (filters.itemQuery) {
      var q = filters.itemQuery.trim();
      var hit = String(rec.itemCode).indexOf(q) !== -1 || String(rec.itemName).indexOf(q) !== -1;
      if (!hit) continue;
    }
    if (filters.onlyMismatch) {
      var d = Number(rec.diff);
      if (!rec.diff || isNaN(d) || d === 0) continue;
    }
    if (filters.csign) {
      var d2 = Number(rec.diff);
      if (isNaN(d2)) continue;
      if (filters.csign === 'plus' && d2 <= 0) continue;
      if (filters.csign === 'minus' && d2 >= 0) continue;
    }
    out.push(rec);
    if (out.length >= CONFIG.MAX_LIST_ROWS) break;
  }
  return out;
}

// پوششِ انبارگردانی: از کل کالاهای موجود در شیت اصلی، چندتا حداقل یک‌بار شمارش شده‌اند
function getCountCoverage() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var itemsSheet = ss.getSheets()[0];
  var itemValues = itemsSheet.getDataRange().getValues();
  var headers = itemValues[0].map(function (h) { return String(h).trim(); });
  function findCol(keyword) { for (var i = 0; i < headers.length; i++) if (headers[i].indexOf(keyword) !== -1) return i; return -1; }
  var idCol = findCol('کد');
  var nameCol = findCol('نام کالا'); if (nameCol === -1) nameCol = findCol('نام');

  var allItems = [];
  for (var r = 1; r < itemValues.length; r++) {
    var code = idCol !== -1 ? String(itemValues[r][idCol]).trim() : '';
    if (!code) continue;
    allItems.push({ code: code, name: nameCol !== -1 ? itemValues[r][nameCol] : '' });
  }

  var countedCodes = {};
  var countValues = getCountSheet().getDataRange().getValues();
  for (var c = 1; c < countValues.length; c++) {
    if (countValues[c][2]) countedCodes[String(countValues[c][2]).trim()] = true;
  }

  var remaining = allItems.filter(function (it) { return !countedCodes[it.code]; });
  return {
    total: allItems.length,
    countedCount: allItems.length - remaining.length,
    remaining: remaining
  };
}

function deleteCountRecords(session, rowIndexes) {
  if (session.role !== 'مدیر') throw new Error('دسترسی ندارید.');
  var sh = getCountSheet();
  var rows = rowIndexes.map(Number).filter(function (n) { return n > 1; }).sort(function (a, b) { return b - a; });
  rows.forEach(function (r) { sh.deleteRow(r); });
  return rows.length;
}

