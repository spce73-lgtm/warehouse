// جاوااسکریپت ویجت «انبارگردانی» (جست‌وجو + اسکن دوربین + ثبت سریع، حلقه‌ای)
// نکته: چون این صفحه داخل اپس‌اسکریپت و درون یک iframe داخلی گوگل بارگذاری
// می‌شود، ممکن است در بعضی مرورگرها اجازه‌ی دسترسی به دوربین داده نشود (این
// محدودیتِ خودِ گوگل است، نه این کد). به همین دلیل قسمت جست‌وجوی دستی همیشه
// در دسترس است تا کار متوقف نشود؛ نسخه‌ی موبایلِ مستقل (که جدا از اپس‌اسکریپت
// میزبانی می‌شود) تضمینی‌تر است.
function countWorkbenchScript(token) {
  var tok = JSON.stringify(token || '');
  return (
    'var cwHtml5Qrcode=null,cwCameraRunning=false,cwLastCode="",cwLastAt=0,cwRecent=[];' +
    'function cwToggleScan(){' +
      'var wrap=document.getElementById("cwCameraWrap");' +
