          'titleSpan.className="wb-tab-title";titleSpan.textContent=t.title;' +
          'el.appendChild(titleSpan);' +
          'if(t.key!==WB_HOME_KEY){' +
            'var closeSpan=document.createElement("span");' +
            'closeSpan.className="wb-tab-close";closeSpan.textContent="✕";' +
            'closeSpan.onclick=function(ev){wbCloseTab(t.key,ev);};' +
            'el.appendChild(closeSpan);' +
          '}' +
          'el.onclick=function(){wbSwitchTab(t.key);};' +
          'bar.appendChild(el);' +
        '});' +
      '}' +
      'wbRegisterCurrentTab();wbRenderBar();';
    return (
      '<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8">' +
      '<meta name="viewport" content="width=device-width, initial-scale=1">' +
      '<style>' + fontFace + buildCss(fontFamily) + '</style></head><body class="shell-mode" data-view="' + escapeHtml(opts.activeView || '') + '">' +
      appTopbar +
      '<div class="workbench-bar no-print" id="workbenchBar"></div>' +
      sidebar +
      '<div class="app-main">' +
        '<div class="wrap"><div class="card" id="appCard">' + bodyHtml + '</div></div>' +
      '</div>' +
      reminderModal +
      '<script>' + shellScript + '</script>' +
      '</body></html>'
    );
  }

  var searchBar = '';
  if (!opts.hideSearch) {
    searchBar =
      '<form class="searchbar" method="GET" action="' + escapeHtml(scriptUrl) + '" target="_top">' +
        '<button type="submit" class="search-btn" aria-label="جستجو">' + SEARCH_ICON_SVG + '</button>' +
        '<input type="text" name="q" value="' + escapeHtml(currentQ || '') + '" placeholder="جستجوی کد یا نام کالا...">' +
      '</form>';
  }

  // حالت بدون نشست (صفحه ورود / دسترسی بدون ورود به یک کالا)
  var userBar = '';
  if (!opts.hideSearch) {
    userBar =
      '<div class="userbar">' +
        '<a class="userbar-link login-link" target="_top" href="' + escapeHtml(scriptUrl) + '">' + LOGIN_ICON_SVG + ' ورود کارمندان</a>' +
      '</div>';
  }
  var headerHtml =
    '<div class="topbar">' +
      (logo ? '<img class="logo" src="' + escapeHtml(logo) + '">' : '') +
      '<div class="company">' + escapeHtml(CONFIG.COMPANY_NAME) + (CONFIG.COMPANY_NAME_LINE2 ? ' ' + escapeHtml(CONFIG.COMPANY_NAME_LINE2) : '') + '</div>' +
      (CONFIG.WAREHOUSE_NAME ? '<div class="warehouse">' + escapeHtml(CONFIG.WAREHOUSE_NAME) + '</div>' : '') +
      userBar +
    '</div>';

  return (
    '<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8">' +
    '<meta name="viewport" content="width=device-width, initial-scale=1">' +
    '<style>' + fontFace + buildCss(fontFamily) + '</style></head><body>' +
    headerHtml + searchBar +
    '<div class="wrap"><div class="card">' + bodyHtml + '</div></div>' +
    '<script>' + clientScript + '</script>' +
    '</body></html>'
  );
}

