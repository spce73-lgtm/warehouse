    var cls = (view === active) ? 'nav-pill active' : 'nav-pill';
    return '<a class="' + cls + '" target="_top" href="' + escapeHtml(scriptUrl + '?view=' + view + '&token=' + encodeURIComponent(session.__token)) + '">' + label + '</a>';
