                '<span class="pill-sm">' + escapeHtml(m.code) + '</span>' +
                (m.category ? '<span>' + escapeHtml(m.category) + '</span>' : '') +
                (m.qty !== '' && m.qty !== undefined ? '<span class="qty-sm">موجودی: ' + escapeHtml(m.qty) + '</span>' : '') +
              '</div>' +
            '</div>' +
          '</a>';
      });
      bodyHtml += '</div>';
    }
  }
  return HtmlService.createHtmlOutput(wrapPage(bodyHtml, q, session, { activeView: 'search' }))
    .setTitle('جستجوی کالا')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

/**
 * تبدیل ارقام فارسی/عربی به انگلیسی، تا جست‌وجو با هر دو نوع صفحه‌کلید کار کند.
 * مثال: «۱۲۳۴» یا «١٢٣٤» هر دو به «1234» تبدیل می‌شوند.
 */
function normalizePersianDigits_(str) {
  if (str === null || str === undefined) return str;
  var s = String(str);
  var persian = '۰۱۲۳۴۵۶۷۸۹';
  var arabic  = '٠١٢٣٤٥٦٧٨٩';
  s = s.replace(/[۰-۹]/g, function (d) { return String(persian.indexOf(d)); });
  s = s.replace(/[٠-٩]/g, function (d) { return String(arabic.indexOf(d)); });
  return s;
}

function searchItems(q) {
  var values = getSheetValues();
  var headers = values[0].map(function (h) { return String(h).trim(); });
  function findCol(keyword) {
    for (var i = 0; i < headers.length; i++) if (headers[i].indexOf(keyword) !== -1) return i;
    return -1;
  }
  var idCol = findCol('کد');
  var nameCol = findCol('نام کالا'); if (nameCol === -1) nameCol = findCol('نام');
  var qtyCol = findCol('تعداد');
  var catCol = findCol('دسته');
  var imageCols = [];
  headers.forEach(function (h, i) { if (h.indexOf('تصویر') !== -1 || h.indexOf('عکس') !== -1) imageCols.push(i); });

  var needle = normalizePersianDigits_(String(q).trim()).toLowerCase();
  // جست‌وجوی هوشمندتر: عبارت به کلمات جدا می‌شود (فاصله یا ، - : /) و هر ردیفی
  // که همه‌ی کلمات را (نه لزوماً پشت‌سرهم) داشته باشد، نتیجه محسوب می‌شود.
  var words = needle.split(/[\s,،\-:\/]+/).filter(function (w) { return w; });
  if (words.length === 0) return [];

  // چون یک کد کالا ممکن است در چند انبار (چند ردیف) موجود باشد، نتایج بر اساس
  // کد کالا تجمیع می‌شوند و موجودی همه‌ی انبارها با هم جمع می‌شود.
  var codeOrder = [];         // ترتیب اولین‌بار دیده‌شدن هر کد
  var aggByCode = {};         // کد → { code, name, category, qty(مجموع), thumb, isExact }

  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    if (!row[idCol] && !row[nameCol]) continue;
    var haystack = normalizePersianDigits_(row.join(' ')).toLowerCase();
    var isExactCode = idCol !== -1 && normalizePersianDigits_(String(row[idCol]).trim()).toLowerCase() === needle;
    var allWordsMatch = words.every(function (w) { return haystack.indexOf(w) !== -1; });
    if (!isExactCode && !allWordsMatch) continue;

    var code = String(row[idCol]);
    if (!(code in aggByCode)) {
      var thumb = null;
      for (var ic = 0; ic < imageCols.length; ic++) {
        var raw = String(row[imageCols[ic]] || '').split(/[\n,]+/)[0].trim();
        if (raw) { thumb = toDirectImageLink(raw); break; }
      }
      aggByCode[code] = {
        code: code, name: nameCol !== -1 ? row[nameCol] : '', category: catCol !== -1 ? row[catCol] : '',
        qty: 0, hasNumericQty: false, thumb: thumb, isExact: isExactCode
      };
      codeOrder.push(code);
    }
    var agg = aggByCode[code];
    if (isExactCode) agg.isExact = true;
    var qNum = Number(qtyCol !== -1 ? row[qtyCol] : '');
    if (!isNaN(qNum)) { agg.qty += qNum; agg.hasNumericQty = true; }
    if (codeOrder.length >= CONFIG.MAX_SEARCH_RESULTS * 2) break; // سقف امنیتی برای فایل‌های خیلی بزرگ
  }

  var exactMatches = [], partialMatches = [];
  codeOrder.forEach(function (code) {
    var agg = aggByCode[code];
    var resultRow = { code: agg.code, name: agg.name, category: agg.category, qty: agg.hasNumericQty ? agg.qty : '', thumb: agg.thumb };
    if (agg.isExact) exactMatches.push(resultRow); else partialMatches.push(resultRow);
  });

  var combined = exactMatches.concat(partialMatches);
  return combined.slice(0, CONFIG.MAX_SEARCH_RESULTS);
}

// ============ داده و صفحه‌ی کالا ============
function buildItemData(id) {
  var values = getSheetValues();
  var headers = values[0].map(function (h) { return String(h).trim(); });
  function findCol(keyword) {
    for (var i = 0; i < headers.length; i++) if (headers[i].indexOf(keyword) !== -1) return i;
    return -1;
  }
  var idCol = findCol('کد');
  var nameCol = findCol('نام کالا'); if (nameCol === -1) nameCol = findCol('نام');
  var qtyCol = findCol('تعداد');
  var whCol = findCol('نام انبار'); if (whCol === -1) whCol = findCol('کد انبار');
  var imageCols = [];
  headers.forEach(function (h, i) { if (h.indexOf('تصویر') !== -1 || h.indexOf('عکس') !== -1) imageCols.push(i); });
  var qrCol = findCol('QR');
  // >>> افزوده شد: ستون‌های وزن واحد و قفسه (اگر هنوز به شیت اضافه نشده باشند، -1 می‌مانند و مقادیر خالی برمی‌گردند)
  var weightCol = findCol('وزن واحد');
  var shelfColItem = findCol('قفسه');
  // <<< پایان بخش افزوده‌شده

  if (idCol === -1) return { error: 'ستونی با عنوان شامل "کد" پیدا نشد.' };
  var normalizedId = normalizePersianDigits_(String(id).trim());

  // جمع‌آوری همه‌ی ردیف‌های این کد کالا (ممکن است در چند انبار موجود باشد)
  var matchingRows = [];
  for (var r = 1; r < values.length; r++) {
    if (normalizePersianDigits_(String(values[r][idCol]).trim()) === normalizedId) matchingRows.push(values[r]);
  }
  if (matchingRows.length === 0) return { error: 'کالایی با کد <span class="mono">' + escapeHtml(id) + '</span> پیدا نشد.' };

  var row = matchingRows[0]; // سایر ستون‌ها (نام، واحد، دسته، تصویر و...) از اولین ردیف خوانده می‌شود

  var images = [];
  imageCols.forEach(function (ci) {
    var raw = String(row[ci] || '').trim();
    if (!raw) return;
    raw.split(/[\n,]+/).forEach(function (piece) { var l = toDirectImageLink(piece.trim()); if (l) images.push(l); });
  });

  var name = nameCol !== -1 ? row[nameCol] : ('کالا #' + id);

  // موجودی هر انبار به‌صورت جداگانه + جمع کل
  var warehouses = [];
  var totalQty = 0;
  var hasNumericTotal = false;
  matchingRows.forEach(function (mRow) {
    var whName = whCol !== -1 ? String(mRow[whCol] || '').trim() : '';
    var q = qtyCol !== -1 ? mRow[qtyCol] : '';
    warehouses.push({ warehouse: whName || '—', qty: q });
    var qNum = Number(q);
    if (!isNaN(qNum)) { totalQty += qNum; hasNumericTotal = true; }
  });
  var systemQty = hasNumericTotal ? totalQty : (qtyCol !== -1 ? row[qtyCol] : '');

  var fields = [];
  headers.forEach(function (h, i) {
    if (i === idCol || i === nameCol || i === qtyCol || i === whCol || imageCols.indexOf(i) !== -1 || i === qrCol) return;
    if (i === weightCol || i === shelfColItem) return; // >>> افزوده شد: این دو جدا (با محاسبه‌ی وزن کل) نمایش داده می‌شوند
    if (!h) return;
    var val = row[i];
    if (val === '' || val === null || val === undefined) return;
    fields.push([h, val]);
  });

  var lastCount = getLastCountForItem_(normalizedId);

  // >>> افزوده شد: وزن واحد / قفسه / وزن کل — همه‌ی محاسبات سرور-محور (طبق معماری سیستم)
  var unitWeight = '';
  if (weightCol !== -1) {
    var rawWeight = row[weightCol];
    if (rawWeight !== '' && rawWeight !== null && rawWeight !== undefined) {
      var wNum = Number(rawWeight);
      unitWeight = isNaN(wNum) ? '' : wNum;
    }
  }
  var shelfCode = shelfColItem !== -1 ? String(row[shelfColItem] || '').trim() : '';
  var shelfInfo = null;
  if (shelfCode) {
    try { shelfInfo = findShelfByCode_(shelfCode); } catch (e) { shelfInfo = null; }
  }
  var qtyNumericForWeight = hasNumericTotal ? totalQty : Number(systemQty);
  var totalWeight = (unitWeight !== '' && !isNaN(qtyNumericForWeight)) ? Math.round(unitWeight * qtyNumericForWeight * 1000) / 1000 : null;

  var unitWeightDisplay = unitWeight === '' ? 'ثبت‌نشده' : (String(unitWeight) + ' kg');
  var totalWeightDisplay = (totalWeight === null) ? '—' : (String(totalWeight) + ' kg');
  var shelfDisplay = shelfCode ? (shelfCode + (shelfInfo && shelfInfo.location ? ' — ' + shelfInfo.location : '') + (shelfCode && !shelfInfo ? ' (نامعتبر/غیرفعال)' : '')) : 'تعیین‌نشده';

  // >>> افزوده شد: متریک زنده‌ی بار قفسه‌ای که این کالا روی آن است (ظرفیت/بار فعلی/باقیمانده/درصد/وضعیت)
  // از همان توابع محاسبه‌ی ماژول «نظارت خودکار بار قفسه» استفاده می‌شود؛ منطقی تکرار نشده است.
  var shelfLoad = null;
  if (shelfInfo) {
    try {
      var loadMap = computeShelfLoads_();
      shelfLoad = buildShelfLoadMetrics_(shelfInfo, loadMap[shelfInfo.code]);
    } catch (shelfLoadErr) { shelfLoad = null; }
  }
  // <<< پایان بخش افزوده‌شده

  return {
    code: row[idCol], name: name, systemQty: systemQty, fields: fields, images: images,
    warehouses: warehouses,       // [{warehouse, qty}, ...] — موجودی هر انبار به‌تفکیک
    lastCount: lastCount,         // آخرین شمارش ثبت‌شده در یک سال اخیر (یا null)
    // >>> افزوده شد: وزن واحد، قفسه، وزن کل موجودی (برای کاربران دارای دسترسی انبار)
    unitWeight: unitWeight, shelfCode: shelfCode, shelf: shelfInfo, totalWeight: totalWeight,
    unitWeightDisplay: unitWeightDisplay, totalWeightDisplay: totalWeightDisplay, shelfDisplay: shelfDisplay,
    shelfLoad: shelfLoad // متریک زنده‌ی بار قفسه (ظرفیت/بار فعلی/باقیمانده/درصد/وضعیت) — null اگر کالا قفسه نداشته باشد
    // <<< پایان بخش افزوده‌شده
  };
}

/**
 * آخرین شمارش ثبت‌شده برای این کد کالا در یک سال اخیر (شمسی) را برمی‌گرداند.
 * اگر آخرین شمارش قدیمی‌تر از یک سال باشد یا اصلاً شمارشی نباشد، null برمی‌گرداند.
 */
function getLastCountForItem_(code) {
  var sh = getCountSheet();
  var data = sh.getDataRange().getValues();
  if (data.length < 2) return null;

  var normalizedCode = normalizePersianDigits_(String(code).trim());
  var todayJ = toJalali(new Date());
  var todayRough = todayJ[0] * 365 + todayJ[1] * 30 + todayJ[2];

  var best = null, bestRough = -1;
  for (var r = 1; r < data.length; r++) {
    var rowCode = normalizePersianDigits_(String(data[r][2] || '').trim()); // ستون «کد کالا»
    if (rowCode !== normalizedCode) continue;
    var dateStr = normalizePersianDigits_(String(data[r][0] || '').trim());
    var m = dateStr.match(/^(\d+)\/(\d+)\/(\d+)/);
    if (!m) continue;
    var jy = parseInt(m[1], 10), jm = parseInt(m[2], 10), jd = parseInt(m[3], 10);
    var rough = jy * 365 + jm * 30 + jd;
    if (rough > bestRough) {
      bestRough = rough;
      best = { date: String(data[r][0]).trim(), systemQtyAtCount: data[r][4], physicalQty: data[r][5], diff: data[r][6], note: data[r][7] || '' };
    }
  }
  if (!best) return null;
  if (todayRough - bestRough > 365) return null; // قدیمی‌تر از یک سال
  return best;
}

// ============ همگام‌سازی فایل استاتیک items.json با گیت‌هاب ============
// هدف: نمایش مشخصات کالا (بدون موجودی) در اپ گیت‌هاب‌پیجز حتی وقتی
// دسترسی مستقیم گوشی به سرویس‌های گوگل (از جمله googleusercontent.com)
// در شبکه‌ی وای‌فای مسدود است. فایل items.json به‌صورت استاتیک روی
// گیت‌هاب سرو می‌شود و هیچ تماسی با گوگل لازم ندارد.

/**
 * تمام کالاها را (بدون ستون موجودی) برای فایل استاتیک آماده می‌کند.
 * برای هر کد کالا فقط اولین ردیف در نظر گرفته می‌شود (هم‌راستا با buildItemData).
 */
function buildAllItemsPublicData_() {
  var values = getSheetValues();
  var headers = values[0].map(function (h) { return String(h).trim(); });
  function findCol(keyword) {
    for (var i = 0; i < headers.length; i++) if (headers[i].indexOf(keyword) !== -1) return i;
    return -1;
  }
  var idCol = findCol('کد');
  var nameCol = findCol('نام کالا'); if (nameCol === -1) nameCol = findCol('نام');
  var qtyCol = findCol('تعداد');
  var imageCols = [];
  headers.forEach(function (h, i) { if (h.indexOf('تصویر') !== -1 || h.indexOf('عکس') !== -1) imageCols.push(i); });
  var qrCol = findCol('QR');

  if (idCol === -1) return [];

  var seen = {};
  var items = [];
  for (var r = 1; r < values.length; r++) {
    var row = values[r];
    var code = String(row[idCol] || '').trim();
    if (!code || seen[code]) continue;
    seen[code] = true;

    var images = [];
    imageCols.forEach(function (ci) {
      var raw = String(row[ci] || '').trim();
      if (!raw) return;
      raw.split(/[\n,]+/).forEach(function (piece) { var l = toDirectImageLink(piece.trim()); if (l) images.push(l); });
    });

    var name = nameCol !== -1 ? row[nameCol] : ('کالا #' + code);
    var fields = [];
    headers.forEach(function (h, i) {
      if (i === idCol || i === nameCol || i === qtyCol || imageCols.indexOf(i) !== -1 || i === qrCol) return;
      if (!h) return;
      var val = row[i];
      if (val === '' || val === null || val === undefined) return;
      fields.push([h, val]);
    });

    items.push({ code: code, name: name, images: images, fields: fields });
  }
  return items;
}

/**
 * ساخت و ارسال items.json به ریپوی گیت‌هاب (از سمت سرور گوگل، نه گوشی کاربر).
 * نیازمند یک Personal Access Token گیت‌هاب که در Script Properties با کلید
 * CONFIG.GITHUB_TOKEN_PROP_KEY ذخیره شده باشد (دسترسی لازم: Contents: Read & Write).
 */
function pushItemsJsonToGitHub_() {
  var token = PropertiesService.getScriptProperties().getProperty(CONFIG.GITHUB_TOKEN_PROP_KEY);
  if (!token) {
    throw new Error(
      'توکن گیت‌هاب تنظیم نشده.\n' +
      'در ادیتور Apps Script: Project Settings ← Script Properties ← Add script property\n' +
      'با کلید «' + CONFIG.GITHUB_TOKEN_PROP_KEY + '» و مقدار Personal Access Token گیت‌هاب (دسترسی Contents: Read & Write) اضافه کنید.'
    );
  }

  var items = buildAllItemsPublicData_();
  var jsonContent = JSON.stringify(items);
  var contentB64 = Utilities.base64Encode(Utilities.newBlob(jsonContent, 'application/json').getBytes());

  var apiUrl = 'https://api.github.com/repos/' + CONFIG.GITHUB_OWNER + '/' + CONFIG.GITHUB_REPO + '/contents/' + CONFIG.GITHUB_ITEMS_PATH;

  var sha = null;
  try {
    var getResp = UrlFetchApp.fetch(apiUrl + '?ref=' + CONFIG.GITHUB_BRANCH, {
      method: 'get',
      headers: { 'Authorization': 'token ' + token, 'Accept': 'application/vnd.github+json' },
      muteHttpExceptions: true
    });
    if (getResp.getResponseCode() === 200) {
      sha = JSON.parse(getResp.getContentText()).sha;
    }
  } catch (e) { /* فایل شاید هنوز وجود نداشته باشد، مشکلی نیست */ }

  var payload = {
    message: 'به‌روزرسانی خودکار items.json — ' + new Date().toISOString(),
    content: contentB64,
    branch: CONFIG.GITHUB_BRANCH
  };
  if (sha) payload.sha = sha;

  var putResp = UrlFetchApp.fetch(apiUrl, {
    method: 'put',
    contentType: 'application/json',
    headers: { 'Authorization': 'token ' + token, 'Accept': 'application/vnd.github+json' },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });

  var respCode = putResp.getResponseCode();
  if (respCode !== 200 && respCode !== 201) {
    throw new Error('خطا در ارسال به گیت‌هاب (کد ' + respCode + '): ' + putResp.getContentText());
  }
  return items.length;
}

function getSheetValues() {
  var cache = CacheService.getScriptCache();
  if (CONFIG.CACHE_SECONDS > 0) {
    var cached = cache.get('sheet_values');
    if (cached) return JSON.parse(cached);
  }
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
  var raw = sheet.getDataRange().getValues();
  var normalized = raw.map(function (row) {
    return row.map(function (val) {
      if (Object.prototype.toString.call(val) === '[object Date]') {
        return Utilities.formatDate(val, Session.getScriptTimeZone(), 'yyyy/MM/dd');
      }
      return val;
    });
  });
  if (CONFIG.CACHE_SECONDS > 0) {
    try { cache.put('sheet_values', JSON.stringify(normalized), CONFIG.CACHE_SECONDS); } catch (err) {}
  }
  return normalized;
}

// >>> افزوده شد: پاک‌سازیِ یکجای همه‌ی کش‌های مبتنی‌بر شیت کالاها، هر جا شیت اصلی نوشته می‌شود
// (ایمپورت اکسل، ویرایش وزن/قفسه). جایگزینِ تکرارِ «cache.remove('sheet_values')» در چند نقطه؛
// با افزودن کشِ جدیدِ بار قفسه (پایین‌تر)، هر دو کش هم‌زمان و همیشه هم‌گام پاک می‌شوند.
function invalidateSheetCache_() {
  var cache = CacheService.getScriptCache();
  try { cache.remove('sheet_values'); } catch (e) {}
  try { cache.remove('shelf_loads_v1'); } catch (e) {}
}
// <<< پایان بخش افزوده‌شده

function toDirectImageLink(url) {
  if (!url) return null;
  if (url.indexOf('data:') === 0) return url;
  var m = url.match(/\/d\/([a-zA-Z0-9_-]+)/) || url.match(/[?&]id=([a-zA-Z0-9_-]+)/);
  if (m && m[1] && url.indexOf('drive.google.com') !== -1) return 'https://drive.google.com/thumbnail?id=' + m[1] + '&sz=w1400';
  return url;
}

function renderDetailPage(id, q, session) {
  var built = buildItemData(id);
  var scriptUrl = ScriptApp.getService().getUrl();
  var bodyHtml = built.error ? '<div class="empty">' + built.error + '</div>' : renderItem(built, q, scriptUrl, session);
  var title = built.error ? 'کالا یافت نشد' : String(built.name || 'مشخصات کالا');
  return HtmlService.createHtmlOutput(wrapPage(bodyHtml, q, session, { activeView: 'itemdetail', tabItemId: id }))
    .setTitle(title)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function renderItem(d, q, scriptUrl, session) {
  var mainImg = d.images.length ? d.images[0] : '';
  var backLink = '';
  if (session && q && q.trim()) {
    backLink = '<a class="backlink" target="_top" href="' + escapeHtml(scriptUrl + '?q=' + encodeURIComponent(q) + '&token=' + encodeURIComponent(session.__token || '')) + '">‹ بازگشت به نتایج جستجو</a>';
  }

  var heroHtml;
  if (mainImg) {
    heroHtml = '<div class="hero"><img id="mainImg" src="' + escapeHtml(mainImg) + '" fetchpriority="high" onerror="this.parentElement.innerHTML=\'<div class=&quot;imgerr&quot;>تصویر بارگذاری نشد</div>\'"></div>';
    if (d.images.length > 1) {
      heroHtml += '<div class="thumbs">';
      d.images.forEach(function (src, i) { heroHtml += '<img class="thumb' + (i === 0 ? ' active' : '') + '" src="' + escapeHtml(src) + '" loading="lazy" onclick="selectThumb(this)">'; });
      heroHtml += '</div>';
    }
  } else {
    heroHtml = '<div class="hero"><div class="imgerr">تصویری ثبت نشده</div></div>';
  }

  var fieldsHtml = '<div class="grid">';
  d.fields.forEach(function (f) { fieldsHtml += '<div class="field"><div class="k">' + escapeHtml(f[0]) + '</div><div class="v">' + escapeHtml(f[1]) + '</div></div>'; });
  fieldsHtml += '</div>';

  // موجودی به‌تفکیک انبار (فقط اگر بیش از یک انبار وجود داشته باشد)
  var warehousesHtml = '';
  if (d.warehouses && d.warehouses.length > 1) {
    warehousesHtml = '<div class="wh-title">موجودی به تفکیک انبار</div><div class="wh-grid">';
    d.warehouses.forEach(function (w) {
      warehousesHtml += '<div class="wh-item"><div class="k">' + escapeHtml(w.warehouse) + '</div><div class="v">' + escapeHtml(String(w.qty)) + '</div></div>';
    });
    warehousesHtml += '</div>';
  }

  // آخرین شمارش ثبت‌شده (در یک سال اخیر)
  var lastCountHtml = '';
