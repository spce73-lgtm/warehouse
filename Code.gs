// ======================================================================
// SECTION 10: راهنمای فعال‌سازی (به‌صورت کامنت — اجرایی نیست)
// ======================================================================
//
// گام ۱ — این فایل را به پروژه اضافه کنید:
//   در Apps Script Editor → + فایل جدید → «meetings_v2» → محتوا را paste کنید.
//
// گام ۲ — در Code.gs (فایل اصلی) پیدا کنید و جایگزین کنید:
//
//   [در doGetInner]
//   قدیم:  if (view === 'meetings') return renderMeetingsListPage(...)
//   جدید:  if (view === 'meetings') return renderMeetingsListPageV2(...)
//
//   قدیم:  if (view === 'meetingDetail' && e.parameter.number) return renderMeetingDetailPage(...)
//   جدید:  if (view === 'meetingDetail' && e.parameter.number) return renderMeetingDetailPageV2(...)
//
//   قدیم:  if (view === 'resolutionDetail' && e.parameter.id) return renderResolutionDetailPage(...)
//   جدید:  if (view === 'resolutionDetail' && e.parameter.id) return renderResolutionDetailPageV2(...)
//
//   قدیم:  if (view === 'resolutions') return renderResolutionsListPage(...)
//   جدید:  if (view === 'resolutions') return renderResolutionsListPageV2(...)
//
//   [در doPostInner، داخل بلوک اقدامات مشترک (قبل از «اکشن‌های مخصوص مدیر»)]
//   اضافه کنید بلوک updateMeetingInfo از Section 9 بالا.
//
//   [در doPostInner، بلوک createMeeting موجود را جایگزین کنید:]
//   قدیم:
//     return renderMeetingDetailPage(session, newMeetingNo, 'صورتجلسه ثبت شد.');
//   جدید:
//     return renderMeetingDetailPageV2(session, newMeetingNo, 'صورتجلسه ثبت شد.');
//
//   [و برای createResolution موجود:]
//   قدیم:
//     return renderMeetingDetailPage(session, e.parameter.meetingNumber, 'مصوبه ثبت شد.');
//   جدید:
//     return renderMeetingDetailPageV2(session, e.parameter.meetingNumber, 'مصوبه ثبت شد.');
//
// گام ۳ — Deploy → Manage Deployments → ویرایش → New Version → Deploy
//
// ======================================================================
// نکات معماری:
// - هیچ شیت، تابع یا API موجودی تغییر نکرده (backward compatible).
// - jalaliDateInputHtml از همان getJalaliMonthGrid و PERSIAN_MONTHS موجود استفاده می‌کند.
// - CSS جدید ندارد؛ از کلاس‌های .modal-overlay، .modal-box، .cal-* و .mini-btn استفاده می‌شود.
// - ماژول انبار و اسکنر GitHub دست‌نخورده‌اند.
// ======================================================================
// ======================================================================
// نسخه ۳ ماژول‌های «صورتجلسات» و «اقدامات» — جدول حرفه‌ای، تقویم شمسی کامل،
// مدیریت مصوبات به‌صورت درون‌خطی (بدون صفحه‌ی جداگانه)، اسلایدر پیشرفت،
// انتخاب چندگانه‌ی حاضرین، جدول زمانی فعالیت.
// این فایل را به انتهای پروژه اضافه کنید. هیچ تابع/شیت/API قبلی تغییر نمی‌کند.
// ======================================================================

// ----------------------------------------------------------------------
// SECTION 0: کمکی‌های عمومی
// ----------------------------------------------------------------------
function safeId_(str) {
  return String(str == null ? '' : str).replace(/[^a-zA-Z0-9_]/g, '_');
}

// دکمه‌ی بازگشت مشترک برای صفحات جزئیات: به آدرس مشخص‌شده (معمولاً فهرست) برمی‌گردد.
// از history.back() استفاده نمی‌شود چون در این اپ ناوبری بین تب‌های «میز کار» گاهی بدون
// ثبت ورودی جدید در تاریخچه‌ی مرورگر انجام می‌شود (سوییچ تب از کش محلی)، بنابراین
// دکمه‌ی بازگشت مرورگر ممکن است کاربر را به صفحه‌ای غیرمنتظره ببرد، نه فهرست موردنظر.
// فیلترها/مرتب‌سازی/موقعیت اسکرول جدول فهرست به‌صورت جداگانه در sessionStorage
// (توسط dtInit) ذخیره و در بارگذاری بعدی فهرست بازیابی می‌شوند؛ نیازی به history نیست.
function backButtonHtml_(href, label) {
  return '<a href="' + escapeHtml(href) + '" target="_top" class="backlink">→ ' + escapeHtml(label || 'بازگشت به فهرست') + '</a>';
}

// ----------------------------------------------------------------------
// SECTION 1: محاسبه‌ی تأخیر بر پایه‌ی تاریخ شمسی
// ----------------------------------------------------------------------
// تبدیل رشته‌ی تاریخ شمسی «1405/06/01» به عدد قابل‌مقایسه 14050601
function jalaliDateToComparable_(dateStr) {
  var m = String(dateStr || '').trim().match(/(\d{4})\/(\d{1,2})\/(\d{1,2})/);
  if (!m) return null;
  return parseInt(m[1], 10) * 10000 + parseInt(m[2], 10) * 100 + parseInt(m[3], 10);
}
function todayJalaliComparable_() {
  return jalaliDateToComparable_(nowJalaliString());
}
// آیا این مورد از مهلت گذشته و هنوز بسته نشده است؟
function isOverdue_(dueDateStr, status) {
  if (!dueDateStr) return false;
  if (status === CONFIG_EXT.ACTION_STATUS_CLOSED) return false;
  var due = jalaliDateToComparable_(dueDateStr);
  var today = todayJalaliComparable_();
  if (due === null || today === null) return false;
  return due < today;
}
// شمارش تقریبی روزهای تأخیر (بر پایه‌ی تقویم شمسی — ماه‌ها ۳۰ روزه فرض می‌شوند، کافی برای نمایش)
function overdueDaysCount_(dueDateStr) {
  var due = jalaliDateToComparable_(dueDateStr);
  var today = todayJalaliComparable_();
  if (due === null || today === null) return 0;
  var dy = Math.floor(due / 10000), dm = Math.floor((due % 10000) / 100), dd = due % 100;
  var ty = Math.floor(today / 10000), tm = Math.floor((today % 10000) / 100), td = today % 100;
  var dueDays = dy * 360 + dm * 30 + dd;
  var todayDays = ty * 360 + tm * 30 + td;
  return Math.max(0, todayDays - dueDays);
}
function dueDateCellHtml_(dueDate, status) {
  if (!dueDate) return '<span style="color:#8b94a0;">—</span>';
  if (isOverdue_(dueDate, status)) {
    var days = overdueDaysCount_(dueDate);
    return '<span class="overdue-tag">⚠ تأخیر</span>' + escapeHtml(dueDate) +
      (days > 0 ? ' <span style="color:#c53030;font-size:10.5px;">(' + days + ' روز)</span>' : '');
  }
  return escapeHtml(dueDate);
}

// ----------------------------------------------------------------------
// SECTION 2: کامپوننت مشترک — جدول داده‌ی حرفه‌ای (قابل‌فیلتر/مرتب‌سازی)
// در همه‌ی ماژول‌ها (اقدامات، صورتجلسات، مصوباتِ درون هر جلسه) استفاده می‌شود.
// ----------------------------------------------------------------------
function dataTableBootstrapScript_() {
  return '<script>' +
    // انتخاب ردیف‌ها برای عملیات گروهی (حذف / ارسال و ارجاع) — نیازمندی ۱
    'function dtUpdateSelection(tableId){' +
      'var table=document.getElementById(tableId); if(!table)return;' +
      'var boxes=table.querySelectorAll(".dt-row-check:checked");' +
      'var ids=Array.prototype.map.call(boxes,function(b){return b.value;});' +
      'var bar=document.getElementById(tableId+"_bulkBar");' +
      'if(bar){bar.style.display=ids.length?"flex":"none";' +
        'var countEl=document.getElementById(tableId+"_selCount"); if(countEl)countEl.textContent=ids.length;' +
      '}' +
    '}' +
    'function dtToggleAll(cb){' +
      'var table=cb.closest("table"); if(!table)return;' +
      'Array.prototype.forEach.call(table.querySelectorAll(".dt-row-check"),function(b){' +
        'if(b.closest("tr").style.display!=="none")b.checked=cb.checked;' +
      '});' +
      'dtUpdateSelection(table.id);' +
    '}' +
    'function dtConfirmBulk_(form,tableId,confirmMsg){' +
      'var table=document.getElementById(tableId);' +
      'var boxes=table?table.querySelectorAll(".dt-row-check:checked"):[];' +
      'if(!boxes.length){alert("ابتدا حداقل یک مورد را انتخاب کنید.");return false;}' +
      'var ids=Array.prototype.map.call(boxes,function(b){return b.value;}).join(",");' +
      'var inp=form.querySelector("[data-dt-ids-target]"); if(inp)inp.value=ids;' +
      'if(confirmMsg&&!confirm(confirmMsg))return false;' +
      'return true;' +
    '}' +
    // ذخیره/بازیابی وضعیت فیلتر+مرتب‌سازی+موقعیت اسکرول هر جدول در sessionStorage
    // (کلید بر اساس شناسه‌ی جدول)؛ این باعث می‌شود با بازگشت به فهرست (چه با دکمه‌ی
    // بازگشت و چه با دکمه‌ی بازگشت مرورگر) همان فیلترها/مرتب‌سازی/اسکرول قبلی بازسازی شود.
    'function dtStateKey_(tableId){return "dtState_"+tableId;}' +
    'function dtSaveState_(tableId,filterRow,sortState){' +
      'try{' +
        'var f={};' +
        'if(filterRow){Array.prototype.forEach.call(filterRow.querySelectorAll("[data-dt-filter]"),function(inp){f[inp.getAttribute("data-dt-filter")]=inp.value||"";});}' +
        'var st={filters:f,sortCol:sortState?sortState.col:null,sortDir:sortState?sortState.dir:1,scroll:(window.scrollY||0)};' +
        'sessionStorage.setItem(dtStateKey_(tableId),JSON.stringify(st));' +
      '}catch(e){}' +
    '}' +
    'function dtLoadState_(tableId){' +
      'try{var raw=sessionStorage.getItem(dtStateKey_(tableId));return raw?JSON.parse(raw):null;}catch(e){return null;}' +
    '}' +
    'function dtInit(tableId){' +
      'var table=document.getElementById(tableId); if(!table||table.getAttribute("data-dt-ready"))return; table.setAttribute("data-dt-ready","1");' +
      'var filterRow=table.querySelector(".dt-filter-row");' +
      'function applyFilters(){' +
        'var filters={};' +
        'if(filterRow){Array.prototype.forEach.call(filterRow.querySelectorAll("[data-dt-filter]"),function(inp){' +
          'var col=inp.getAttribute("data-dt-filter");var v=(inp.value||"").trim().toLowerCase();if(v)filters[col]=v;});}' +
        'var visible=0;' +
        'Array.prototype.forEach.call(table.querySelectorAll("tbody > tr[data-dt-row]"),function(row){' +
          'var ok=true;' +
          'for(var col in filters){var cv=(row.getAttribute("data-f_"+col)||"").toLowerCase();if(cv.indexOf(filters[col])===-1){ok=false;break;}}' +
          'row.style.display=ok?"":"none";' +
          'var panel=row.nextElementSibling;' +
          'if(panel&&panel.classList&&panel.classList.contains("dt-panel-row")){if(!ok)panel.style.display="none";}' +
          'if(ok)visible++;' +
        '});' +
        'var er=table.querySelector(".dt-empty-row");if(er)er.style.display=visible===0?"":"none";' +
      '}' +
      'if(filterRow){Array.prototype.forEach.call(filterRow.querySelectorAll("[data-dt-filter]"),function(inp){' +
        'inp.addEventListener("input",function(){applyFilters();dtSaveState_(tableId,filterRow,sortState);});' +
        'inp.addEventListener("change",function(){applyFilters();dtSaveState_(tableId,filterRow,sortState);});' +
      '});}' +
      'var sortState={col:null,dir:1};' +
      'function applySort(col,dir){' +
          'sortState.col=col;sortState.dir=dir;' +
          'Array.prototype.forEach.call(table.querySelectorAll("th[data-dt-sort]"),function(h){h.classList.remove("dt-sort-asc","dt-sort-desc");if(h.getAttribute("data-dt-sort")===col)h.classList.add(dir===1?"dt-sort-asc":"dt-sort-desc");});' +
          'var tbody=table.querySelector("tbody");' +
          'var groups=[];' +
          'var rows=Array.prototype.slice.call(tbody.querySelectorAll("tr[data-dt-row]"));' +
          'rows.forEach(function(r){var panel=r.nextElementSibling;var p=(panel&&panel.classList&&panel.classList.contains("dt-panel-row"))?panel:null;groups.push({row:r,panel:p});});' +
          'groups.sort(function(a,b){' +
            'var av=a.row.getAttribute("data-s_"+col)||"";var bv=b.row.getAttribute("data-s_"+col)||"";' +
            'var an=parseFloat(av),bn=parseFloat(bv);var cmp;' +
            'if(!isNaN(an)&&!isNaN(bn)&&av!==""&&bv!=="")cmp=an-bn;else cmp=av.localeCompare(bv,"fa");' +
            'return cmp*dir;' +
          '});' +
          'groups.forEach(function(g){tbody.appendChild(g.row);if(g.panel)tbody.appendChild(g.panel);});' +
      '}' +
      'Array.prototype.forEach.call(table.querySelectorAll("th[data-dt-sort]"),function(th){' +
        'th.addEventListener("click",function(){' +
          'var col=th.getAttribute("data-dt-sort");' +
          'var dir=(sortState.col===col)?(sortState.dir*-1):1;' +
          'applySort(col,dir);' +
          'dtSaveState_(tableId,filterRow,sortState);' +
        '});' +
      '});' +
      // بازیابی وضعیت ذخیره‌شده‌ی این جدول (در صورت وجود) پیش از اعمال فیلتر پیش‌فرض
      'var saved=dtLoadState_(tableId);' +
      'if(saved&&filterRow&&saved.filters){' +
        'Array.prototype.forEach.call(filterRow.querySelectorAll("[data-dt-filter]"),function(inp){' +
          'var col=inp.getAttribute("data-dt-filter");if(saved.filters[col]!==undefined)inp.value=saved.filters[col];' +
        '});' +
      '}' +
      'applyFilters();' +
      'if(saved&&saved.sortCol){applySort(saved.sortCol,saved.sortDir||1);}' +
      'if(saved&&typeof saved.scroll==="number"){setTimeout(function(){window.scrollTo(0,saved.scroll);},30);}' +
      // موقعیت اسکرول را هنگام ترک صفحه (کلیک روی لینک ردیف، ناوبری و...) هم ذخیره می‌کنیم
      'window.addEventListener("beforeunload",function(){dtSaveState_(tableId,filterRow,sortState);});' +
    '}' +
    'function toggleDtPanel(rowId){' +
      'var panel=document.getElementById(rowId+"_panelRow");if(!panel)return;' +
      'var isOpen=panel.style.display!=="none"&&panel.style.display!=="";' +
      'panel.style.display=isOpen?"none":"table-row";' +
      'var btn=document.getElementById(rowId+"_btn");' +
      'if(btn){btn.classList.toggle("open",!isOpen);btn.textContent=!isOpen?"−":"+";}' +
    '}' +
  '<\/script>';
}

// نوار عملیات گروهی مشترک: «حذف» (فقط مدیر سیستم) و «ارسال و ارجاع» (مدیر سیستم/مدیر بخش)
// opts: {tableId, deleteAction, assignAction, extraHiddenHtml, showAssignFields (پیش‌فرض true), assignLabel, session}
function bulkToolbarHtml_(scriptUrl, session, opts) {
  var canDelete = isSystemAdmin(session) && opts.deleteAction;
  var canAssign = (isSystemAdmin(session) || isDeptManager(session)) && opts.assignAction;
  if (!canDelete && !canAssign) return '';
  var showAssignFields = opts.showAssignFields !== false;
  var allDepts = opts.allDepts || listDepartments();
  var allUsers = opts.allUsers || listUsersExtended();
  var depts = isDeptManager(session) ? allDepts.filter(function (d) { return d.name === getSessionDepartment(session); }) : allDepts;
  var users = isDeptManager(session) ? allUsers.filter(function (u) { return u.department === getSessionDepartment(session); }) : allUsers;
  var html = '<div class="dt-bulk-bar" id="' + escapeHtml(opts.tableId) + '_bulkBar" style="display:none;">' +
    '<span class="dt-bulk-count"><b id="' + escapeHtml(opts.tableId) + '_selCount">0</b> مورد انتخاب شد</span>';
  if (canDelete) {
    html += '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="dt-bulk-form" onsubmit=\'return dtConfirmBulk_(this,' + JSON.stringify(opts.tableId) + ',"آیا از حذف موارد انتخاب‌شده مطمئن هستید؟ این عملیات قابل بازگشت نیست.");\'>' +
      '<input type="hidden" name="action" value="' + escapeHtml(opts.deleteAction) + '">' +
      '<input type="hidden" name="token" value="' + escapeHtml(session.__token || '') + '">' +
      (opts.extraHiddenHtml || '') +
      '<input type="hidden" name="ids" data-dt-ids-target value="">' +
      '<button type="submit" class="mini-btn danger">حذف موارد انتخاب‌شده</button>' +
    '</form>';
  }
  if (canAssign) {
    html += '<form method="POST" action="' + escapeHtml(scriptUrl) + '" target="_top" class="dt-bulk-form" onsubmit=\'return dtConfirmBulk_(this,' + JSON.stringify(opts.tableId) + ',null);\'>' +
      '<input type="hidden" name="action" value="' + escapeHtml(opts.assignAction) + '">' +
      '<input type="hidden" name="token" value="' + escapeHtml(session.__token || '') + '">' +
      (opts.extraHiddenHtml || '') +
      '<input type="hidden" name="ids" data-dt-ids-target value="">' +
      (showAssignFields ?
        ('<select name="department" style="max-width:140px;"><option value="">— بدون تغییر بخش —</option>' + depts.map(function (d) { return '<option value="' + escapeHtml(d.name) + '">' + escapeHtml(d.name) + '</option>'; }).join('') + '</select>' +
         '<select name="assignedUser" style="max-width:160px;"><option value="">— بدون تغییر مسئول —</option>' + users.map(function (u) { return '<option value="' + escapeHtml(u.username) + '">' + escapeHtml(u.fullName || u.username) + '</option>'; }).join('') + '</select>') : '') +
      '<button type="submit" class="mini-btn" style="background:' + CONFIG.ACCENT_COLOR + ';color:#fff;">' + escapeHtml(opts.assignLabel || 'ارسال و ارجاع') + '</button>' +
    '</form>';
  }
  html += '</div>';
  return html;
}

// config: {id, columns:[{key,label,sortable,filter:{type:'text'|'select',options:[{value,label}]}}], rows:[{id,attrs:{f_x,s_x},cells:[html...],rowClass,panelHtml,expanded,selectValue}], emptyMessage, selectable}
function dataTableHtml(opts) {
  var id = opts.id;
  var cols = opts.columns;
  var rows = opts.rows || [];
  var selectable = !!opts.selectable;
  var colspan = cols.length + (selectable ? 1 : 0);

  var theadCols = (selectable ? '<th class="dt-select-col"><input type="checkbox" class="dt-select-all" onchange="dtToggleAll(this)"></th>' : '') +
    cols.map(function (c) {
    var sortAttr = c.sortable ? ' data-dt-sort="' + escapeHtml(c.key) + '"' : '';
    var sortIcon = c.sortable ? ' <span class="dt-sort-icon">⇅</span>' : '';
    return '<th' + sortAttr + '>' + escapeHtml(c.label) + sortIcon + '</th>';
  }).join('');

  var hasFilters = cols.some(function (c) { return c.filter; });
  var filterRowHtml = '';
  if (hasFilters) {
    filterRowHtml = '<tr class="dt-filter-row">' + (selectable ? '<th></th>' : '') + cols.map(function (c) {
      if (!c.filter) return '<th></th>';
      if (c.filter.type === 'select') {
        var options = '<option value="">همه</option>' + (c.filter.options || []).map(function (o) {
          return '<option value="' + escapeHtml(o.value) + '">' + escapeHtml(o.label) + '</option>';
        }).join('');
        return '<th><select data-dt-filter="' + escapeHtml(c.key) + '">' + options + '</select></th>';
      }
      return '<th><input type="text" data-dt-filter="' + escapeHtml(c.key) + '" placeholder="فیلتر..."></th>';
    }).join('') + '</tr>';
  }

  var bodyHtml = '';
  rows.forEach(function (r) {
    var attrStr = Object.keys(r.attrs || {}).map(function (k) {
      return ' data-' + k + '="' + escapeHtml(String(r.attrs[k])) + '"';
    }).join('');
    var checkboxCell = selectable ? '<td class="dt-select-col"><input type="checkbox" class="dt-row-check" value="' + escapeHtml(String(r.selectValue != null ? r.selectValue : '')) + '" onchange=\'dtUpdateSelection(' + JSON.stringify(id) + ')\'></td>' : '';
    bodyHtml += '<tr data-dt-row="1" class="dt-row' + (r.rowClass ? (' ' + r.rowClass) : '') + '" id="' + escapeHtml(r.id) + '_row"' + attrStr + '>' +
      checkboxCell + r.cells.map(function (html) { return '<td>' + html + '</td>'; }).join('') +
    '</tr>';
    if (r.panelHtml !== undefined && r.panelHtml !== null) {
      bodyHtml += '<tr class="dt-panel-row" id="' + escapeHtml(r.id) + '_panelRow" style="display:' + (r.expanded ? 'table-row' : 'none') + ';">' +
        '<td colspan="' + colspan + '"><div class="dt-panel">' + r.panelHtml + '</div></td>' +
      '</tr>';
    }
  });

  var emptyRow = '<tr class="dt-empty-row" style="display:' + (rows.length ? 'none' : 'table-row') + ';">' +
    '<td colspan="' + colspan + '"><div class="dash-empty">' + escapeHtml(opts.emptyMessage || 'موردی یافت نشد.') + '</div></td></tr>';

  return (
    (selectable ? (opts.bulkToolbarHtml || '') : '') +
    '<div class="dt-wrap"><table class="dt-table" id="' + escapeHtml(id) + '">' +
      '<thead><tr>' + theadCols + '</tr>' + filterRowHtml + '</thead>' +
      '<tbody>' + bodyHtml + emptyRow + '</tbody>' +
    '</table></div>' +
    '<script>dtInit(' + JSON.stringify(id) + ');<\/script>'
  );
}

// ----------------------------------------------------------------------
// SECTION 3: نوار/برچسب پیشرفت — سلول جدول (فقط نمایش) و اسلایدر (فرم ویرایش)
// ----------------------------------------------------------------------
function progressCellHtml_(pct) {
  pct = Math.max(0, Math.min(100, parseInt(pct || 0, 10) || 0));
  return '<div style="display:flex;align-items:center;gap:7px;white-space:nowrap;">' +
    '<div class="dt-progress"><div class="dt-progress-bar" style="width:' + pct + '%;"></div></div>' +
    '<span class="dt-progress-label">' + pct + '%</span>' +
  '</div>';
}
// اسلایدر قابل‌کشیدن برای فرم‌های به‌روزرسانی پیشرفت (همان name فیلد قبلی حفظ می‌شود)
function progressSliderHtml(name, value, idSuffix) {
  var id = 'pgslider_' + safeId_(idSuffix);
  var v = Math.max(0, Math.min(100, parseInt(value || 0, 10) || 0));
  return '<div class="pg-slider-wrap">' +
    '<input type="range" min="0" max="100" step="5" name="' + escapeHtml(name) + '" id="' + id + '" value="' + v + '" ' +
      'oninput="document.getElementById(\'' + id + '_lbl\').textContent=this.value+\'%\';" class="pg-slider">' +
    '<span class="pg-slider-label" id="' + id + '_lbl">' + v + '%</span>' +
  '</div>';
}

// ----------------------------------------------------------------------
// SECTION 4: انتخاب چندگانه‌ی حاضرین (کشویی با چک‌باکس) از کاربران سیستم
// ----------------------------------------------------------------------
function multiSelectHtml(name, id, options, selectedValues) {
  id = safeId_(id);
  selectedValues = selectedValues || [];
  var selSet = {};
  selectedValues.forEach(function (v) { selSet[v] = true; });
  var checkboxes = options.map(function (o) {
    var checked = selSet[o.value] ? ' checked' : '';
    return '<label class="ms-option"><input type="checkbox" value="' + escapeHtml(o.value) + '" onchange="msSync_' + id + '()"' + checked + '> ' + escapeHtml(o.label) + '</label>';
  }).join('');
  var initialLabel = selectedValues.length ? (selectedValues.length + ' نفر انتخاب شد') : 'انتخاب حاضرین...';
  return (
    '<div class="ms-wrap" id="' + id + '_wrap">' +
      '<button type="button" class="ms-trigger" onclick="msToggle_' + id + '()" id="' + id + '_trigger">' + escapeHtml(initialLabel) + '</button>' +
      '<input type="hidden" name="' + escapeHtml(name) + '" id="' + id + '_hidden" value="' + escapeHtml(selectedValues.join(',')) + '">' +
      '<div class="ms-panel" id="' + id + '_panel">' + checkboxes + '</div>' +
    '</div>' +
    '<script>' +
      'function msToggle_' + id + '(){var p=document.getElementById(' + JSON.stringify(id + '_panel') + ');p.classList.toggle("open");}' +
      'function msSync_' + id + '(){' +
        'var panel=document.getElementById(' + JSON.stringify(id + '_panel') + ');' +
        'var checked=Array.prototype.slice.call(panel.querySelectorAll("input[type=checkbox]:checked")).map(function(c){return c.value;});' +
        'document.getElementById(' + JSON.stringify(id + '_hidden') + ').value=checked.join(",");' +
        'document.getElementById(' + JSON.stringify(id + '_trigger') + ').textContent=checked.length?(checked.length+" نفر انتخاب شد"):"انتخاب حاضرین...";' +
      '}' +
      'document.addEventListener("click",function(e){' +
        'var wrap=document.getElementById(' + JSON.stringify(id + '_wrap') + ');' +
        'if(wrap&&!wrap.contains(e.target)){var p=document.getElementById(' + JSON.stringify(id + '_panel') + ');if(p)p.classList.remove("open");}' +
      '});' +
    '<\/script>'
  );
}
// تبدیل رشته‌ی ذخیره‌شده‌ی حاضرین (نام‌کاربری‌های جداشده با ویرگول) به نام نمایشی
// سازگار با داده‌های قدیمی: اگر مقدار قدیمی متن آزاد بود (نه نام‌کاربری)، همان‌طور نمایش داده می‌شود.
function resolveAttendeesDisplay_(attendeesRaw) {
  var raw = String(attendeesRaw || '').trim();
  if (!raw) return '—';
  var parts = raw.split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s; });
  var byUsername = {};
  listUsersExtended().forEach(function (u) { byUsername[u.username] = u.fullName || u.username; });
  return parts.map(function (p) { return byUsername[p] || p; }).join('، ');
}
function attendeesToUsernameArray_(attendeesRaw) {
  var raw = String(attendeesRaw || '').trim();
  if (!raw) return [];
  return raw.split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s; });
}

